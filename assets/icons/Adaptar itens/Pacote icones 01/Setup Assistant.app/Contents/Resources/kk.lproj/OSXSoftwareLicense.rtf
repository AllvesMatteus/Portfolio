\kerning1\expnd0\expndtw0 F. \ul \uc0\u1044 \u1072 \u1091 \u1099 \u1089 \u1090 \u1072 \u1088 ; \u1053 \u1072 \u1179 \u1090 \u1099  \u1091 \u1072 \u1179 \u1099 \u1090 \u1090 \u1072 \u1171 \u1099  \u1089 \u1091 \u1073 \u1090 \u1080 \u1090 \u1088 \u1083 \u1077 \u1088 \ulnone . \uc0\u1086 \u1089 \u1099  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103 \u1085 \u1099 \u1187  \u1096 \u1072 \u1088 \u1090 \u1090 \u1072 \u1088 \u1099  \u1084 \u1077 \u1085  \u1077 \u1088 \u1077 \u1078 \u1077 \u1083 \u1077 \u1088 \u1110 \u1085 \u1077  \u1089 \u1241 \u1081 \u1082 \u1077 \u1089  \u1057 \u1110 \u1079 : (i) Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1179 \u1201 \u1088 \u1072 \u1083 \u1099 \u1085 \u1076 \u1072 \u1171 \u1099  \u1078 \u1199 \u1081 \u1077 \u1083 \u1110 \u1082  \u1076 \u1072 \u1091 \u1099 \u1089 \u1090 \u1072 \u1088 \u1076 \u1099  (\'ab\u1046 \u1199 \u1081 \u1077 \u1083 \u1110 \u1082  \u1076 \u1072 \u1091 \u1099 \u1089 \u1090 \u1072 \u1088 \'bb) \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1072  \u1072 \u1083 \u1072 \u1089 \u1099 \u1079 ; (1) Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1179 \u1201 \u1088 \u1072 \u1083 \u1099 \u1085  \u1110 \u1089 \u1082 \u1077  \u1179 \u1086 \u1089 \u1179 \u1072 \u1085  \u1082 \u1077 \u1079 \u1076 \u1077  \u1078 \u1241 \u1085 \u1077  (2) \u1078 \u1077 \u1082 \u1077 , \u1082 \u1086 \u1084 \u1084 \u1077 \u1088 \u1094 \u1080 \u1103 \u1083 \u1099 \u1179  \u1077 \u1084 \u1077 \u1089  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1091  \u1199 \u1096 \u1110 \u1085  \u1257 \u1079 \u1110 \u1187 \u1110 \u1079 \u1076 \u1110 \u1187  \u1090 \u1199 \u1087 \u1085 \u1201 \u1089 \u1179 \u1072  \u1084 \u1072 \u1079 \u1084 \u1201 \u1085 \u1099 \u1187 \u1099 \u1079 \u1076 \u1099  \u1078 \u1241 \u1085 \u1077  \u1078 \u1086 \u1073 \u1072 \u1083 \u1072 \u1088 \u1099 \u1187 \u1099 \u1079 \u1076 \u1099  \u1078 \u1072 \