\kerning1\expnd0\expndtw0 B. \ul Cho Thu\'ea L\uc0\u7841 i\ulnone . B\'ean Thu\'ea c\'f3 th\uc0\u7875  ti\u7871 p t\u7909 c cho thu\'ea l\u7841 i Ph\u7847 n M\u7873 m Apple theo Ph\u7847 n 3 n\'e0y v\u7899 i \u273 i\u7873 u ki\u7879 n l\'e0 B\'ean Thu\'ea \u273 \'f3 tu\'e2n th\u7911  t\u7845 t c\u7843  c\'e1c \u273 i\u7873 u kho\u7843 n c\u7911 a Ph\u7847 n 3 n\'e0y. B\'ean Thu\'ea cho thu\'ea l\u7841 i Ph\u7847 n M\u7873 m Apple (B\'ean Thu\'ea \u273 \'f3 c\u361 ng s\u7869  \u273 \u432 \u7907 c coi l\'e0 B\'ean Cho Thu\'ea theo Ph\u7847 n 3 n\'e0y) ph\u7843 i ho\'e0n to\'e0n chuy\u7875 n giao quy\u7873 n s\u7917  d\u7909 ng v\'e0 qu\u7843 n l\'fd \u273 \u7897 c quy\u7873 n \u273 \u7889 i v\u7899 i Ph\u7847 n M\u7873 m Apple v\'e0 ph\u7847 n c\u7913 ng hi\u7879 u Apple m\'e0 Ph\u7847 n M\u7873 m Apple \u273 \u432 \u7907 c c\'e0i \u273 \u7863 t cho B\'ean Thu\'ea l\u7841 i trong th\u7901 i gian thu\'ea.\expnd0\expndtw0\kerning0
\
\
\kerning1\expnd0\expndtw0 C. \ul Th\uc0\u7921 c Thi\ulnone . L\'e0 B\'ean Cho Thu\'ea, b\uc0\u7841 n s\u7869  ph\u7843 i ch\u7883 u tr\'e1ch nhi\u7879 m: (i) \u273 \u7843 m b\u7843 o r\u7857 ng m\u7895 i B\'ean Thu\'ea tu\'e2n th\u7911  c\'e1c y\'eau c\u7847 u c\u7911 a Ph\u7847 n 3 n\'e0y; (ii) \u273 \u7843 m b\u7843 o r\u7857 ng m\u7895 i B\'ean Thu\'ea \u273 \u7891 ng \'fd v\u7899 i t\u7845 t c\u7843  c\'e1c \u273 i\u7873 u kho\u7843 n c\u7845 p quy\u7873 n s\u7917  d\u7909 ng hi\u7879 n h\'e0nh; v\'e0 (iii) h\u7895  tr\u7907  Apple th\u7921 c thi vi\u7879 c tu\'e2n th\u7911  c\'e1c y\'eau c\u7847 u \u273 \'f3. N\u7871 u B\'ean Thu\'ea vi ph\u7841 m H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y ho\u7863 c c\'e1c \u273 i\u7873 u kho\u7843 n c\u7845 p quy\u7873 n s\u7917  d\u7909 ng hi\u7879 n h\'e0nh kh\'e1c c\u7911 a Apple th\'ec c\'e1c quy\u7873 n c\u7911 a B\'ean Thu\'ea khi s\u7917  d\u7909 ng Ph\u7847 n M\u7873 m Apple s\u7869  t\u7921  \u273 \u7897 ng ch\u7845 m d\u7913 t v\'e0 b\u7841 n \u273 \u7891 ng \'fd ch\u7845 m d\u7913 t ngay l\u7853 p t\u7913 c vi\u7879 c B\'ean Thu\'ea s\u7917  d\u7909 ng Ph\u7847 n M\u7873 m Apple ngay khi b\u7841 n ph\'e1t hi\u7879 n vi ph\u7841 m \u273 \'f3 ho\u7863 c khi c\'f3 v\u259 n b\u7843 n th\'f4ng b\'e1o t\u7915  Apple v\u7873  vi ph\u7841 m \u273 \'f3. \expnd0\expndtw0\kerning0
\
\
\kerning1\expnd0\expndtw0 D. \ul \uc0\u7842 o H\'f3a\ulnone . V\uc0\u7899 i m\u7895 i b\u7843 n sao c\u7911 a Ph\u7847 n M\u7873 m Apple \u273 \u432 \u7907 c cho thu\'ea theo Ph\u7847 n 3 n\'e0y, B\'ean Thu\'ea ho\u7863 c B\'ean Cho Thu\'ea (kh\'f4ng \u273 \u432 \u7907 c \u273 \u7891 ng th\u7901 i c\u7843  B\'ean Thu\'ea v\'e0 B\'ean Cho Thu\'ea) \u273 \u432 \u7907 c c\'e0i \u273 \u7863 t, s\u7917  d\u7909 ng v\'e0 ch\u7841 y c\'e1c b\u7843 n sao ho\u7863 c phi\'ean b\u7843 n b\u7893  sung c\u7911 a Ph\u7847 n M\u7873 m Apple trong m\'f4i tr\u432 \u7901 ng h\u7879  \u273 i\u7873 u h\'e0nh \u7843 o tu\'e2n theo Ph\u7847 n 2B(iii), v\u7899 i \u273 i\u7873 u ki\u7879 n l\'e0 B\'ean Cho Thu\'ea ch\u7881  \u273 \u432 \u7907 c \u7843 o h\'f3a m\u7897 t phi\'ean b\u7843 n ho\u7863 c b\u7843 n sao c\u7911 a Ph\u7847 n M\u7873 m Apple \u273 \u7875  l\'e0m c\'f4ng c\u7909  c\u7845 p quy\u7873 n cho m\u7909 c \u273 \'edch cung c\u7845 p cho B\'ean Thu\'ea kh\u7843  n\u259 ng truy c\u7853 p v\'e0 s\u7917  d\u7909 ng Ph\u7847 n M\u7873 m Apple theo Ph\u7847 n 3 n\'e0y. \expnd0\expndtw0\kerning0
\
\
\kerning1\expnd0\expndtw0 E. \ul C\uc0\u7845 u H\'ecnh H\u7879  Th\u7889 ng\ulnone . N\uc0\u7871 u b\u7841 n l\'e0 B\'ean Thu\'ea th\'ec b\u7841 n x\'e1c nh\u7853 n r\u7857 ng Ph\u7847 n M\u7873 m Apple c\'f3 th\u7875  \u273 \'e3 \u273 \u432 \u7907 c c\u7845 u h\'ecnh tr\u432 \u7899 c b\u7903 i B\'ean Cho Thu\'ea \u273 ang cho b\u7841 n thu\'ea Ph\u7847 n M\u7873 m Apple, bao g\u7891 m m\u7897 t s\u7889  c\'e0i \u273 \u7863 t Ph\'e2n T\'edch, D\u7883 ch V\u7909  \u272 \u7883 nh V\u7883  v\'e0 c\'e1c t\'ednh n\u259 ng kh\'e1c li\'ean quan \u273 \u7871 n b\u7843 o m\u7853 t, quy\u7873 n ri\'eang t\u432  v\'e0 thu th\u7853 p d\u7919  li\u7879 u. B\u7841 n x\'e1c nh\u7853 n v\'e0 \u273 \u7891 ng \'fd r\u7857 ng Apple kh\'f4ng ch\u7883 u tr\'e1ch nhi\u7879 m v\u7873  vi\u7879 c c\u7845 u h\'ecnh Ph\u7847 n M\u7873 m Apple m\'e0 B\'ean Cho Thu\'ea \u273 \'e3 th\u7921 c hi\u7879 n.\expnd0\expndtw0\kerning0
