\f0\b \kerning1\expnd0\expndtw0 XIN VUI L\'d2NG \uc0\u272 \u7884 C K\u7928  H\u7906 P \u272 \u7890 NG C\u7844 P QUY\u7872 N S\u7916  D\u7908 NG PH\u7846 N M\u7872 M N\'c0Y (\'93H\u7906 P \u272 \u7890 NG C\u7844 P QUY\u7872 N S\u7916  D\u7908 NG\'94) TR\u431 \u7898 C KHI S\u7916  D\u7908 NG PH\u7846 N M\u7872 M APPLE. B\u7856 NG VI\u7878 C S\u7916  D\u7908 NG PH\u7846 N M\u7872 M APPLE, B\u7840 N \u272 \u7890 NG \'dd CH\u7882 U S\u7920  R\'c0NG BU\u7896 C C\u7910 A C\'c1C \u272 I\u7872 U KHO\u7842 N TRONG H\u7906 P \u272 \u7890 NG C\u7844 P QUY\u7872 N S\u7916  D\u7908 NG N\'c0Y. N\u7870 U B\u7840 N KH\'d4NG \u272 \u7890 NG \'dd V\u7898 I C\'c1C \u272 I\u7872 U KHO\u7842 N C\u7910 A H\u7906 P \u272 \u7890 NG C\u7844 P QUY\u7872 N S\u7916  D\u7908 NG N\'c0Y, \u272 \u7872  NGH\u7882  B\u7840 N KH\'d4NG C\'c0I \u272 \u7862 T V\'c0/HO\u7862 C KH\'d4NG S\u7916  D\u7908 NG PH\u7846 N M\u7872 M APPLE V\'c0 B\u7844 M V\'c0O M\u7908 C \'93KH\'d4NG \u272 \u7890 NG \'dd\'94N\u7870 U B\u7840 N TH\u7844 Y L\u7920 A CH\u7884 N \'93\u272 \u7890 NG \'dd\'94 HO\u7862 C \'93KH\'d4NG \u272 \u7890 NG \'dd\'94. N\u7870 U B\u7840 N C\'d3 \u272 \u431 \u7906 C PH\u7846 N M\u7872 M APPLE K\'c8M THEO VI\u7878 C MUA PH\u7846 N C\u7912 NG APPLE V\'c0 N\u7870 U B\u7840 N KH\'d4NG \u272 \u7890 NG \'dd V\u7898 I C\'c1C \u272 I\u7872 U KHO\u7842 N C\u7910 A H\u7906 P \u272 \u7890 NG C\u7844 P QUY\u7872 N S\u7916  D\u7908 NG N\'c0Y TH\'cc B\u7840 N C\'d3 TH\u7874  TR\u7842  L\u7840 I TO\'c0N B\u7896  G\'d3I PH\u7846 N C\u7912 NG/PH\u7846 N M\u7872 M APPLE CHO APPLE STORE HO\u7862 C NH\'c0 PH\'c2N PH\u7888 I \u272 \u431 \u7906 C \u7910 Y QUY\u7872 N N\u416 I B\u7840 N \u272 \'c3 MUA G\'d3I N\'c0Y, TRONG TH\u7900 I H\u7840 N \u272 \u431 \u7906 C PH\'c9P TR\u7842  L\u7840 I, \u272 \u7874  \u272 \u431 \u7906 C NH\u7852 N L\u7840 I TI\u7872 N THEO QUY \u272 \u7882 NH CH\'cdNH S\'c1CH TR\u7842  L\u7840 I H\'c0NG C\u7910 A APPLE C\'d3 T\u7840 I {\field{\*\fldinst{HYPERLINK "https://www.apple.com/legal/sales-support/"}}{\fldrslt https://www.apple.com/legal/sales-support/}}. \uc0\u272 \u7874  \u272 \u431 \u7906 C HO\'c0N L\u7840 I TI\u7872 N, B\u7840 N PH\u7842 I TR\u7842  L\u7840 I TO\'c0N B\u7896  G\'d3I PH\u7846 N C\u7912 NG/PH\u7846 N M\u7872 M.
\f1\b0 \expnd0\expndtw0\kerning0
\
\

\f0\b \kerning1\expnd0\expndtw0 L\uc0\u431 U \'dd QUAN TR\u7884 NG: Trong ph\u7841 m vi ph\u7847 n m\u7873 m n\'e0y \u273 \u432 \u7907 c s\u7917  d\u7909 ng \u273 \u7875  t\u7841 o b\u7843 n sao, s\u7917 a \u273 \u7893 i, c\'f4ng b\u7889  ho\u7863 c ph\'e2n ph\u7889 i c\'e1c t\'e0i li\u7879 u, b\u7841 n ch\u7881  \u273 \u432 \u7907 c c\u7845 p quy\u7873 n t\u7841 o b\u7843 n sao, s\u7917 a \u273 \u7893 i, c\'f4ng b\u7889  v\'e0 ph\'e2n ph\u7889 i c\'e1c t\'e0i li\u7879 u kh\'f4ng c\'f3 b\u7843 n quy\u7873 n, c\'e1c t\'e0i li\u7879 u m\'e0 b\u7841 n s\u7903  h\u7919 u b\u7843 n quy\u7873 n ho\u7863 c c\'e1c t\'e0i li\u7879 u m\'e0 b\u7841 n \u273 \u432 \u7907 c trao quy\u7873 n ho\u7863 c \u273 \u432 \u7907 c ph\'e9p t\u7841 o b\u7843 n sao, s\u7917 a \u273 \u7893 i, c\'f4ng b\u7889  ho\u7863 c ph\'e2n ph\u7889 i m\u7897 t c\'e1ch h\u7907 p ph\'e1p. N\u7871 u kh\'f4ng ch\u7855 c ch\u7855 n v\u7873  quy\u7873 n c\u7911 a m\'ecnh \u273 \u7889 i v\u7899 i vi\u7879 c sao ch\'e9p, s\u7917 a \u273 \u7893 i, c\'f4ng b\u7889  ho\u7863 c ph\'e2n ph\u7889 i b\u7845 t k\u7923  t\'e0i li\u7879 u n\'e0o th\'ec b\u7841 n n\'ean li\'ean h\u7879  v\u7899 i c\u7889  v\u7845 n ph\'e1p l\'fd c\u7911 a m\'ecnh.
\f1\b0 \expnd0\expndtw0\kerning0
\
