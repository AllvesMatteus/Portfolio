\f0\b \kerning1\expnd0\expndtw0 1. \uc0\u272 i\u7873 u kho\u7843 n chung.
\f1\b0 \expnd0\expndtw0\kerning0
\
\kerning1\expnd0\expndtw0 A. Ph\uc0\u7847 n m\u7873 m c\u7911 a Apple (bao g\u7891 m m\'e3 Kh\u7903 i \u272 \u7897 ng ROM (Boot ROM code)), b\u7845 t k\u7923  ph\u7847 n m\u7873 m c\u7911 a b\'ean th\u7913  ba n\'e0o, t\'e0i li\u7879 u, giao di\u7879 n, n\u7897 i dung, ph\'f4ng ch\u7919  v\'e0 b\u7845 t k\u7923  d\u7919  li\u7879 u n\'e0o \u273 i k\'e8m H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y ("Ph\u7847 n M\u7873 m Apple G\u7889 c"), c\'f3 th\u7875  \u273 \u432 \u7907 c c\u7853 p nh\u7853 t ho\u7863 c thay th\u7871  b\u7857 ng c\'e1c c\u7843 i ti\u7871 n t\'ednh n\u259 ng, b\u7843 n c\u7853 p nh\u7853 t ph\u7847 n m\u7873 m, ph\u7843 n h\u7891 i b\u7843 o m\u7853 t, t\u7879 p h\u7879  th\u7889 ng ho\u7863 c ph\u7847 n m\u7873 m kh\'f4i ph\u7909 c h\u7879  th\u7889 ng do Apple cung c\u7845 p cho m\'e1y t\'ednh hi\u7879 u Apple ho\u7863 c thi\u7871 t b\u7883  ngo\u7841 i vi \u273 \u432 \u7907 c h\u7895  tr\u7907  c\u7911 a b\u7841 n ("Thay \u272 \u7893 i Cho Ph\u7847 n M\u7873 m Apple"), cho d\'f9 \u273 \u432 \u7907 c c\'e0i \u273 \u7863 t s\u7861 n tr\'ean ph\u7847 n c\u7913 ng hi\u7879 u Apple, tr\'ean b\u7897  nh\u7899  trong, tr\'ean ph\u432 \u417 ng ti\u7879 n di \u273 \u7897 ng, tr\'ean \u7893  \u273 \u297 a, trong b\u7897  nh\u7899  ch\u7881  \u273 \u7885 c hay tr\'ean b\u7845 t k\u7923  ph\u432 \u417 ng ti\u7879 n n\'e0o kh\'e1c ho\u7863 c d\u432 \u7899 i b\u7845 t k\u7923  h\'ecnh th\u7913 c n\'e0o kh\'e1c (Ph\u7847 n M\u7873 m Apple G\u7889 c v\'e0 Thay \u272 \u7893 i Cho Ph\u7847 n M\u7873 m Apple \u273 \u432 \u7907 c g\u7885 i chung l\'e0 "Ph\u7847 n M\u7873 m Apple"), \u273 \u432 \u7907 c Apple Inc. ("Apple") c\u7845 p quy\u7873 n s\u7917  d\u7909 ng, m\'e0 kh\'f4ng b\'e1n cho b\u7841 n, ch\u7881  \u273 \u7875  s\u7917  d\u7909 ng theo c\'e1c \u273 i\u7873 u kho\u7843 n c\u7911 a H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y. Apple v\'e0/ho\u7863 c c\'e1c b\'ean c\u7845 p quy\u7873 n s\u7917  d\u7909 ng c\u7911 a Apple gi\u7919  quy\u7873 n s\u7903  h\u7919 u \u273 \u7889 i v\u7899 i ch\'ednh Ph\u7847 n M\u7873 m Apple v\'e0 b\u7843 o l\u432 u t\u7845 t c\u7843  c\'e1c quy\u7873 n kh\'f4ng \u273 \u432 \u7907 c c\u7845 p cho b\u7841 n m\u7897 t c\'e1ch r\'f5 r\'e0ng. B\u7841 n \u273 \u7891 ng \'fd r\u7857 ng c\'e1c \u273 i\u7873 u kho\u7843 n c\u7911 a H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y s\u7869  \'e1p d\u7909 ng cho b\u7845 t k\u7923  s\u7843 n ph\u7849 m ph\u7847 n m\u7873 m \u7913 ng d\u7909 ng hi\u7879 u Apple n\'e0o m\'e0 c\'f3 th\u7875  \u273 \u432 \u7907 c c\'e0i \u273 \u7863 t s\u7861 n tr\'ean ph\u7847 n c\u7913 ng hi\u7879 u Apple c\u7911 a b\u7841 n, tr\u7915  phi s\u7843 n ph\u7849 m \u273 \'f3 \u273 \u432 \u7907 c cung c\u7845 p k\'e8m theo m\u7897 t h\u7907 p \u273 \u7891 ng c\u7845 p quy\u7873 n s\u7917  d\u7909 ng ri\'eang. Trong tr\u432 \u7901 ng h\u7907 p \u273 \'f3, b\u7841 n \u273 \u7891 ng \'fd r\u7857 ng c\'e1c \u273 i\u7873 u kho\u7843 n c\u7911 a h\u7907 p \u273 \u7891 ng c\u7845 p quy\u7873 n s\u7917  d\u7909 ng ri\'eang s\u7869  \u273 i\u7873 u ch\u7881 nh vi\u7879 c b\u7841 n s\u7917  d\u7909 ng s\u7843 n ph\u7849 m \u273 \'f3.\expnd0\expndtw0\kerning0
\
\
\kerning1\expnd0\expndtw0 B. Theo quy\uc0\u7871 t \u273 \u7883 nh c\u7911 a m\'ecnh, Apple c\'f3 th\u7875  cung c\u7845 p Thay \u272 \u7893 i Cho Ph\u7847 n M\u7873 m Apple trong t\u432 \u417 ng lai. Thay \u272 \u7893 i Cho Ph\u7847 n M\u7873 m Apple, n\u7871 u c\'f3, kh\'f4ng nh\u7845 t thi\u7871 t ph\u7843 i bao g\u7891 m t\u7845 t c\u7843  c\'e1c t\'ednh n\u259 ng ph\u7847 n m\u7873 m hi\u7879 n t\u7841 i ho\u7863 c c\'e1c t\'ednh n\u259 ng m\u7899 i m\'e0 Apple ph\'e1t h\'e0nh cho c\'e1c ki\u7875 u m\'e1y m\u7899 i h\u417 n ho\u7863 c c\'e1c ki\u7875 u m\'e1y kh\'e1c c\u7911 a m\'e1y t\'ednh hi\u7879 u Apple. C\'e1c \u273 i\u7873 u kho\u7843 n c\u7911 a H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y s\u7869  chi ph\u7889 i b\u7845 t k\u7923  Thay \u272 \u7893 i Cho Ph\u7847 n M\u7873 m Apple n\'e0o m\'e0 Apple cung c\u7845 p, tr\u7915  phi Thay \u272 \u7893 i Cho Ph\u7847 n M\u7873 m Apple \u273 \'f3 \u273 i k\'e8m v\u7899 i m\u7897 t h\u7907 p \u273 \u7891 ng c\u7845 p quy\u7873 n s\u7917  d\u7909 ng ri\'eang. Trong tr\u432 \u7901 ng h\u7907 p \u273 \'f3, c\'e1c \u273 i\u7873 u kho\u7843 n c\u7911 a h\u7907 p \u273 \u7891 ng c\u7845 p quy\u7873 n s\u7917  d\u7909 ng ri\'eang s\u7869  c\'f3 hi\u7879 u l\u7921 c chi ph\u7889 i.\expnd0\expndtw0\kerning0
\
\
\kerning1\expnd0\expndtw0 C. C\'e1c quy\uc0\u7873 n s\u7903  h\u7919 u v\'e0 quy\u7873 n s\u7903  h\u7919 u tr\'ed tu\u7879  trong v\'e0 \u273 \u7889 i v\u7899 i b\u7845 t k\u7923  n\u7897 i dung n\'e0o m\'e0 Ph\u7847 n M\u7873 m Apple hi\u7875 n th\u7883  ho\u7863 c \u273 \u432 \u7907 c truy c\u7853 p th\'f4ng qua Ph\u7847 n M\u7873 m Apple \u273 \u7873 u thu\u7897 c v\u7873  ch\u7911  s\u7903  h\u7919 u n\u7897 i dung t\u432 \u417 ng \u7913 ng \u273 \'f3. N\u7897 i dung \u273 \'f3 c\'f3 th\u7875  \u273 \u432 \u7907 c b\u7843 o v\u7879  theo c\'e1c quy \u273 \u7883 nh ph\'e1p lu\u7853 t v\'e0 c\'e1c \u273 i\u7873 u \u432 \u7899 c v\u7873  b\u7843 n quy\u7873 n ho\u7863 c quy\u7873 n s\u7903  h\u7919 u tr\'ed tu\u7879  kh\'e1c, v\'e0 c\'f3 th\u7875  tu\'e2n theo c\'e1c \u273 i\u7873 u kho\u7843 n s\u7917  d\u7909 ng c\u7911 a b\'ean th\u7913  ba cung c\u7845 p n\u7897 i dung \u273 \'f3. Tr\u7915  phi c\'f3 quy \u273 \u7883 nh kh\'e1c trong H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y, H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y kh\'f4ng c\u7845 p cho b\u7841 n b\u7845 t k\u7923  quy\u7873 n n\'e0o \u273 \u7875  s\u7917  d\u7909 ng n\u7897 i dung \u273 \'f3 v\'e0 c\u361 ng kh\'f4ng b\u7843 o \u273 \u7843 m r\u7857 ng n\u7897 i dung \u273 \'f3 s\u7869  \u273 \u432 \u7907 c ti\u7871 p t\u7909 c cung c\u7845 p cho b\u7841 n. B\u7841 n kh\'f4ng \u273 \u432 \u7907 c ph\'e9p t\'e1i b\u7843 n, ph\'e1t t\'e1n l\u7841 i ho\u7863 c t\u7841 o b\u7843 n sao c\u7911 a b\u7845 t k\u7923  h\'ecnh \u7843 nh n\'e0o m\'e0 b\u7841 n truy c\u7853 p th\'f4ng qua News ho\u7863 c B\u7843 n \u272 \u7891  d\u432 \u7899 i d\u7841 ng m\u7897 t t\u7879 p \u273 \u7897 c l\u7853 p.\expnd0\expndtw0\kerning0
\
\

\f0\b \kerning1\expnd0\expndtw0 2. Ph\uc0\u7841 m Vi S\u7917  D\u7909 ng \u272 \u432 \u7907 c Ph\'e9p v\'e0 C\'e1c H\u7841 n Ch\u7871 .
\f1\b0 \expnd0\expndtw0\kerning0
\
\kerning1\expnd0\expndtw0 A. \ul H\uc0\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng Ph\u7847 n M\u7873 m Apple \u272 \u417 n B\u7843 n v\'e0 \u272 \u432 \u7907 c C\'e0i \u272 \u7863 t S\u7861 n\ulnone . Theo c\'e1c \uc0\u273 i\u7873 u kho\u7843 n v\'e0 \u273 i\u7873 u ki\u7879 n c\u7911 a H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y, tr\u7915  phi b\u7841 n c\'f3 \u273 \u432 \u7907 c Ph\u7847 n M\u7873 m Apple t\u7915  Mac App Store, th\'f4ng qua m\u7897 t b\u7843 n t\u7843 i v\u7873  t\u7921  \u273 \u7897 ng ho\u7863 c theo m\u7897 t h\u7907 p \u273 \u7891 ng c\u7845 p quy\u7873 n s\u7917  d\u7909 ng s\u7889  l\u432 \u7907 ng l\u7899 n, h\u7907 p \u273 \u7891 ng duy tr\'ec ho\u7863 c v\u259 n b\u7843 n h\u7907 p \u273 \u7891 ng kh\'e1c t\u7915  Apple, b\u7841 n \u273 \u432 \u7907 c c\u7845 p m\u7897 t gi\u7845 y ph\'e9p h\u7841 n ch\u7871 , kh\'f4ng \u273 \u7897 c quy\u7873 n \u273 \u7875  c\'e0i \u273 \u7863 t, s\u7917  d\u7909 ng v\'e0 ch\u7841 y m\u7897 t (1) b\u7843 n sao Ph\u7847 n M\u7873 m Apple tr\'ean duy nh\u7845 t m\u7897 t m\'e1y t\'ednh hi\u7879 u Apple t\u7841 i m\u7897 t th\u7901 i \u273 i\u7875 m nh\u7845 t \u273 \u7883 nh b\u7845 t k\u7923 . V\'ed d\u7909 : c\'e1c \u273 i\u7873 u kho\u7843 n c\u7845 p quy\u7873 n s\u7917  d\u7909 ng \u273 \u417 n b\u7843 n n\'e0y s\u7869  \'e1p d\u7909 ng cho b\u7841 n n\u7871 u b\u7841 n c\'f3 Ph\u7847 n M\u7873 m Apple \u273 \u432 \u7907 c c\'e0i \u273 \u7863 t s\u7861 n tr\'ean ph\u7847 n c\u7913 ng hi\u7879 u Apple.\expnd0\expndtw0\kerning0
\
\
\kerning1\expnd0\expndtw0 B. \ul H\uc0\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  Dung Mac App Store\ulnone . N\uc0\u7871 u b\u7841 n c\'f3 \u273 \u432 \u7907 c h\u7907 p \u273 \u7891 ng c\u7845 p quy\u7873 n s\u7917  d\u7909 ng \u273 \u7889 i v\u7899 i Ph\u7847 n M\u7873 m Apple t\u7915  Mac App Store ho\u7863 c th\'f4ng qua m\u7897 t b\u7843 n t\u7843 i v\u7873  t\u7921  \u273 \u7897 ng th\'ec theo c\'e1c \u273 i\u7873 u kho\u7843 n v\'e0 \u273 i\u7873 u ki\u7879 n c\u7911 a H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y v\'e0 nh\u432  \u273 \u432 \u7907 c cho ph\'e9p theo Quy T\u7855 c S\u7917  D\u7909 ng D\u7883 ch V\u7909  v\'e0 N\u7897 i Dung c\'f3 trong \u272 i\u7873 u Kho\u7843 n v\'e0 \u272 i\u7873 u Ki\u7879 n V\u7873  D\u7883 ch V\u7909  Truy\u7873 n Th\'f4ng C\u7911 a Apple ({\field{\*\fldinst{HYPERLINK "https://www.apple.com/legal/internet-services/itunes/vn/terms.html"}}{\fldrslt https://www.apple.com/legal/internet-services/itunes/vn/terms.html}}) (\'93Quy T\uc0\u7855 c S\u7917  D\u7909 ng\'94), b\u7841 n \u273 \u432 \u7907 c c\u7845 p m\u7897 t gi\u7845 y ph\'e9p h\u7841 n ch\u7871 , kh\'f4ng th\u7875  chuy\u7875 n nh\u432 \u7907 ng, kh\'f4ng \u273 \u7897 c quy\u7873 n:\expnd0\expndtw0\kerning0
