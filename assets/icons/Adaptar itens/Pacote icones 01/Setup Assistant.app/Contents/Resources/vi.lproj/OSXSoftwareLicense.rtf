\f0\b \kerning1\expnd0\expndtw0 4. Chuy\uc0\u7875 n Giao.
\f1\b0 \expnd0\expndtw0\kerning0
\
\kerning1\expnd0\expndtw0 A. N\uc0\u7871 u b\u7841 n c\'f3 Ph\u7847 n M\u7873 m Apple \u273 \u432 \u7907 c c\'e0i \u273 \u7863 t s\u7861 n tr\'ean ph\u7847 n c\u7913 ng hi\u7879 u Apple ho\u7863 c b\u7841 n c\'f3 \u273 \u432 \u7907 c h\u7907 p \u273 \u7891 ng c\u7845 p quy\u7873 n s\u7917  d\u7909 ng Ph\u7847 n M\u7873 m Apple t\u7915  Mac App Store ho\u7863 c th\'f4ng qua m\u7897 t b\u7843 n c\u7853 p nh\u7853 t ph\u7847 n m\u7873 m, th\'ec b\u7841 n c\'f3 th\u7875  chuy\u7875 n giao m\u7897 t l\u7847 n v\u297 nh vi\u7877 n t\u7845 t c\u7843  c\'e1c quy\u7873 n s\u7917  d\u7909 ng c\u7911 a b\u7841 n \u273 \u7889 i v\u7899 i Ph\u7847 n M\u7873 m Apple (\u7903  d\u7841 ng nguy\'ean b\u7843 n nh\u432  \u273 \u432 \u7907 c Apple cung c\u7845 p) cho m\u7897 t b\'ean kh\'e1c, v\u7899 i \u273 i\u7873 u ki\u7879 n: (i) Ph\u7847 n M\u7873 m Apple \u273 \u432 \u7907 c chuy\u7875 n giao c\'f9ng v\u7899 i ph\u7847 n c\u7913 ng hi\u7879 u Apple c\u7911 a b\u7841 n; (ii) vi\u7879 c chuy\u7875 n giao ph\u7843 i bao g\u7891 m to\'e0n b\u7897  Ph\u7847 n M\u7873 m Apple, k\u7875  c\u7843  c\'e1c th\'e0nh ph\u7847 n c\u7845 u th\'e0nh v\'e0 H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y; (iii) b\u7841 n s\u7869  kh\'f4ng gi\u7919  l\u7841 i b\u7845 t k\u7923  b\u7843 n sao n\'e0o c\u7911 a Ph\u7847 n M\u7873 m Apple, d\'f9 l\'e0 to\'e0n b\u7897  hay m\u7897 t ph\u7847 n, k\u7875  c\u7843  nh\u7919 ng b\u7843 n sao \u273 \u432 \u7907 c l\u432 u tr\u7919  tr\'ean m\'e1y t\'ednh ho\u7863 c thi\u7871 t b\u7883  l\u432 u tr\u7919  kh\'e1c; v\'e0 (iv) b\'ean nh\u7853 n Ph\u7847 n M\u7873 m Apple \u273 \'e3 \u273 \u7885 c v\'e0 \u273 \u7891 ng \'fd ch\u7845 p thu\u7853 n c\'e1c \u273 i\u7873 u kho\u7843 n v\'e0 \u273 i\u7873 u ki\u7879 n c\u7911 a H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y. Cho m\u7909 c \u273 \'edch c\u7911 a H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y, n\u7871 u Apple cung c\u7845 p b\u7843 n c\u7853 p nh\u7853 t (v\'ed d\u7909 : phi\'ean b\u7843 n 10.14 l\'ean phi\'ean b\u7843 n 10.14.1) cho Ph\u7847 n M\u7873 m Apple th\'ec b\u7843 n c\u7853 p nh\u7853 t s\u7869  \u273 \u432 \u7907 c coi l\'e0 m\u7897 t ph\u7847 n c\u7911 a Ph\u7847 n M\u7873 m Apple v\'e0 kh\'f4ng \u273 \u432 \u7907 c ph\'e9p chuy\u7875 n giao m\u7897 t c\'e1ch ri\'eang r\u7869  v\u7899 i phi\'ean b\u7843 n Ph\u7847 n M\u7873 m Apple tr\u432 \u7899 c khi c\u7853 p nh\u7853 t.\expnd0\expndtw0\kerning0
\
\
\kerning1\expnd0\expndtw0 B. B\uc0\u7841 n kh\'f4ng \u273 \u432 \u7907 c chuy\u7875 n giao Ph\u7847 n M\u7873 m Apple \u273 \'e3 s\u7917 a \u273 \u7893 i ho\u7863 c thay th\u7871  theo Ph\u7847 n 2M n\'eau tr\'ean. T\u7845 t c\u7843  c\'e1c th\'e0nh ph\u7847 n c\u7911 a Ph\u7847 n M\u7873 m Apple \u273 \u432 \u7907 c cung c\u7845 p trong m\u7897 t g\'f3i v\'e0 kh\'f4ng \u273 \u432 \u7907 c t\'e1ch r\u7901 i kh\u7887 i g\'f3i \u273 \'f3 \u273 \u7875  ph\'e2n ph\u7889 i nh\u432  l\'e0 c\'e1c \u7913 ng d\u7909 ng \u273 \u7897 c l\u7853 p. L\u432 u \'fd r\u7857 ng Ph\u7847 n M\u7873 m Apple \u273 \u432 \u7907 c cung c\u7845 p v\u7899 i m\u7897 t s\u7843 n ph\u7849 m ph\u7847 n c\u7913 ng hi\u7879 u Apple c\u7909  th\u7875  c\'f3 th\u7875  kh\'f4ng ch\u7841 y tr\'ean c\'e1c ki\u7875 u m\'e1y kh\'e1c c\u7911 a ph\u7847 n c\u7913 ng hi\u7879 u Apple.\expnd0\expndtw0\kerning0
\
\
\kerning1\expnd0\expndtw0 C. B\uc0\u7845 t k\u7923  b\u7843 n sao n\'e0o c\u7911 a Ph\u7847 n M\u7873 m Apple m\'e0 Apple c\'f3 th\u7875  cung c\u7845 p cho m\u7909 c \u273 \'edch khuy\u7871 n m\u7841 i, \u273 \'e1nh gi\'e1, ch\u7849 n \u273 o\'e1n ho\u7863 c kh\'f4i ph\u7909 c s\u7869  ch\u7881  \u273 \u432 \u7907 c s\u7917  d\u7909 ng cho c\'e1c m\u7909 c \u273 \'edch \u273 \'f3 v\'e0 kh\'f4ng \u273 \u432 \u7907 c b\'e1n l\u7841 i ho\u7863 c chuy\u7875 n giao.\expnd0\expndtw0\kerning0
\
\
\kerning1\expnd0\expndtw0 D. Apple c\'f3 th\uc0\u7875  chuy\u7875 n giao t\u7845 t c\u7843  ho\u7863 c b\u7845 t k\u7923  ph\u7847 n n\'e0o c\u7911 a H\u7907 p \u272 \u7891 ng C\u7845 p Quy\u7873 n S\u7917  D\u7909 ng n\'e0y hay m\u7885 i quy\u7873 n ho\u7863 c ngh\u297 a v\u7909  d\u432 \u7899 i \u273 \'e2y cho b\u7845 t k\u7923  \u273 \u417 n v\u7883  li\'ean k\u7871 t ho\u7863 c c\'f4ng ty con n\'e0o c\u7911 a Apple v\'e0o b\u7845 t k\u7923  th\u7901 i \u273 i\u7875 m n\'e0o m\'e0 kh\'f4ng c\u7847 n th\'f4ng b\'e1o.\expnd0\expndtw0\kerning0
