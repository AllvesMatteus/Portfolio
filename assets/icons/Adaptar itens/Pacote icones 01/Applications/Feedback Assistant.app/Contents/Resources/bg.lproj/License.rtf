\f1\b0  \uc0\u1053 \u1072 \u1089 \u1090 \u1086 \u1103 \u1097 \u1080 \u1103 \u1090  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079  \u1077  \u1074  \u1089 \u1080 \u1083 \u1072  \u1076 \u1086  \u1085 \u1077 \u1075 \u1086 \u1074 \u1086 \u1090 \u1086  \u1087 \u1088 \u1077 \u1082 \u1088 \u1072 \u1090 \u1103 \u1074 \u1072 \u1085 \u1077 . \u1042 \u1072 \u1096 \u1080 \u1090 \u1077  \u1087 \u1088 \u1072 \u1074 \u1072  \u1087 \u1086  \u1090 \u1086 \u1079 \u1080  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079  \u1097 \u1077  \u1073 \u1098 \u1076 \u1072 \u1090  \u1087 \u1088 \u1077 \u1082 \u1088 \u1072 \u1090 \u1077 \u1085 \u1080  \u1072 \u1074 \u1090 \u1086 \u1084 \u1072 \u1090 \u1080 \u1095 \u1085 \u1086  \u1080 \u1083 \u1080  \u1087 \u1086  \u1076 \u1088 \u1091 \u1075  \u1085 \u1072 \u1095 \u1080 \u1085  \u1097 \u1077  \u1087 \u1088 \u1077 \u1089 \u1090 \u1072 \u1085 \u1072 \u1090  \u1076 \u1072  \u1076 \u1077 \u1081 \u1089 \u1090 \u1074 \u1072 \u1090  \u1073 \u1077 \u1079  \u1087 \u1088 \u1077 \u1076 \u1080 \u1079 \u1074 \u1077 \u1089 \u1090 \u1080 \u1077  \u1086 \u1090  Apple, \u1072 \u1082 \u1086  \u1085 \u1077  \u1089 \u1087 \u1072 \u1079 \u1080 \u1090 \u1077  \u1091 \u1089 \u1083 \u1086 \u1074 \u1080 \u1077 (\u1103 ) \u1085 \u1072  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 \u1072 . \u1042  \u1076 \u1086 \u1087 \u1098 \u1083 \u1085 \u1077 \u1085 \u1080 \u1077 , Apple \u1089 \u1080  \u1079 \u1072 \u1087 \u1072 \u1079 \u1074 \u1072  \u1087 \u1088 \u1072 \u1074 \u1086 \u1090 \u1086  \u1076 \u1072  \u1087 \u1088 \u1077 \u1082 \u1088 \u1072 \u1090 \u1080  \u1090 \u1086 \u1079 \u1080  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 , \u1072 \u1082 \u1086  \u1073 \u1098 \u1076 \u1077  \u1087 \u1091 \u1089 \u1085 \u1072 \u1090 \u1072  \u1085 \u1086 \u1074 \u1072  \u1074 \u1077 \u1088 \u1089 \u1080 \u1103  \u1085 \u1072  \u1089 \u1086 \u1092 \u1090 \u1091 \u1077 \u1088 \u1072  \u1085 \u1072  \u1086 \u1087 \u1077 \u1088 \u1072 \u1094 \u1080 \u1086 \u1085 \u1085 \u1072 \u1090 \u1072  \u1089 \u1080 \u1089 \u1090 \u1077 \u1084 \u1072  \u1085 \u1072  Apple \u1080 \u1083 \u1080  \u1057 \u1086 \u1092 \u1090 \u1091 \u1077 \u1088 \u1072  \u1085 \u1072  Apple, \u1082 \u1086 \u1103 \u1090 \u1086  \u1077  \u1085 \u1077 \u1089 \u1098 \u1074 \u1084 \u1077 \u1089 \u1090 \u1080 \u1084 \u1072  \u1089  \u1090 \u1072 \u1079 \u1080  \u1074 \u1077 \u1088 \u1089 \u1080 \u1103  \u1085 \u1072  \u1057 \u1086 \u1092 \u1090 \u1091 \u1077 \u1088 \u1072  \u1085 \u1072  Apple. \u1057 \u1083 \u1077 \u1076  \u1087 \u1088 \u1077 \u1082 \u1088 \u1072 \u1090 \u1103 \u1074 \u1072 \u1085 \u1077 \u1090 \u1086  \u1085 \u1072  \u1085 \u1072 \u1089 \u1090 \u1086 \u1103 \u1097 \u1080 \u1103  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079  \u1090 \u1088 \u1103 \u1073 \u1074 \u1072  \u1076 \u1072  \u1087 \u1088 \u1077 \u1082 \u1088 \u1072 \u1090 \u1080 \u1090 \u1077  \u1074 \u1089 \u1103 \u1082 \u1072 \u1082 \u1074 \u1086  \u1080 \u1079 \u1087 \u1086 \u1083 \u1079 \u1074 \u1072 \u1085 \u1077  \u1085 \u1072  \u1057 \u1086 \u1092 \u1090 \u1091 \u1077 \u1088 \u1072  \u1085 \u1072  Apple \u1080  \u1076 \u1072  \u1091 \u1085 \u1080 \u1097 \u1086 \u1078 \u1080 \u1090 \u1077  \u1074 \u1089 \u1080 \u1095 \u1082 \u1080  \u1087 \u1098 \u1083 \u1085 \u1080  \u1080 \u1083 \u1080  \u1095 \u1072 \u1089 \u1090 \u1080 \u1095 \u1085 \u1080  \u1082 \u1086 \u1087 \u1080 \u1103  \u1085 \u1072  \u1057 \u1086 \u1092 \u1090 \u1091 \u1077 \u1088 \u1072  \u1085 \u1072  Apple. \u1056 \u1072 \u1079 \u1076 \u1077 \u1083 \u1080  2\u1041 , 5 (\u1085 \u1086  \u1089 \u1072 \u1084 \u1086  \u1076 \u1086  \u1089 \u1090 \u1077 \u1087 \u1077 \u1085 \u1090 \u1072 , \u1089 \u1098 \u1073 \u1088 \u1072 \u1085 \u1072  \u1087 \u1088 \u1077 \u1076 \u1080  \u1087 \u1088 \u1077 \u1082 \u1088 \u1072 \u1090 \u1103 \u1074 \u1072 \u1085 \u1077 \u1090 \u1086 ), 6, 7, 8 (\u1085 \u1086  \u1089 \u1072 \u1084 \u1086  \u1076 \u1086  \u1089 \u1090 \u1077 \u1087 \u1077 \u1085 \u1090 \u1072 , \u1087 \u1088 \u1077 \u1076 \u1086 \u1089 \u1090 \u1072 \u1074 \u1077 \u1085 \u1072  \u1087 \u1088 \u1077 \u1076 \u1080  \u1087 \u1088 \u1077 \u1082 \u1088 \u1072 \u1090 \u1103 \u1074 \u1072 \u1085 \u1077 \u1090 \u1086 ), 9, 10, 11, 12, 14, 15 \u1080  16 \u1086 \u1090  \u1090 \u1086 \u1079 \u1080  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079  \u1086 \u1089 \u1090 \u1072 \u1074 \u1072 \u1090  \u1074  \u1089 \u1080 \u1083 \u1072  \u1089 \u1083 \u1077 \u1076  \u1074 \u1089 \u1103 \u1082 \u1086  \u1090 \u1072 \u1082 \u1086 \u1074 \u1072  \u1087 \u1088 \u1077 \u1082 \u1088 \u1072 \u1090 \u1103 \u1074 \u1072 \u1085 \u1077 .\
