\f0\b 8. \uc0\u1054 \u1073 \u1088 \u1072 \u1090 \u1085 \u1072  \u1074 \u1088 \u1098 \u1079 \u1082 \u1072 
\f1\b0 . \uc0\u1057 \u1086 \u1092 \u1090 \u1091 \u1077 \u1088 \u1098 \u1090  \u1085 \u1072  Apple \u1097 \u1077  \u1042 \u1080  \u1087 \u1088 \u1077 \u1076 \u1086 \u1089 \u1090 \u1072 \u1074 \u1080  \u1074 \u1098 \u1079 \u1084 \u1086 \u1078 \u1085 \u1086 \u1089 \u1090  \u1076 \u1072  \u1080 \u1079 \u1087 \u1088 \u1072 \u1097 \u1072 \u1090 \u1077  \u1076 \u1086  Apple \u1076 \u1086 \u1082 \u1083 \u1072 \u1076 \u1080  \u1079 \u1072  \u1075 \u1088 \u1077 \u1096 \u1082 \u1080 , \u1074 \u1098 \u1087 \u1088 \u1086 \u1089 \u1085 \u1080 \u1094 \u1080 , \u1079 \u1072 \u1103 \u1074 \u1082 \u1080  \u1079 \u1072  \u1087 \u1086 \u1076 \u1086 \u1073 \u1088 \u1077 \u1085 \u1080 \u1103 , \u1076 \u1086 \u1082 \u1083 \u1072 \u1076 \u1080  \u1079 \u1072  \u1087 \u1088 \u1086 \u1073 \u1083 \u1077 \u1084 \u1080  \u1080 /\u1080 \u1083 \u1080  \u1080 \u1085 \u1092 \u1086 \u1088 \u1084 \u1072 \u1094 \u1080 \u1103  \u1079 \u1072  \u1087 \u1086 \u1076 \u1076 \u1088 \u1098 \u1078 \u1082 \u1072  (\u1085 \u1072 \u1088 \u1080 \u1095 \u1072 \u1085 \u1080  \u1079 \u1072 \u1077 \u1076 \u1085 \u1086  \'84\u1054 \u1073 \u1088 \u1072 \u1090 \u1085 \u1072  \u1074 \u1088 \u1098 \u1079 \u1082 \u1072 \'93) \u1086 \u1090 \u1085 \u1086 \u1089 \u1085 \u1086  \u1042 \u1072 \u1096 \u1072 \u1090 \u1072  \u1089 \u1080 \u1089 \u1090 \u1077 \u1084 \u1072  \u1080 \u1083 \u1080  \u1057 \u1086 \u1092 \u1090 \u1091 \u1077 \u1088 \u1072  \u1085 \u1072  Apple. \u1054 \u1089 \u1074 \u1077 \u1085  \u1072 \u1082 \u1086  \u1085 \u1077  \u1077  \u1087 \u1086 \u1089 \u1086 \u1095 \u1077 \u1085 \u1086  \u1076 \u1088 \u1091 \u1075 \u1086  \u1074  \u1088 \u1072 \u1079 \u1076 \u1077 \u1083  5, \u1042 \u1080 \u1077  \u1089 \u1077  \u1089 \u1098 \u1075 \u1083 \u1072 \u1089 \u1103 \u1074 \u1072 \u1090 \u1077 , \u1095 \u1077  \u1087 \u1088 \u1080  \u1083 \u1080 \u1087 \u1089 \u1072  \u1085 \u1072  \u1086 \u1090 \u1076 \u1077 \u1083 \u1085 \u1086  \u1087 \u1080 \u1089 \u1084 \u1077 \u1085 \u1086  \u1089 \u1087 \u1086 \u1088 \u1072 \u1079 \u1091 \u1084 \u1077 \u1085 \u1080 \u1077  \u1079 \u1072  \u1087 \u1088 \u1086 \u1090 \u1080 \u1074 \u1085 \u1086 \u1090 \u1086 , Apple \u1097 \u1077  \u1080 \u1084 \u1072  \u1089 \u1074 \u1086 \u1073 \u1086 \u1076 \u1072 \u1090 \u1072  \u1076 \u1072  \u1080 \u1079 \u1087 \u1086 \u1083 \u1079 \u1074 \u1072  \u1074 \u1089 \u1103 \u1082 \u1072  \u1054 \u1073 \u1088 \u1072 \u1090 \u1085 \u1072  \u1074 \u1088 \u1098 \u1079 \u1082 \u1072 , \u1082 \u1086 \u1103 \u1090 \u1086  \u1087 \u1088 \u1077 \u1076 \u1086 \u1089 \u1090 \u1072 \u1074 \u1103 \u1090 \u1077 , \u1079 \u1072  \u1074 \u1089 \u1103 \u1082 \u1072 \u1082 \u1074 \u1080  \u1094 \u1077 \u1083 \u1080 . \u1042 \u1080 \u1077  \u1089 \u1098 \u1097 \u1086  \u1090 \u1072 \u1082 \u1072  \u1079 \u1072 \u1103 \u1074 \u1103 \u1074 \u1072 \u1090 \u1077  \u1087 \u1088 \u1077 \u1076  Apple, \u1095 \u1077  \u1080 \u1084 \u1072 \u1090 \u1077  \u1074 \u1089 \u1080 \u1095 \u1082 \u1080  \u1085 \u1077 \u1086 \u1073 \u1093 \u1086 \u1076 \u1080 \u1084 \u1080  \u1087 \u1088 \u1072 \u1074 \u1072 , \u1079 \u1072  \u1076 \u1072  \u1076 \u1072 \u1076 \u1077 \u1090 \u1077  \u1054 \u1073 \u1088 \u1072 \u1090 \u1085 \u1072  \u1074 \u1088 \u1098 \u1079 \u1082 \u1072  \u1080  \u1076 \u1072  \u1087 \u1088 \u1077 \u1076 \u1086 \u1089 \u1090 \u1072 \u1074 \u1080 \u1090 \u1077  \u1087 \u1088 \u1072 \u1074 \u1072 \u1090 \u1072  \u1085 \u1072  Apple \u1087 \u1086 -\u1075 \u1086 \u1088 \u1077 .\
