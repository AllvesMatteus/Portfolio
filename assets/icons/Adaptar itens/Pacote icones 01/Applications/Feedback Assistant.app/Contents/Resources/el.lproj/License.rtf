\f0\b 11. \uc0\u904 \u955 \u949 \u947 \u967 \u959 \u962  \u949 \u958 \u945 \u947 \u969 \u947 \u974 \u957 .
\f1\b0  \uc0\u916 \u949 \u957  \u949 \u960 \u953 \u964 \u961 \u941 \u960 \u949 \u964 \u945 \u953  \u951  \u967 \u961 \u942 \u963 \u951  \u942  \u951  \u949 \u958 \u945 \u947 \u969 \u947 \u942  \u942  \u949 \u960 \u945 \u957 \u949 \u958 \u945 \u947 \u969 \u947 \u942  \u964 \u959 \u965  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  Apple, \u949 \u954 \u964 \u972 \u962  \u949 \u940 \u957  \u949 \u960 \u953 \u964 \u961 \u941 \u960 \u949 \u964 \u945 \u953  \u945 \u960 \u972  \u964 \u951  \u957 \u959 \u956 \u959 \u952 \u949 \u963 \u943 \u945  \u964 \u969 \u957  \u919 \u957 \u969 \u956 \u941 \u957 \u969 \u957  \u928 \u959 \u955 \u953 \u964 \u949 \u953 \u974 \u957  \u954 \u945 \u953  \u964 \u959 \u965 \u962  \u957 \u972 \u956 \u959 \u965 \u962  \u964 \u951 \u962  \u948 \u953 \u954 \u945 \u953 \u959 \u948 \u959 \u963 \u943 \u945 \u962  (\u964 \u969 \u957  \u948 \u953 \u954 \u945 \u953 \u959 \u948 \u959 \u963 \u953 \u974 \u957 ) \u963 \u964 \u951 \u957  \u959 \u960 \u959 \u943 \u945  \u945 \u960 \u959 \u954 \u964 \u942 \u952 \u951 \u954 \u949  \u964 \u959  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u972  Apple. \u931 \u965 \u947 \u954 \u949 \u954 \u961 \u953 \u956 \u941 \u957 \u945 , \u945 \u955 \u955 \u940  \u972 \u967 \u953  \u960 \u949 \u961 \u953 \u959 \u961 \u953 \u963 \u964 \u953 \u954 \u940 , \u964 \u959  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u972  Apple \u948 \u949 \u957  \u956 \u960 \u959 \u961 \u949 \u943  \u957 \u945  \u949 \u958 \u945 \u967 \u952 \u949 \u943  \u942  \u957 \u945  \u949 \u960 \u945 \u957 \u949 \u958 \u945 \u967 \u952 \u949 \u943  (\u945 ) \u963 \u949  \u954 \u940 \u960 \u959 \u953 \u945  \u967 \u974 \u961 \u945  \u963 \u964 \u951 \u957  \u959 \u960 \u959 \u943 \u945  \u941 \u967 \u959 \u965 \u957  \u949 \u960 \u953 \u946 \u940 \u955 \u949 \u953  \u949 \u956 \u960 \u959 \u961 \u953 \u954 \u972  \u945 \u960 \u959 \u954 \u955 \u949 \u953 \u963 \u956 \u972  \u959 \u953  \u919 \u928 \u913  \u942  (\u946 ) \u963 \u949  \u959 \u960 \u959 \u953 \u959 \u957 \u948 \u942 \u960 \u959 \u964 \u949  \u960 \u959 \u965  \u960 \u949 \u961 \u953 \u955 \u945 \u956 \u946 \u940 \u957 \u949 \u964 \u945 \u953  \u963 \u964 \u959 \u957  \u954 \u945 \u964 \u940 \u955 \u959 \u947 \u959  \u917 \u953 \u948 \u953 \u954 \u974 \u962  \u967 \u945 \u961 \u945 \u954 \u964 \u951 \u961 \u953 \u963 \u956 \u941 \u957 \u969 \u957  \u945 \u955 \u955 \u959 \u948 \u945 \u960 \u974 \u957  \u960 \u961 \u959 \u963 \u974 \u960 \u969 \u957  (Specially Designated Nationals List) \u964 \u959 \u965  \u933 \u960 \u959 \u965 \u961 \u947 \u949 \u943 \u959 \u965  \u927 \u953 \u954 \u959 \u957 \u959 \u956 \u953 \u954 \u974 \u957  \u964 \u969 \u957  \u919 \u928 \u913  \u942  \u963 \u964 \u959 \u957  \u954 \u945 \u964 \u940 \u955 \u959 \u947 \u959  \u913 \u960 \u959 \u954 \u955 \u949 \u953 \u963 \u956 \u941 \u957 \u969 \u957  \u966 \u965 \u963 \u953 \u954 \u974 \u957  \u942  \u957 \u959 \u956 \u953 \u954 \u974 \u957  \u960 \u961 \u959 \u963 \u974 \u960 \u969 \u957  \u964 \u959 \u965  \u933 \u960 \u959 \u965 \u961 \u947 \u949 \u943 \u959 \u965  \u917 \u956 \u960 \u959 \u961 \u943 \u959 \u965  \u964 \u969 \u957  \u919 \u928 \u913  \u942  \u940 \u955 \u955 \u959 \u965 \u962  \u964 \u941 \u964 \u959 \u953 \u959 \u965 \u962  \u954 \u945 \u964 \u945 \u955 \u972 \u947 \u959 \u965 \u962  \u945 \u960 \u959 \u954 \u955 \u949 \u953 \u963 \u956 \u941 \u957 \u969 \u957  \u945 \u964 \u972 \u956 \u969 \u957 . \u924 \u949  \u964 \u951  \u955 \u942 \u968 \u951  \u954 \u945 \u953  \u964 \u951  \u967 \u961 \u942 \u963 \u951  \u964 \u959 \u965  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  Apple, \u948 \u951 \u955 \u974 \u957 \u949 \u964 \u949  \u954 \u945 \u953  \u949 \u947 \u947 \u965 \u940 \u963 \u964 \u949  \u972 \u964 \u953  \u948 \u949 \u957  \u946 \u961 \u943 \u963 \u954 \u949 \u963 \u964 \u949  \u963 \u949  \u959 \u960 \u959 \u953 \u945 \u948 \u942 \u960 \u959 \u964 \u949  \u964 \u941 \u964 \u959 \u953 \u945  \u967 \u974 \u961 \u945  \u942  \u963 \u949  \u959 \u960 \u959 \u953 \u945 \u948 \u942 \u960 \u959 \u964 \u949  \u964 \u941 \u964 \u959 \u953 \u945  \u955 \u943 \u963 \u964 \u945 . \u913 \u960 \u959 \u948 \u941 \u967 \u949 \u963 \u964 \u949  \u949 \u960 \u943 \u963 \u951 \u962  \u972 \u964 \u953  \u948 \u949 \u957  \u952 \u945  \u967 \u961 \u951 \u963 \u953 \u956 \u959 \u960 \u959 \u953 \u942 \u963 \u949 \u964 \u949  \u964 \u959  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u972  Apple \u947 \u953 \u945  \u963 \u954 \u959 \u960 \u959 \u973 \u962  \u960 \u959 \u965  \u945 \u960 \u945 \u947 \u959 \u961 \u949 \u973 \u959 \u957 \u964 \u945 \u953  \u945 \u960 \u972  \u964 \u959  \u948 \u943 \u954 \u945 \u953 \u959  \u964 \u969 \u957  \u919 \u928 \u913 , \u972 \u960 \u969 \u962 , \u956 \u949 \u964 \u945 \u958 \u973  \u940 \u955 \u955 \u969 \u957 , \u964 \u951 \u957  \u945 \u957 \u940 \u960 \u964 \u965 \u958 \u951 , \u964 \u959 \u957  \u963 \u967 \u949 \u948 \u953 \u945 \u963 \u956 \u972 , \u964 \u951 \u957  \u954 \u945 \u964 \u945 \u963 \u954 \u949 \u965 \u942  \u942  \u964 \u951 \u957  \u960 \u945 \u961 \u945 \u947 \u969 \u947 \u942  \u960 \u965 \u961 \u945 \u973 \u955 \u969 \u957 , \u960 \u965 \u961 \u951 \u957 \u953 \u954 \u974 \u957 , \u967 \u951 \u956 \u953 \u954 \u974 \u957  \u942  \u946 \u953 \u959 \u955 \u959 \u947 \u953 \u954 \u974 \u957  \u972 \u960 \u955 \u969 \u957 .\
\

\f0\b 12. \uc0\u922 \u945 \u956 \u943 \u945  \u960 \u945 \u961 \u945 \u943 \u964 \u951 \u963 \u951  \u942  \u949 \u954 \u967 \u974 \u961 \u951 \u963 \u951 .
\f1\b0  \uc0\u922 \u945 \u956 \u943 \u945  \u954 \u945 \u952 \u965 \u963 \u964 \u941 \u961 \u951 \u963 \u951  \u942  \u960 \u945 \u961 \u940 \u955 \u949 \u953 \u968 \u951  \u955 \u942 \u968 \u951 \u962  \u956 \u941 \u964 \u961 \u969 \u957  \u963 \u964 \u959  \u960 \u955 \u945 \u943 \u963 \u953 \u959  \u964 \u951 \u962  \u960 \u945 \u961 \u959 \u973 \u963 \u945 \u962  \u902 \u948 \u949 \u953 \u945 \u962  \u967 \u961 \u942 \u963 \u951 \u962  \u948 \u949 \u957  \u952 \u945  \u963 \u965 \u957 \u953 \u963 \u964 \u940  \u960 \u945 \u961 \u945 \u943 \u964 \u951 \u963 \u951 , \u949 \u954 \u964 \u972 \u962  \u949 \u940 \u957  \u951  \u960 \u945 \u961 \u945 \u943 \u964 \u951 \u963 \u951  \u941 \u967 \u949 \u953  \u947 \u943 \u957 \u949 \u953  \u961 \u951 \u964 \u940  \u954 \u945 \u953  \u949 \u947 \u947 \u961 \u940 \u966 \u969 \u962 , \u954 \u945 \u953  \u941 \u967 \u949 \u953  \u965 \u960 \u959 \u947 \u961 \u945 \u966 \u949 \u943  \u945 \u960 \u972  \u948 \u949 \u972 \u957 \u964 \u969 \u962  \u949 \u958 \u959 \u965 \u963 \u953 \u959 \u948 \u959 \u964 \u951 \u956 \u941 \u957 \u959  \u949 \u954 \u960 \u961 \u972 \u963 \u969 \u960 \u959  \u964 \u951 \u962  Apple, \u954 \u945 \u953  \u954 \u945 \u956 \u943 \u945  \u956 \u949 \u956 \u959 \u957 \u969 \u956 \u941 \u957 \u951  \u960 \u945 \u961 \u945 \u943 \u964 \u951 \u963 \u951  \u948 \u949 \u957  \u952 \u945  \u963 \u965 \u957 \u953 \u963 \u964 \u940  \u963 \u965 \u957 \u949 \u967 \u942  \u942  \u956 \u949 \u964 \u945 \u947 \u949 \u957 \u941 \u963 \u964 \u949 \u961 \u951  \u960 \u945 \u961 \u945 \u943 \u964 \u951 \u963 \u951 . \u916 \u949 \u957  \u956 \u960 \u959 \u961 \u949 \u943 \u964 \u949  \u957 \u945  \u949 \u954 \u967 \u969 \u961 \u942 \u963 \u949 \u964 \u949  \u964 \u951 \u957  \u960 \u945 \u961 \u959 \u973 \u963 \u945  \u902 \u948 \u949 \u953 \u945  \u967 \u961 \u942 \u963 \u951 \u962 , \u963 \u964 \u959  \u963 \u973 \u957 \u959 \u955 \u972  \u964 \u951 \u962  \u942  \u949 \u957  \u956 \u941 \u961 \u949 \u953 , \u967 \u969 \u961 \u943 \u962  \u964 \u951 \u957  \u960 \u961 \u959 \u951 \u947 \u959 \u973 \u956 \u949 \u957 \u951  \u947 \u961 \u945 \u960 \u964 \u942  \u941 \u947 \u954 \u961 \u953 \u963 \u951  \u964 \u951 \u962  Apple. \u927 \u960 \u959 \u953 \u945 \u948 \u942 \u960 \u959 \u964 \u949  \u956 \u951  \u963 \u965 \u956 \u956 \u959 \u961 \u966 \u959 \u973 \u956 \u949 \u957 \u951  \u949 \u954 \u967 \u974 \u961 \u951 \u963 \u951  \u952 \u945  \u949 \u943 \u957 \u945 \u953  \u940 \u954 \u965 \u961 \u951  \u954 \u945 \u953  \u967 \u969 \u961 \u943 \u962  \u953 \u963 \u967 \u973 .\
\

\f0\b 13. \uc0\u932 \u949 \u955 \u953 \u954 \u959 \u943  \u967 \u961 \u942 \u963 \u964 \u949 \u962  \u964 \u959 \u965  \u916 \u951 \u956 \u959 \u963 \u943 \u959 \u965 .
\f1\b0  \uc0\u932 \u959  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u972  Apple \u954 \u945 \u953  \u964 \u959  \u963 \u967 \u949 \u964 \u953 \u954 \u972  \u960 \u955 \u951 \u961 \u959 \u966 \u959 \u961 \u953 \u945 \u954 \u972  \u965 \u955 \u953 \u954 \u972  \u945 \u960 \u959 \u964 \u949 \u955 \u959 \u973 \u957  \'ab\u917 \u956 \u960 \u959 \u961 \u953 \u954 \u940  \u960 \u961 \u959 \u970 \u972 \u957 \u964 \u945 \'bb, \u972 \u960 \u969 \u962  \u951  \u941 \u957 \u957 \u959 \u953 \u945  \u945 \u965 \u964 \u942  \u959 \u961 \u943 \u950 \u949 \u964 \u945 \u953  \u963 \u964 \u959  \u940 \u961 \u952 \u961 \u959  48, \u960 \u945 \u961 \u940 \u947 \u961 \u945 \u966 \u959 \u962  2.101 \u964 \u959 \u965  \u922 \u974 \u948 \u953 \u954 \u945  \u959 \u956 \u959 \u963 \u960 \u959 \u957 \u948 \u953 \u945 \u954 \u974 \u957  \u954 \u945 \u957 \u959 \u957 \u953 \u963 \u956 \u974 \u957  (C.F.R.), \u954 \u945 \u953  \u960 \u949 \u961 \u953 \u941 \u967 \u959 \u965 \u957  \'ab\u917 \u956 \u960 \u959 \u961 \u953 \u954 \u972  \u955 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u972  \u965 \u960 \u959 \u955 \u959 \u947 \u953 \u963 \u964 \u974 \u957 \'bb \u954 \u945 \u953  \'ab\u928 \u955 \u951 \u961 \u959 \u966 \u959 \u961 \u953 \u945 \u954 \u972  \u965 \u955 \u953 \u954 \u972  \u949 \u956 \u960 \u959 \u961 \u953 \u954 \u959 \u973  \u955 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  \u965 \u960 \u959 \u955 \u959 \u947 \u953 \u963 \u964 \u974 \u957 \'bb, \u972 \u960 \u969 \u962  \u959 \u953  \u941 \u957 \u957 \u959 \u953 \u949 \u962  \u945 \u965 \u964 \u941 \u962  \u959 \u961 \u943 \u950 \u959 \u957 \u964 \u945 \u953 , \u954 \u945 \u964 \u940  \u960 \u949 \u961 \u943 \u960 \u964 \u969 \u963 \u951 , \u963 \u964 \u959  \u940 \u961 \u952 \u961 \u959  48, \u960 \u945 \u961 \u940 \u947 \u961 \u945 \u966 \u959 \u962  12.212 \u942  \u963 \u964 \u959  \u940 \u961 \u952 \u961 \u959  48, \u960 \u945 \u961 \u940 \u947 \u961 \u945 \u966 \u959 \u962  227.7202 \u964 \u959 \u965  C.F.R. \u931 \u973 \u956 \u966 \u969 \u957 \u945  \u956 \u949  \u964 \u959  \u940 \u961 \u952 \u961 \u959  48, \u960 \u945 \u961 \u940 \u947 \u961 \u945 \u966 \u959 \u962  12.212 \u964 \u959 \u965  C.F.R. \u942  \u964 \u959  \u940 \u961 \u952 \u961 \u959  48, \u960 \u945 \u961 \u940 \u947 \u961 \u945 \u966 \u959 \u962  227.7202 1 \u941 \u969 \u962  227.7202-4 \u964 \u959 \u965  C.F.R., \u954 \u945 \u964 \u940  \u960 \u949 \u961 \u943 \u960 \u964 \u969 \u963 \u951 , \u964 \u959  \u917 \u956 \u960 \u959 \u961 \u953 \u954 \u972  \u955 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u972  \u965 \u960 \u959 \u955 \u959 \u947 \u953 \u963 \u964 \u974 \u957  \u954 \u945 \u953  \u964 \u959  \u928 \u955 \u951 \u961 \u959 \u966 \u959 \u961 \u953 \u945 \u954 \u972  \u965 \u955 \u953 \u954 \u972  \u949 \u956 \u960 \u959 \u961 \u953 \u954 \u959 \u973  \u955 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  \u965 \u960 \u959 \u955 \u959 \u947 \u953 \u963 \u964 \u974 \u957  \u960 \u945 \u961 \u941 \u967 \u959 \u957 \u964 \u945 \u953  \u956 \u949  \u940 \u948 \u949 \u953 \u945  \u967 \u961 \u942 \u963 \u951 \u962  \u963 \u949  \u964 \u949 \u955 \u953 \u954 \u959 \u973 \u962  \u967 \u961 \u942 \u963 \u964 \u949 \u962  \u964 \u951 \u962  \u922 \u965 \u946 \u941 \u961 \u957 \u951 \u963 \u951 \u962  \u964 \u969 \u957  \u919 .\u928 .\u913 . (\u945 ) \u956 \u972 \u957 \u959  \u969 \u962  \u917 \u956 \u960 \u959 \u961 \u953 \u954 \u940  \u960 \u961 \u959 \u970 \u972 \u957 \u964 \u945  \u954 \u945 \u953  (\u946 ) \u956 \u972 \u957 \u959  \u956 \u949  \u964 \u945  \u948 \u953 \u954 \u945 \u953 \u974 \u956 \u945 \u964 \u945  \u949 \u954 \u949 \u943 \u957 \u945  \u972 \u960 \u969 \u962  \u941 \u967 \u959 \u965 \u957  \u967 \u959 \u961 \u951 \u947 \u951 \u952 \u949 \u943  \u963 \u949  \u972 \u955 \u959 \u965 \u962  \u964 \u959 \u965 \u962  \u940 \u955 \u955 \u959 \u965 \u962  \u964 \u949 \u955 \u953 \u954 \u959 \u973 \u962  \u967 \u961 \u942 \u963 \u964 \u949 \u962  \u946 \u940 \u963 \u949 \u953  \u964 \u969 \u957  \u972 \u961 \u969 \u957  \u954 \u945 \u953  \u960 \u961 \u959 \u971 \u960 \u959 \u952 \u941 \u963 \u949 \u969 \u957  \u964 \u959 \u965  \u960 \u945 \u961 \u972 \u957 \u964 \u959 \u962 . \u924 \u949  \u964 \u951 \u957  \u949 \u960 \u953 \u966 \u973 \u955 \u945 \u958 \u951  \u972 \u955 \u969 \u957  \u964 \u969 \u957  \u956 \u951  \u948 \u951 \u956 \u959 \u963 \u953 \u949 \u965 \u956 \u941 \u957 \u969 \u957  \u948 \u953 \u954 \u945 \u953 \u969 \u956 \u940 \u964 \u969 \u957  \u963 \u973 \u956 \u966 \u969 \u957 \u945  \u956 \u949  \u964 \u959  \u948 \u943 \u954 \u945 \u953 \u959  \u960 \u949 \u961 \u943  \u960 \u957 \u949 \u965 \u956 \u945 \u964 \u953 \u954 \u942 \u962  \u953 \u948 \u953 \u959 \u954 \u964 \u951 \u963 \u943 \u945 \u962  \u964 \u969 \u957  \u919 \u957 \u969 \u956 \u941 \u957 \u969 \u957  \u928 \u959 \u955 \u953 \u964 \u949 \u953 \u974 \u957  \u913 \u956 \u949 \u961 \u953 \u954 \u942 \u962 .\
\

\f0\b 14. \uc0\u917 \u966 \u945 \u961 \u956 \u959 \u963 \u964 \u941 \u959  \u948 \u943 \u954 \u945 \u953 \u959  \u954 \u945 \u953  \u948 \u953 \u945 \u967 \u969 \u961 \u953 \u963 \u953 \u956 \u972 \u964 \u951 \u964 \u945 .
\f1\b0  \uc0\u919  \u960 \u945 \u961 \u959 \u973 \u963 \u945  \u902 \u948 \u949 \u953 \u945  \u967 \u961 \u942 \u963 \u951 \u962  \u948 \u953 \u941 \u960 \u949 \u964 \u945 \u953  \u945 \u960 \u972  \u954 \u945 \u953  \u949 \u961 \u956 \u951 \u957 \u949 \u973 \u949 \u964 \u945 \u953  \u963 \u973 \u956 \u966 \u969 \u957 \u945  \u956 \u949  \u964 \u959  \u948 \u943 \u954 \u945 \u953 \u959  \u964 \u951 \u962  \u928 \u959 \u955 \u953 \u964 \u949 \u943 \u945 \u962  \u964 \u951 \u962  \u922 \u945 \u955 \u953 \u966 \u972 \u961 \u957 \u953 \u945 , \u949 \u958 \u945 \u953 \u961 \u959 \u965 \u956 \u941 \u957 \u969 \u957  \u964 \u969 \u957  \u945 \u961 \u967 \u974 \u957  \u963 \u973 \u947 \u954 \u961 \u959 \u965 \u963 \u951 \u962  \u957 \u972 \u956 \u969 \u957 . \u919  \u960 \u945 \u961 \u959 \u973 \u963 \u945  \u902 \u948 \u949 \u953 \u945  \u967 \u961 \u942 \u963 \u951 \u962  \u948 \u949 \u957  \u948 \u953 \u941 \u960 \u949 \u964 \u945 \u953  \u945 \u960 \u972  \u964 \u951  \u931 \u973 \u956 \u946 \u945 \u963 \u951  \u964 \u969 \u957  \u919 \u957 \u969 \u956 \u941 \u957 \u969 \u957  \u917 \u952 \u957 \u974 \u957  \u947 \u953 \u945  \u964 \u953 \u962  \u948 \u953 \u949 \u952 \u957 \u949 \u943 \u962  \u960 \u969 \u955 \u942 \u963 \u949 \u953 \u962  \u954 \u953 \u957 \u951 \u964 \u974 \u957  \u960 \u961 \u945 \u947 \u956 \u940 \u964 \u969 \u957 , \u951  \u949 \u966 \u945 \u961 \u956 \u959 \u947 \u942  \u964 \u951 \u962  \u959 \u960 \u959 \u943 \u945 \u962  \u945 \u960 \u959 \u954 \u955 \u949 \u943 \u949 \u964 \u945 \u953  \u961 \u951 \u964 \u940 . \u913 \u957  \u947 \u953 \u945  \u959 \u960 \u959 \u953 \u959 \u957 \u948 \u942 \u960 \u959 \u964 \u949  \u955 \u972 \u947 \u959  \u941 \u957 \u945  \u948 \u953 \u954 \u945 \u963 \u964 \u942 \u961 \u953 \u959  \u964 \u951 \u962  \u945 \u961 \u956 \u972 \u948 \u953 \u945 \u962  \u948 \u953 \u954 \u945 \u953 \u959 \u948 \u959 \u963 \u943 \u945 \u962  \u954 \u961 \u943 \u957 \u949 \u953  \u972 \u964 \u953  \u959 \u960 \u959 \u953 \u959 \u963 \u948 \u942 \u960 \u959 \u964 \u949  \u972 \u961 \u959 \u962  \u942  \u956 \u941 \u961 \u959 \u962  \u945 \u965 \u964 \u959 \u973  \u949 \u943 \u957 \u945 \u953  \u940 \u954 \u965 \u961 \u959 \u962 , \u951  \u965 \u960 \u972 \u955 \u959 \u953 \u960 \u951  \u902 \u948 \u949 \u953 \u945  \u967 \u961 \u942 \u963 \u951 \u962  \u960 \u945 \u961 \u945 \u956 \u941 \u957 \u949 \u953  \u963 \u949  \u960 \u955 \u942 \u961 \u951  \u953 \u963 \u967 \u973 .\
\

\f0\b 15. \uc0\u928 \u955 \u942 \u961 \u951 \u962  \u963 \u965 \u956 \u966 \u969 \u957 \u943 \u945 : \u922 \u965 \u961 \u943 \u945 \u961 \u967 \u951  \u947 \u955 \u974 \u963 \u963 \u945 .
\f1\b0  \uc0\u919  \u960 \u945 \u961 \u959 \u973 \u963 \u945  \u902 \u948 \u949 \u953 \u945  x\u961 \u942 \u963 \u951 \u962  \u945 \u960 \u959 \u964 \u949 \u955 \u949 \u943  \u964 \u951  \u963 \u965 \u957 \u959 \u955 \u953 \u954 \u942  \u963 \u965 \u956 \u966 \u969 \u957 \u943 \u945  \u956 \u949 \u964 \u945 \u958 \u973  \u949 \u963 \u940 \u962  \u954 \u945 \u953  \u964 \u951 \u962  Apple \u963 \u967 \u949 \u964 \u953 \u954 \u940  \u956 \u949  \u964 \u951  \u967 \u961 \u942 \u963 \u951  \u964 \u959 \u965  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  Apple \u954 \u945 \u953  \u945 \u957 \u964 \u953 \u954 \u945 \u952 \u953 \u963 \u964 \u940  \u972 \u955 \u949 \u962  \u964 \u953 \u962  \u960 \u961 \u959 \u951 \u947 \u959 \u973 \u956 \u949 \u957 \u949 \u962  \u942  \u964 \u961 \u941 \u967 \u959 \u965 \u963 \u949 \u962  \u948 \u953 \u949 \u965 \u952 \u949 \u964 \u942 \u963 \u949 \u953 \u962  \u963 \u967 \u949 \u964 \u953 \u954 \u940  \u956 \u949  \u964 \u959  \u949 \u957  \u955 \u972 \u947 \u969  \u952 \u941 \u956 \u945 . \u922 \u945 \u956 \u943 \u945  \u964 \u961 \u959 \u960 \u959 \u960 \u959 \u943 \u951 \u963 \u951  \u942  \u956 \u949 \u964 \u945 \u946 \u959 \u955 \u942  \u964 \u951 \u962  \u960 \u945 \u961 \u959 \u973 \u963 \u945 \u962  \u902 \u948 \u949 \u953 \u945 \u962  \u967 \u961 \u942 \u963 \u951 \u962  \u948 \u949 \u957  \u952 \u945  \u949 \u943 \u957 \u945 \u953  \u948 \u949 \u963 \u956 \u949 \u965 \u964 \u953 \u954 \u942  \u949 \u954 \u964 \u972 \u962  \u945 \u957  \u963 \u965 \u957 \u964 \u945 \u967 \u952 \u949 \u943  \u949 \u947 \u947 \u961 \u940 \u966 \u969 \u962  \u954 \u945 \u953  \u965 \u960 \u959 \u947 \u961 \u945 \u966 \u949 \u943  \u945 \u960 \u972  \u964 \u951 \u957  Apple. \u932 \u965 \u967 \u972 \u957  \u956 \u949 \u964 \u940 \u966 \u961 \u945 \u963 \u951  \u964 \u951 \u962  \u960 \u945 \u961 \u959 \u973 \u963 \u945 \u962  \u902 \u948 \u949 \u953 \u945 \u962  \u967 \u961 \u942 \u963 \u951 \u962  \u949 \u958 \u965 \u960 \u951 \u961 \u949 \u964 \u949 \u943  \u964 \u953 \u962  \u964 \u959 \u960 \u953 \u954 \u941 \u962  \u945 \u957 \u940 \u947 \u954 \u949 \u962  \u954 \u945 \u953 , \u963 \u949  \u960 \u949 \u961 \u943 \u960 \u964 \u969 \u963 \u951  \u948 \u953 \u945 \u966 \u959 \u961 \u940 \u962  \u956 \u949 \u964 \u945 \u958 \u973  \u964 \u959 \u965  \u954 \u949 \u953 \u956 \u941 \u957 \u959 \u965  \u963 \u964 \u951 \u957  \u945 \u947 \u947 \u955 \u953 \u954 \u942  \u947 \u955 \u974 \u963 \u963 \u945  \u954 \u945 \u953  \u964 \u959 \u965  \u954 \u949 \u953 \u956 \u941 \u957 \u959 \u965  \u963 \u949  \u940 \u955 \u955 \u951  \u947 \u955 \u974 \u963 \u963 \u945 , \u964 \u959  \u954 \u949 \u943 \u956 \u949 \u957 \u959  \u963 \u964 \u951 \u957  \u945 \u947 \u947 \u955 \u953 \u954 \u942  \u947 \u955 \u974 \u963 \u963 \u945  \u952 \u945  \u965 \u960 \u949 \u961 \u953 \u963 \u967 \u973 \u949 \u953  \u963 \u964 \u959 \u957  \u946 \u945 \u952 \u956 \u972  \u960 \u959 \u965  \u948 \u949 \u957  \u945 \u960 \u945 \u947 \u959 \u961 \u949 \u973 \u949 \u964 \u945 \u953  \u945 \u960 \u972  \u964 \u951 \u957  \u964 \u959 \u960 \u953 \u954 \u942  \u957 \u959 \u956 \u959 \u952 \u949 \u963 \u943 \u945  \u964 \u951 \u962  \u948 \u953 \u954 \u945 \u953 \u959 \u948 \u959 \u963 \u943 \u945 \u962  \u963 \u945 \u962 .\
