\f0\b 16. \uc0\u913 \u957 \u945 \u947 \u957 \u969 \u961 \u943 \u963 \u949 \u953 \u962  \u964 \u961 \u943 \u964 \u969 \u957  \u956 \u949 \u961 \u974 \u957 .
\f1\b0  \uc0\u927 \u961 \u953 \u963 \u956 \u941 \u957 \u945  \u963 \u964 \u959 \u953 \u967 \u949 \u943 \u945  \u964 \u959 \u965  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  Apple \u954 \u945 \u953  \u960 \u961 \u959 \u947 \u961 \u940 \u956 \u956 \u945 \u964 \u945  \u945 \u957 \u959 \u953 \u954 \u964 \u959 \u973  \u954 \u974 \u948 \u953 \u954 \u945  \u964 \u961 \u943 \u964 \u969 \u957  \u960 \u959 \u965  \u960 \u949 \u961 \u953 \u955 \u945 \u956 \u946 \u940 \u957 \u959 \u957 \u964 \u945 \u953  \u963 \u964 \u959  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u972  \u964 \u951 \u962  Apple, \u949 \u957 \u948 \u941 \u967 \u949 \u964 \u945 \u953  \u957 \u945  \u948 \u953 \u945 \u964 \u943 \u952 \u949 \u957 \u964 \u945 \u953  \u945 \u960 \u972  \u964 \u951 \u957  Apple \u963 \u964 \u959 \u957  \u953 \u963 \u964 \u972 \u964 \u959 \u960 \u959  \u945 \u957 \u959 \u953 \u954 \u964 \u959 \u973  \u954 \u974 \u948 \u953 \u954 \u945  ({\field{\*\fldinst{HYPERLINK "https://opensource.apple.com"}}{\fldrslt https://opensource.apple.com}}) (\'ab\uc0\u931 \u964 \u959 \u953 \u967 \u949 \u943 \u945  \u945 \u957 \u959 \u953 \u954 \u964 \u959 \u973  \u954 \u974 \u948 \u953 \u954 \u945 \'bb). \u927 \u953  \u945 \u957 \u945 \u947 \u957 \u969 \u961 \u943 \u963 \u949 \u953 \u962 , \u959 \u953  \u972 \u961 \u959 \u953  \u945 \u948 \u949 \u953 \u959 \u948 \u972 \u964 \u951 \u963 \u951 \u962  \u954 \u945 \u953  \u959 \u953  \u945 \u960 \u959 \u960 \u959 \u953 \u942 \u963 \u949 \u953 \u962  \u947 \u953 \u945  \u964 \u945  \u949 \u957  \u955 \u972 \u947 \u969  \u963 \u964 \u959 \u953 \u967 \u949 \u943 \u945  \u960 \u949 \u961 \u953 \u941 \u967 \u959 \u957 \u964 \u945 \u953  \u963 \u964 \u951 \u957  \u951 \u955 \u949 \u954 \u964 \u961 \u959 \u957 \u953 \u954 \u942  \u964 \u949 \u954 \u956 \u951 \u961 \u943 \u969 \u963 \u951  \u947 \u953 \u945  \u964 \u959  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u972  \u964 \u951 \u962  Apple. \u913 \u957 \u945 \u964 \u961 \u941 \u958 \u964 \u949  \u963 \u964 \u951 \u957  \u951 \u955 \u949 \u954 \u964 \u961 \u959 \u957 \u953 \u954 \u942  \u964 \u949 \u954 \u956 \u951 \u961 \u943 \u969 \u963 \u951 , \u954 \u945 \u952 \u974 \u962  \u949 \u957 \u948 \u941 \u967 \u949 \u964 \u945 \u953  \u957 \u945  \u941 \u967 \u949 \u964 \u949  \u960 \u961 \u972 \u963 \u952 \u949 \u964 \u945  \u948 \u953 \u954 \u945 \u953 \u974 \u956 \u945 \u964 \u945  \u963 \u964 \u945  \u931 \u964 \u959 \u953 \u967 \u949 \u943 \u945  \u945 \u957 \u959 \u953 \u954 \u964 \u959 \u973  \u954 \u974 \u948 \u953 \u954 \u945 . \u913 \u957 \u945 \u947 \u957 \u969 \u961 \u943 \u950 \u949 \u964 \u949  \u961 \u951 \u964 \u940  \u972 \u964 \u953  \u949 \u940 \u957  \u951  \u948 \u965 \u963 \u955 \u949 \u953 \u964 \u959 \u965 \u961 \u947 \u943 \u945  \u942  \u951  \u946 \u955 \u940 \u946 \u951  \u963 \u964 \u959  \u965 \u955 \u953 \u963 \u956 \u953 \u954 \u972  \u964 \u951 \u962  Apple \u960 \u961 \u959 \u954 \u973 \u968 \u949 \u953  \u945 \u960 \u972  \u964 \u951 \u957  \u964 \u961 \u959 \u960 \u959 \u960 \u959 \u943 \u951 \u963 \u951  \u964 \u969 \u957  \u931 \u964 \u959 \u953 \u967 \u949 \u943 \u969 \u957  \u945 \u957 \u959 \u953 \u954 \u964 \u959 \u973  \u954 \u974 \u948 \u953 \u954 \u945  \u964 \u959 \u965  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  \u964 \u951 \u962  Apple, \u951  \u949 \u957  \u955 \u972 \u947 \u969  \u948 \u965 \u963 \u955 \u949 \u953 \u964 \u959 \u965 \u961 \u947 \u943 \u945  \u942  \u946 \u955 \u940 \u946 \u951  \u949 \u958 \u945 \u953 \u961 \u949 \u943 \u964 \u945 \u953  \u945 \u960 \u972  \u964 \u959 \u965 \u962  \u972 \u961 \u959 \u965 \u962  \u964 \u951 \u962  \u949 \u947 \u947 \u973 \u951 \u963 \u951 \u962  \u965 \u955 \u953 \u963 \u956 \u953 \u954 \u959 \u973  \u964 \u951 \u962  Apple.\
