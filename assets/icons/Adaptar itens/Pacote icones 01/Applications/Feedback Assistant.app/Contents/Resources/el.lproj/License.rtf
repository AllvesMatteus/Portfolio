\f0\b 7. \uc0\u923 \u973 \u963 \u951 .
\f1\b0  \uc0\u919  \u960 \u945 \u961 \u959 \u973 \u963 \u945  \u902 \u948 \u949 \u953 \u945  \u967 \u961 \u942 \u963 \u951 \u962  \u953 \u963 \u967 \u973 \u949 \u953  \u956 \u941 \u967 \u961 \u953  \u964 \u951  \u955 \u973 \u963 \u951  \u964 \u951 \u962 . \u932 \u945  \u948 \u953 \u954 \u945 \u953 \u974 \u956 \u945 \u964 \u940  \u963 \u945 \u962  \u948 \u965 \u957 \u940 \u956 \u949 \u953  \u964 \u951 \u962  \u960 \u945 \u961 \u959 \u973 \u963 \u945 \u962  \u902 \u948 \u949 \u953 \u945 \u962  \u967 \u961 \u942 \u963 \u951 \u962  \u945 \u943 \u961 \u959 \u957 \u964 \u945 \u953  \u945 \u965 \u964 \u972 \u956 \u945 \u964 \u945  \u942  \u949 \u953 \u948 \u940 \u955 \u955 \u969 \u962  \u960 \u945 \u973 \u959 \u965 \u957  \u957 \u945  \u953 \u963 \u967 \u973 \u959 \u965 \u957  \u967 \u969 \u961 \u943 \u962  \u960 \u961 \u959 \u949 \u953 \u948 \u959 \u960 \u959 \u943 \u951 \u963 \u951  \u945 \u960 \u972  \u964 \u951 \u957  Apple \u963 \u949  \u960 \u949 \u961 \u943 \u960 \u964 \u969 \u963 \u951  \u956 \u951  \u963 \u965 \u956 \u956 \u972 \u961 \u966 \u969 \u963 \u942 \u962  \u963 \u945 \u962  \u956 \u949  \u959 \u960 \u959 \u953 \u959 \u957 \u948 \u942 \u960 \u959 \u964 \u949  \u972 \u961 \u959  \u942  \u972 \u961 \u959 \u965 \u962  \u964 \u951 \u962  \u960 \u945 \u961 \u959 \u973 \u963 \u945 \u962  \u902 \u948 \u949 \u953 \u945 \u962  \u967 \u961 \u942 \u963 \u951 \u962 . \u917 \u960 \u953 \u960 \u955 \u941 \u959 \u957 , \u951  Apple \u948 \u953 \u945 \u964 \u951 \u961 \u949 \u943  \u964 \u959  \u948 \u953 \u954 \u945 \u943 \u969 \u956 \u945  \u957 \u945  \u954 \u945 \u964 \u945 \u947 \u947 \u949 \u943 \u955 \u949 \u953  \u964 \u951 \u957  \u960 \u945 \u961 \u959 \u973 \u963 \u945  \u902 \u948 \u949 \u953 \u945  \u935 \u961 \u942 \u963 \u951 \u962  \u949 \u940 \u957  \u954 \u965 \u954 \u955 \u959 \u966 \u959 \u961 \u942 \u963 \u949 \u953  \u956 \u953 \u945  \u957 \u941 \u945  \u941 \u954 \u948 \u959 \u963 \u951  \u964 \u959 \u965  \u955 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  \u964 \u959 \u965  \u955 \u949 \u953 \u964 \u959 \u965 \u961 \u947 \u953 \u954 \u959 \u973  \u963 \u965 \u963 \u964 \u942 \u956 \u945 \u964 \u959 \u962  \u964 \u951 \u962  Apple \u942  \u964 \u959 \u965  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  Apple \u951  \u959 \u960 \u959 \u943 \u945  \u948 \u949 \u957  \u949 \u943 \u957 \u945 \u953  \u963 \u965 \u956 \u946 \u945 \u964 \u942  \u956 \u949  \u964 \u951 \u957  \u960 \u945 \u961 \u959 \u973 \u963 \u945  \u941 \u954 \u948 \u959 \u963 \u951  \u964 \u959 \u965  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  Apple. \u924 \u949 \u964 \u940  \u964 \u951  \u955 \u973 \u963 \u951  \u964 \u951 \u962  \u960 \u945 \u961 \u959 \u973 \u963 \u945 \u962  \u902 \u948 \u949 \u953 \u945 \u962  \u967 \u961 \u942 \u963 \u951 \u962 , \u959 \u966 \u949 \u943 \u955 \u949 \u964 \u949  \u957 \u945  \u948 \u953 \u945 \u954 \u972 \u968 \u949 \u964 \u949  \u954 \u940 \u952 \u949  \u967 \u961 \u942 \u963 \u951  \u964 \u959 \u965  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  Apple \u954 \u945 \u953  \u957 \u945  \u954 \u945 \u964 \u945 \u963 \u964 \u961 \u941 \u968 \u949 \u964 \u949  \u972 \u955 \u945  \u964 \u945  \u945 \u957 \u964 \u943 \u947 \u961 \u945 \u966 \u945 , \u956 \u949 \u961 \u953 \u954 \u940  \u942  \u960 \u955 \u942 \u961 \u951 , \u964 \u959 \u965  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u959 \u973  Apple. \u927 \u953  \u949 \u957 \u972 \u964 \u951 \u964 \u949 \u962  2\u914 , 5 (\u945 \u955 \u955 \u940  \u956 \u972 \u957 \u959  \u963 \u964 \u959  \u946 \u945 \u952 \u956 \u972  \u960 \u959 \u965  \u945 \u960 \u959 \u954 \u964 \u942 \u952 \u951 \u954 \u945 \u957  \u960 \u961 \u953 \u957  \u945 \u960 \u972  \u964 \u951  \u955 \u973 \u963 \u951 ), 6, 7, 8 (\u945 \u955 \u955 \u940  \u956 \u972 \u957 \u959  \u963 \u964 \u959  \u946 \u945 \u952 \u956 \u972  \u960 \u959 \u965  \u960 \u961 \u959 \u946 \u955 \u941 \u960 \u949 \u964 \u945 \u953  \u960 \u961 \u953 \u957  \u945 \u960 \u972  \u964 \u951  \u955 \u973 \u963 \u951 ), 9, 10, 11, 12, 14, 15 \u954 \u945 \u953  16 \u964 \u951 \u962  \u960 \u945 \u961 \u959 \u973 \u963 \u945 \u962  \u902 \u948 \u949 \u953 \u945 \u962  \u952 \u945  \u949 \u958 \u945 \u954 \u959 \u955 \u959 \u965 \u952 \u942 \u963 \u959 \u965 \u957  \u957 \u945  \u953 \u963 \u967 \u973 \u959 \u965 \u957  \u963 \u949  \u960 \u949 \u961 \u943 \u960 \u964 \u969 \u963 \u951  \u959 \u960 \u959 \u953 \u945 \u963 \u948 \u942 \u960 \u959 \u964 \u949  \u955 \u973 \u963 \u951 \u962 .\
\

\f0\b 8. \uc0\u931 \u967 \u972 \u955 \u953 \u945 .
\f1\b0  \uc0\u932 \u959  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u972  Apple \u952 \u945  \u963 \u945 \u962  \u960 \u945 \u961 \u941 \u967 \u949 \u953  \u964 \u951  \u948 \u965 \u957 \u945 \u964 \u972 \u964 \u951 \u964 \u945  \u957 \u945  \u965 \u960 \u959 \u946 \u940 \u955 \u955 \u949 \u964 \u949  \u963 \u964 \u951 \u957  Apple \u945 \u957 \u945 \u966 \u959 \u961 \u941 \u962  \u963 \u966 \u945 \u955 \u956 \u940 \u964 \u969 \u957 , \u949 \u961 \u969 \u964 \u951 \u956 \u945 \u964 \u959 \u955 \u972 \u947 \u953 \u945 , \u945 \u953 \u964 \u942 \u963 \u949 \u953 \u962  \u946 \u949 \u955 \u964 \u943 \u969 \u963 \u951 \u962 , \u945 \u957 \u945 \u966 \u959 \u961 \u941 \u962  \u960 \u961 \u959 \u946 \u955 \u951 \u956 \u940 \u964 \u969 \u957  \u942 /\u954 \u945 \u953  \u960 \u955 \u951 \u961 \u959 \u966 \u959 \u961 \u943 \u949 \u962  \u965 \u960 \u959 \u963 \u964 \u942 \u961 \u953 \u958 \u951 \u962  (\u963 \u965 \u955 \u955 \u959 \u947 \u953 \u954 \u940  \u963 \u964 \u959  \u949 \u958 \u942 \u962 , \'ab\u964 \u945  \u931 \u967 \u972 \u955 \u953 \u945 \'bb) \u963 \u967 \u949 \u964 \u953 \u954 \u940  \u956 \u949  \u964 \u959  \u931 \u973 \u963 \u964 \u951 \u956 \u940  \u963 \u945 \u962  \u942  \u964 \u959  \u923 \u959 \u947 \u953 \u963 \u956 \u953 \u954 \u972  Apple. \u917 \u954 \u964 \u972 \u962  \u949 \u940 \u957  \u959 \u961 \u943 \u950 \u949 \u964 \u945 \u953  \u948 \u953 \u945 \u966 \u959 \u961 \u949 \u964 \u953 \u954 \u940  \u963 \u964 \u951 \u957  \u917 \u957 \u972 \u964 \u951 \u964 \u945  5, \u963 \u965 \u956 \u966 \u969 \u957 \u949 \u943 \u964 \u949  \u972 \u964 \u953 , \u949 \u955 \u955 \u949 \u943 \u968 \u949 \u953  \u958 \u949 \u967 \u969 \u961 \u953 \u963 \u964 \u942 \u962  \u947 \u961 \u945 \u960 \u964 \u942 \u962  \u963 \u965 \u956 \u966 \u969 \u957 \u943 \u945 \u962  \u960 \u949 \u961 \u943  \u964 \u959 \u965  \u945 \u957 \u964 \u953 \u952 \u941 \u964 \u959 \u965 , \u951  Apple \u952 \u945  \u949 \u943 \u957 \u945 \u953  \u949 \u955 \u949 \u973 \u952 \u949 \u961 \u951  \u957 \u945  \u967 \u961 \u951 \u963 \u953 \u956 \u959 \u960 \u959 \u953 \u949 \u943  \u959 \u960 \u959 \u953 \u945 \u948 \u942 \u960 \u959 \u964 \u949  \u931 \u967 \u972 \u955 \u953 \u959  \u960 \u959 \u965  \u960 \u945 \u961 \u941 \u967 \u949 \u964 \u949  \u947 \u953 \u945  \u959 \u960 \u959 \u953 \u959 \u957 \u948 \u942 \u960 \u959 \u964 \u949  \u963 \u954 \u959 \u960 \u972 . \u916 \u951 \u955 \u974 \u957 \u949 \u964 \u949  \u949 \u960 \u943 \u963 \u951 \u962  \u963 \u964 \u951 \u957  Apple \u972 \u964 \u953  \u948 \u953 \u945 \u952 \u941 \u964 \u949 \u964 \u949  \u972 \u955 \u945  \u964 \u945  \u945 \u960 \u945 \u961 \u945 \u943 \u964 \u951 \u964 \u945  \u948 \u953 \u954 \u945 \u953 \u974 \u956 \u945 \u964 \u945  \u947 \u953 \u945  \u964 \u951 \u957  \u960 \u945 \u961 \u959 \u967 \u942  \u964 \u969 \u957  \u931 \u967 \u959 \u955 \u943 \u969 \u957  \u954 \u945 \u953  \u964 \u951 \u957  \u960 \u945 \u961 \u945 \u967 \u974 \u961 \u951 \u963 \u951  \u964 \u969 \u957  \u960 \u945 \u961 \u945 \u960 \u940 \u957 \u969  \u948 \u953 \u954 \u945 \u953 \u969 \u956 \u940 \u964 \u969 \u957  \u963 \u964 \u951 \u957  Apple.\
\

\f0\b 9. \uc0\u913 \u960 \u959 \u960 \u959 \u943 \u951 \u963 \u951  \u949 \u947 \u947 \u965 \u942 \u963 \u949 \u969 \u957 .\

\f1\b0 \uc0\u913 . \u913 \u925 \u913 \u915 \u925 \u937 \u929 \u921 \u918 \u917 \u932 \u917  \u929 \u919 \u932 \u913  \u922 \u913 \u921  \u931 \u933 \u924 \u934 \u937 \u925 \u917 \u921 \u932 \u917  \u927 \u932 \u921 , \u931 \u932 \u927  \u914 \u913 \u920 \u924 \u927  \u928 \u927 \u933  \u917 \u928 \u921 \u932 \u929 \u917 \u928 \u917 \u932 \u913 \u921  \u913 \u928 \u927  \u932 \u919 \u925  \u921 \u931 \u935 \u933 \u927 \u933 \u931 \u913  \u925 \u927 \u924 \u927 \u920 \u917 \u931 \u921 \u913 , \u919  \u935 \u929 \u919 \u931 \u919  \u932 \u927 \u933  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927 \u933  APPLE \u915 \u921 \u925 \u917 \u932 \u913 \u921  \u924 \u917  \u916 \u921 \u922 \u919  \u931 \u913 \u931  \u913 \u928 \u927 \u922 \u923 \u917 \u921 \u931 \u932 \u921 \u922 \u919  \u917 \u933 \u920 \u933 \u925 \u919  \u922 \u913 \u921  \u927 \u932 \u921  \u932 \u927  \u931 \u933 \u925 \u927 \u923 \u927  \u932 \u927 \u933  \u922 \u921 \u925 \u916 \u933 \u925 \u927 \u933  \u927 \u931 \u927 \u925  \u913 \u934 \u927 \u929 \u913  \u932 \u919 \u925  \u921 \u922 \u913 \u925 \u927 \u928 \u927 \u921 \u919 \u932 \u921 \u922 \u919  \u928 \u927 \u921 \u927 \u932 \u919 \u932 \u913 , \u913 \u928 \u927 \u916 \u927 \u931 \u919 , \u913 \u922 \u929 \u921 \u914 \u917 \u921 \u913  \u922 \u913 \u921  \u928 \u929 \u927 \u931 \u928 \u913 \u920 \u917 \u921 \u913  \u914 \u913 \u929 \u933 \u925 \u917 \u921  \u917 \u931 \u913 \u931 .\
\
\uc0\u914 . \u931 \u932 \u927  \u924 \u917 \u915 \u921 \u931 \u932 \u927  \u914 \u913 \u920 \u924 \u927  \u928 \u927 \u933  \u917 \u928 \u921 \u932 \u929 \u917 \u928 \u917 \u932 \u913 \u921  \u913 \u928 \u927  \u932 \u919 \u925  \u921 \u931 \u935 \u933 \u927 \u933 \u931 \u913  \u925 \u927 \u924 \u927 \u920 \u917 \u931 \u921 \u913 , \u932 \u927  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927  APPLE \u928 \u913 \u929 \u917 \u935 \u917 \u932 \u913 \u921  \'ab\u937 \u931  \u917 \u935 \u917 \u921 \'bb \u922 \u913 \u921  \'ab\u937 \u931  \u916 \u921 \u913 \u932 \u921 \u920 \u917 \u932 \u913 \u921 \'bb, \u924 \u917  \u927 \u923 \u913  \u932 \u913  \u931 \u934 \u913 \u923 \u924 \u913 \u932 \u913  \u922 \u913 \u921  \u935 \u937 \u929 \u921 \u931  \u922 \u913 \u924 \u921 \u913  \u917 \u915 \u915 \u933 \u919 \u931 \u919 , \u922 \u913 \u921  \u919  APPLE \u922 \u913 \u921  \u927 \u921  \u916 \u921 \u922 \u913 \u921 \u927 \u928 \u913 \u929 \u927 \u935 \u927 \u921  \u932 \u919 \u931  APPLE (\u928 \u927 \u933  \u913 \u925 \u913 \u934 \u917 \u929 \u927 \u925 \u932 \u913 \u921  \u931 \u933 \u923 \u923 \u927 \u915 \u921 \u922 \u913  \u937 \u931  \'abAPPLE\'bb \u915 \u921 \u913  \u932 \u927 \u933 \u931  \u931 \u922 \u927 \u928 \u927 \u933 \u931  \u932 \u937 \u925  \u917 \u925 \u927 \u932 \u919 \u932 \u937 \u925  9 \u922 \u913 \u921  10) \u913 \u928 \u927 \u928 \u927 \u921 \u927 \u933 \u925 \u932 \u913 \u921  \u924 \u917  \u932 \u927  \u928 \u913 \u929 \u927 \u925  \u927 \u928 \u927 \u921 \u917 \u931 \u916 \u919 \u928 \u927 \u932 \u917  \u917 \u915 \u915 \u933 \u919 \u931 \u917 \u921 \u931  \u922 \u913 \u921  \u927 \u929 \u927  \u931 \u917  \u931 \u935 \u917 \u931 \u919  \u924 \u917  \u932 \u927  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927  APPLE, \u917 \u921 \u932 \u917  \u929 \u919 \u932 \u917 \u931 , \u917 \u921 \u932 \u917  \u931 \u921 \u937 \u928 \u919 \u929 \u917 \u931 , \u917 \u921 \u932 \u917  \u925 \u927 \u924 \u921 \u924 \u917 \u931 , \u931 \u933 \u924 \u928 \u917 \u929 \u921 \u923 \u913 \u924 \u914 \u913 \u925 \u927 \u924 \u917 \u925 \u937 \u925 , \u917 \u925 \u916 \u917 \u921 \u922 \u932 \u921 \u922 \u913 , \u932 \u937 \u925  \u931 \u921 \u937 \u928 \u919 \u929 \u937 \u925  \u917 \u915 \u915 \u933 \u919 \u931 \u917 \u937 \u925  \u919 /\u922 \u913 \u921  \u927 \u929 \u937 \u925  \u917 \u924 \u928 \u927 \u929 \u917 \u933 \u931 \u921 \u924 \u927 \u932 \u919 \u932 \u913 \u931 , \u921 \u922 \u913 \u925 \u927 \u928 \u927 \u921 \u919 \u932 \u921 \u922 \u919 \u931  \u928 \u927 \u921 \u927 \u932 \u919 \u932 \u913 \u931 , \u922 \u913 \u932 \u913 \u923 \u923 \u919 \u923 \u927 \u932 \u919 \u932 \u913 \u931  \u915 \u921 \u913  \u931 \u933 \u915 \u922 \u917 \u922 \u929 \u921 \u924 \u917 \u925 \u927  \u931 \u922 \u927 \u928 \u927 , \u913 \u922 \u929 \u921 \u914 \u917 \u921 \u913 \u931 , \u919 \u931 \u933 \u935 \u919 \u931  \u913 \u928 \u927 \u923 \u913 \u933 \u931 \u919 \u931  \u922 \u913 \u921  \u924 \u919  \u928 \u913 \u929 \u913 \u914 \u921 \u913 \u931 \u919 \u931  \u916 \u921 \u922 \u913 \u921 \u937 \u924 \u913 \u932 \u937 \u925  \u932 \u929 \u921 \u932 \u937 \u925 .\
\
\uc0\u915 . \u919  APPLE \u916 \u917 \u925  \u917 \u915 \u915 \u933 \u913 \u932 \u913 \u921  \u927 \u932 \u921  \u916 \u917 \u925  \u920 \u913  \u933 \u928 \u913 \u929 \u926 \u917 \u921  \u916 \u921 \u913 \u932 \u913 \u929 \u913 \u926 \u919  \u932 \u919 \u931  \u935 \u929 \u919 \u931 \u919 \u931  \u932 \u927 \u933  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927 \u933  APPLE, \u927 \u932 \u921  \u927 \u921  \u923 \u917 \u921 \u932 \u927 \u933 \u929 \u915 \u921 \u917 \u931  \u928 \u927 \u933  \u928 \u917 \u929 \u921 \u923 \u913 \u924 \u914 \u913 \u925 \u927 \u925 \u932 \u913 \u921  \u931 \u932 \u927  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927  APPLE \u920 \u913  \u913 \u925 \u932 \u913 \u928 \u927 \u922 \u929 \u921 \u920 \u927 \u933 \u925  \u931 \u932 \u921 \u931  \u913 \u928 \u913 \u921 \u932 \u919 \u931 \u917 \u921 \u931  \u931 \u913 \u931 , \u927 \u932 \u921  \u919  \u923 \u917 \u921 \u932 \u927 \u933 \u929 \u915 \u921 \u913  \u932 \u927 \u933  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927 \u933  APPLE \u920 \u913  \u917 \u921 \u925 \u913 \u921  \u913 \u916 \u921 \u913 \u923 \u917 \u921 \u928 \u932 \u919  \u905  \u935 \u937 \u929 \u921 \u931  \u931 \u934 \u913 \u923 \u924 \u913 \u932 \u913 , \u927 \u932 \u921  \u932 \u927  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927  APPLE \u920 \u913  \u917 \u921 \u925 \u913 \u921  \u931 \u933 \u924 \u914 \u913 \u932 \u927  \u905  \u920 \u913  \u923 \u917 \u921 \u932 \u927 \u933 \u929 \u915 \u917 \u921  \u924 \u917  \u927 \u928 \u927 \u921 \u927 \u916 \u919 \u928 \u927 \u932 \u917  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927 , \u917 \u934 \u913 \u929 \u924 \u927 \u915 \u917 \u931  \u905  \u933 \u928 \u919 \u929 \u917 \u931 \u921 \u917 \u931  \u932 \u929 \u921 \u932 \u937 \u925 , \u905  \u927 \u932 \u921  \u932 \u933 \u935 \u927 \u925  \u917 \u923 \u913 \u932 \u932 \u937 \u924 \u913 \u932 \u913  \u931 \u932 \u927  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927  APPLE \u920 \u913  \u916 \u921 \u927 \u929 \u920 \u937 \u920 \u927 \u933 \u925 . \u919  \u917 \u915 \u922 \u913 \u932 \u913 \u931 \u932 \u913 \u931 \u919  \u913 \u933 \u932 \u927 \u933  \u932 \u927 \u933  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927 \u933  APPLE \u917 \u925 \u916 \u917 \u935 \u917 \u932 \u913 \u921  \u925 \u913  \u917 \u928 \u919 \u929 \u917 \u913 \u931 \u917 \u921  \u932 \u919  \u916 \u921 \u913 \u920 \u917 \u931 \u921 \u924 \u927 \u932 \u919 \u932 \u913  \u922 \u913 \u921  \u935 \u929 \u919 \u931 \u932 \u921 \u922 \u927 \u932 \u919 \u932 \u913  \u932 \u927 \u933  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927 \u933  \u932 \u929 \u921 \u932 \u937 \u925 , \u932 \u921 \u931  \u917 \u934 \u913 \u929 \u924 \u927 \u915 \u917 \u931  \u905  \u932 \u921 \u931  \u933 \u928 \u919 \u929 \u917 \u931 \u921 \u917 \u931  \u932 \u929 \u921 \u932 \u937 \u925 , \u922 \u913 \u920 \u937 \u931  \u922 \u913 \u921  \u932 \u913  \u928 \u929 \u927 \u938 \u927 \u925 \u932 \u913  \u922 \u913 \u921  \u932 \u921 \u931  \u933 \u928 \u919 \u929 \u917 \u931 \u921 \u917 \u931  APPLE.\
\
\uc0\u916 . \u917 \u928 \u921 \u928 \u929 \u927 \u931 \u920 \u917 \u932 \u937 \u931 , \u913 \u925 \u913 \u915 \u925 \u937 \u929 \u921 \u918 \u917 \u932 \u917  \u927 \u932 \u921  \u932 \u927  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927  APPLE \u916 \u917 \u925  \u928 \u929 \u927 \u927 \u929 \u921 \u918 \u917 \u932 \u913 \u921  \u927 \u933 \u932 \u917  \u917 \u921 \u925 \u913 \u921  \u922 \u913 \u932 \u913 \u923 \u923 \u919 \u923 \u927  \u915 \u921 \u913  \u935 \u929 \u919 \u931 \u919  \u931 \u917  \u928 \u917 \u929 \u921 \u931 \u932 \u913 \u931 \u917 \u921 \u931  \u905  \u928 \u917 \u929 \u921 \u914 \u913 \u923 \u923 \u927 \u925 \u932 \u913  \u927 \u928 \u927 \u933  \u919  \u913 \u925 \u917 \u928 \u913 \u929 \u922 \u917 \u921 \u913 , \u927 \u921  \u922 \u913 \u920 \u933 \u931 \u932 \u917 \u929 \u919 \u931 \u917 \u921 \u931 , \u932 \u913  \u931 \u934 \u913 \u923 \u924 \u913 \u932 \u913  \u905  \u927 \u921  \u913 \u925 \u913 \u922 \u929 \u921 \u914 \u917 \u921 \u917 \u931  \u931 \u932 \u927  \u928 \u917 \u929 \u921 \u917 \u935 \u927 \u924 \u917 \u925 \u927 , \u932 \u913  \u916 \u917 \u916 \u927 \u924 \u917 \u925 \u913  \u905  \u932 \u921 \u931  \u928 \u923 \u919 \u929 \u927 \u934 \u927 \u929 \u921 \u917 \u931  \u928 \u927 \u933  \u928 \u913 \u929 \u917 \u935 \u927 \u925 \u932 \u913 \u921  \u913 \u928 \u927  \u932 \u927  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927  APPLE \u917 \u925 \u916 \u917 \u935 \u917 \u932 \u913 \u921  \u925 \u913  \u917 \u935 \u927 \u933 \u925  \u937 \u931  \u931 \u933 \u925 \u917 \u928 \u917 \u921 \u913  \u932 \u927 \u925  \u920 \u913 \u925 \u913 \u932 \u927 , \u931 \u937 \u924 \u913 \u932 \u921 \u922 \u917 \u931  \u914 \u923 \u913 \u914 \u917 \u931  \u905  \u931 \u927 \u914 \u913 \u929 \u917 \u931  \u933 \u923 \u921 \u922 \u917 \u931  \u918 \u919 \u924 \u921 \u917 \u931  \u905  \u918 \u919 \u924 \u921 \u913  \u931 \u932 \u927  \u928 \u917 \u929 \u921 \u914 \u913 \u923 \u923 \u927 \u925 , \u931 \u933 \u924 \u928 \u917 \u929 \u921 \u923 \u913 \u924 \u914 \u913 \u925 \u927 \u924 \u917 \u925 \u937 \u925  \u935 \u937 \u929 \u921 \u931  \u928 \u917 \u929 \u921 \u927 \u929 \u921 \u931 \u924 \u927  \u932 \u919 \u931  \u923 \u917 \u921 \u932 \u927 \u933 \u929 \u915 \u921 \u913 \u931  \u928 \u933 \u929 \u919 \u925 \u921 \u922 \u937 \u925  \u917 \u915 \u922 \u913 \u932 \u913 \u931 \u932 \u913 \u931 \u917 \u937 \u925 , \u931 \u933 \u931 \u932 \u919 \u924 \u913 \u932 \u937 \u925  \u928 \u923 \u927 \u919 \u915 \u919 \u931 \u919 \u931  \u905  \u917 \u928 \u921 \u922 \u927 \u921 \u925 \u937 \u925 \u921 \u913 \u931  \u913 \u917 \u929 \u927 \u931 \u922 \u913 \u934 \u937 \u925 , \u917 \u923 \u917 \u915 \u935 \u927 \u933  \u917 \u925 \u913 \u917 \u929 \u921 \u913 \u931  \u922 \u933 \u922 \u923 \u927 \u934 \u927 \u929 \u921 \u913 \u931 , \u933 \u928 \u927 \u931 \u932 \u919 \u929 \u921 \u926 \u919 \u931  \u918 \u937 \u932 \u921 \u922 \u937 \u925  \u923 \u917 \u921 \u932 \u927 \u933 \u929 \u915 \u921 \u937 \u925  \u905  \u927 \u928 \u923 \u921 \u922 \u937 \u925  \u931 \u933 \u931 \u932 \u919 \u924 \u913 \u932 \u937 \u925 .\
\
\uc0\u917 . \u922 \u913 \u924 \u921 \u913  \u928 \u929 \u927 \u934 \u927 \u929 \u921 \u922 \u919  \u905  \u915 \u929 \u913 \u928 \u932 \u919  \u928 \u923 \u919 \u929 \u927 \u934 \u927 \u929 \u921 \u913  \u905  \u931 \u933 \u924 \u914 \u927 \u933 \u923 \u919  \u928 \u927 \u933  \u928 \u913 \u929 \u917 \u935 \u917 \u932 \u913 \u921  \u913 \u928 \u927  \u932 \u919 \u925  APPLE \u905  \u917 \u925 \u913 \u925  \u917 \u926 \u927 \u933 \u931 \u921 \u927 \u916 \u927 \u932 \u919 \u924 \u917 \u925 \u927  \u913 \u925 \u932 \u921 \u928 \u929 \u927 \u931 \u937 \u928 \u927  \u932 \u919 \u931  APPLE \u916 \u917 \u925  \u920 \u913  \u913 \u928 \u927 \u932 \u917 \u923 \u917 \u921  \u917 \u915 \u915 \u933 \u919 \u931 \u919 . \u917 \u913 \u925  \u932 \u927  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927  APPLE \u913 \u928 \u927 \u916 \u917 \u921 \u935 \u932 \u917 \u921  \u917 \u923 \u913 \u932 \u932 \u937 \u924 \u913 \u932 \u921 \u922 \u927 , \u913 \u925 \u913 \u923 \u913 \u924 \u914 \u913 \u925 \u917 \u932 \u917  \u932 \u927  \u931 \u933 \u925 \u927 \u923 \u921 \u922 \u927  \u922 \u927 \u931 \u932 \u927 \u931  \u922 \u913 \u920 \u917  \u913 \u928 \u913 \u929 \u913 \u921 \u932 \u919 \u932 \u927 \u933  \u931 \u917 \u929 \u914 \u921 \u931 , \u917 \u928 \u921 \u931 \u922 \u917 \u933 \u919 \u931  \u905  \u917 \u928 \u921 \u916 \u921 \u927 \u929 \u920 \u937 \u931 \u919 \u931 . \u927 \u929 \u921 \u931 \u924 \u917 \u925 \u917 \u931  \u916 \u921 \u922 \u913 \u921 \u927 \u916 \u927 \u931 \u921 \u917 \u931  \u916 \u917 \u925  \u917 \u928 \u921 \u932 \u929 \u917 \u928 \u927 \u933 \u925  \u932 \u927 \u925  \u913 \u928 \u927 \u922 \u923 \u917 \u921 \u931 \u924 \u927  \u931 \u921 \u937 \u928 \u919 \u929 \u937 \u925  \u917 \u915 \u915 \u933 \u919 \u931 \u917 \u937 \u925  \u905  \u932 \u927 \u925  \u928 \u917 \u929 \u921 \u927 \u929 \u921 \u931 \u924 \u927  \u932 \u937 \u925  \u916 \u921 \u922 \u913 \u921 \u937 \u924 \u913 \u932 \u937 \u925  \u932 \u937 \u925  \u922 \u913 \u932 \u913 \u925 \u913 \u923 \u937 \u932 \u937 \u925  \u928 \u927 \u933  \u928 \u929 \u927 \u914 \u923 \u917 \u928 \u927 \u925 \u932 \u913 \u921  \u917 \u922  \u932 \u927 \u933  \u925 \u927 \u924 \u927 \u933 , \u931 \u933 \u925 \u917 \u928 \u937 \u931  \u927 \u921  \u928 \u913 \u929 \u913 \u928 \u913 \u925 \u937  \u913 \u928 \u927 \u922 \u923 \u917 \u921 \u931 \u924 \u927 \u921  \u922 \u913 \u921  \u928 \u917 \u929 \u921 \u927 \u929 \u921 \u931 \u924 \u927 \u921  \u917 \u925 \u916 \u917 \u935 \u917 \u932 \u913 \u921  \u925 \u913  \u924 \u919 \u925  \u921 \u931 \u935 \u933 \u927 \u933 \u925  \u915 \u921 \u913  \u917 \u931 \u913 \u931 .\
\

\f0\b 10. \uc0\u928 \u949 \u961 \u953 \u959 \u961 \u953 \u963 \u956 \u972 \u962  \u949 \u965 \u952 \u973 \u957 \u951 \u962 .
\f1\b0  \uc0\u931 \u932 \u927  \u914 \u913 \u920 \u924 \u927  \u928 \u927 \u933  \u916 \u917 \u925  \u913 \u928 \u913 \u915 \u927 \u929 \u917 \u933 \u917 \u932 \u913 \u921  \u913 \u928 \u927  \u932 \u919 \u925  \u921 \u931 \u935 \u933 \u927 \u933 \u931 \u913  \u925 \u927 \u924 \u927 \u920 \u917 \u931 \u921 \u913 , \u931 \u917  \u922 \u913 \u924 \u921 \u913  \u928 \u917 \u929 \u921 \u928 \u932 \u937 \u931 \u919  \u919  APPLE \u916 \u917 \u925  \u920 \u913  \u917 \u933 \u920 \u933 \u925 \u917 \u932 \u913 \u921  \u915 \u921 \u913  \u931 \u937 \u924 \u913 \u932 \u921 \u922 \u917 \u931  \u914 \u923 \u913 \u914 \u917 \u931  \u919  \u927 \u928 \u927 \u921 \u913 \u916 \u919 \u928 \u927 \u932 \u917  \u932 \u933 \u935 \u913 \u921 \u913 , \u917 \u921 \u916 \u921 \u922 \u919 , \u917 \u924 \u924 \u917 \u931 \u919  \u919  \u917 \u928 \u913 \u922 \u927 \u923 \u927 \u933 \u920 \u919  \u918 \u919 \u924 \u921 \u913 , \u931 \u933 \u924 \u928 \u917 \u929 \u921 \u923 \u913 \u924 \u914 \u913 \u925 \u927 \u924 \u917 \u925 \u937 \u925 , \u935 \u937 \u929 \u921 \u931  \u928 \u917 \u929 \u921 \u927 \u929 \u921 \u931 \u924 \u927 , \u918 \u919 \u924 \u921 \u937 \u925  \u915 \u921 \u913  \u913 \u928 \u937 \u923 \u917 \u921 \u913  \u922 \u917 \u929 \u916 \u937 \u925 , \u913 \u923 \u923 \u927 \u921 \u937 \u931 \u919  \u919  \u913 \u928 \u937 \u923 \u917 \u921 \u913  \u916 \u917 \u916 \u927 \u924 \u917 \u925 \u937 \u925 , \u913 \u916 \u933 \u925 \u913 \u924 \u921 \u913  \u924 \u917 \u932 \u913 \u916 \u927 \u931 \u919 \u931  \u919  \u923 \u919 \u936 \u919 \u931  \u916 \u917 \u916 \u927 \u924 \u917 \u925 \u937 \u925  \u919  \u928 \u923 \u919 \u929 \u927 \u934 \u927 \u929 \u921 \u937 \u925 , \u916 \u921 \u913 \u922 \u927 \u928 \u919  \u932 \u919 \u931  \u917 \u928 \u921 \u935 \u917 \u921 \u929 \u919 \u924 \u913 \u932 \u921 \u922 \u919 \u931  \u916 \u929 \u913 \u931 \u932 \u919 \u929 \u921 \u927 \u932 \u919 \u932 \u913 \u931  \u919  \u927 \u928 \u927 \u921 \u913 \u916 \u919 \u928 \u927 \u932 \u917  \u913 \u923 \u923 \u919  \u917 \u924 \u928 \u927 \u929 \u921 \u922 \u919  \u918 \u919 \u924 \u921 \u913  \u919  \u913 \u928 \u937 \u923 \u917 \u921 \u913 , \u928 \u927 \u933  \u928 \u929 \u927 \u922 \u933 \u928 \u932 \u917 \u921  \u913 \u928 \u927  \u919  \u931 \u935 \u917 \u932 \u921 \u918 \u917 \u932 \u913 \u921  \u924 \u917  \u932 \u919  \u935 \u929 \u919 \u931 \u919  \u919  \u932 \u919 \u925  \u913 \u916 \u933 \u925 \u913 \u924 \u921 \u913  \u935 \u929 \u919 \u931 \u919 \u931  \u932 \u927 \u933  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927 \u933  APPLE \u919  \u927 \u928 \u927 \u921 \u927 \u933 \u916 \u919 \u928 \u927 \u932 \u917  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927 \u933  \u919  \u917 \u934 \u913 \u929 \u924 \u927 \u915 \u937 \u925  \u932 \u929 \u921 \u932 \u937 \u925  \u931 \u917  \u931 \u933 \u925 \u916 \u933 \u913 \u931 \u924 \u927  \u924 \u917  \u932 \u927  \u923 \u927 \u915 \u921 \u931 \u924 \u921 \u922 \u927  APPLE, \u913 \u925 \u917 \u926 \u913 \u929 \u932 \u919 \u932 \u913  \u913 \u928 \u927  \u932 \u919 \u925  \u913 \u921 \u932 \u921 \u913 , \u913 \u925 \u917 \u926 \u913 \u929 \u932 \u919 \u932 \u913  \u913 \u928 \u927  \u932 \u919  \u920 \u917 \u937 \u929 \u921 \u913  \u932 \u919 \u931  \u917 \u933 \u920 \u933 \u925 \u919 \u931  (\u931 \u933 \u924 \u914 \u913 \u931 \u919 , \u913 \u916 \u921 \u922 \u927 \u928 \u929 \u913 \u926 \u921 \u913  \u919  \u913 \u923 \u923 \u937 \u931 ) \u922 \u913 \u921  \u913 \u922 \u927 \u924 \u919  \u922 \u913 \u921  \u913 \u925  \u919  APPLE \u917 \u935 \u917 \u921  \u917 \u925 \u919 \u924 \u917 \u929 \u937 \u920 \u917 \u921  \u915 \u921 \u913  \u932 \u919 \u925  \u928 \u921 \u920 \u913 \u925 \u927 \u932 \u919 \u932 \u913  \u932 \u917 \u932 \u927 \u921 \u937 \u925  \u918 \u919 \u924 \u921 \u937 \u925 . \u927 \u929 \u921 \u931 \u924 \u917 \u925 \u917 \u931  \u916 \u921 \u922 \u913 \u921 \u927 \u916 \u927 \u931 \u921 \u917 \u931  \u916 \u917 \u925  \u917 \u928 \u921 \u932 \u929 \u917 \u928 \u927 \u933 \u925  \u932 \u919 \u925  \u917 \u926 \u913 \u921 \u929 \u917 \u931 \u919  \u905  \u932 \u927 \u925  \u928 \u917 \u929 \u921 \u927 \u929 \u921 \u931 \u924 \u927  \u932 \u919 \u931  \u917 \u933 \u920 \u933 \u925 \u919 \u931  \u915 \u921 \u913  \u931 \u937 \u924 \u913 \u932 \u921 \u922 \u917 \u931  \u914 \u923 \u913 \u914 \u917 \u931  \u905  \u915 \u921 \u913  \u931 \u933 \u924 \u928 \u932 \u937 \u924 \u913 \u932 \u921 \u922 \u917 \u931  \u905  \u917 \u928 \u913 \u922 \u927 \u923 \u927 \u933 \u920 \u917 \u931  \u918 \u919 \u924 \u921 \u917 \u931 , \u931 \u933 \u925 \u917 \u928 \u937 \u931  \u913 \u933 \u932 \u919  \u919  \u929 \u919 \u932 \u929 \u913  \u928 \u917 \u929 \u921 \u927 \u929 \u921 \u931 \u924 \u927 \u933  \u917 \u933 \u920 \u933 \u925 \u919 \u931  \u917 \u925 \u916 \u917 \u935 \u917 \u932 \u913 \u921  \u925 \u913  \u924 \u919 \u925  \u921 \u931 \u935 \u933 \u917 \u921  \u915 \u921 \u913  \u917 \u931 \u913 \u931 . \u931 \u949  \u954 \u945 \u956 \u943 \u945  \u960 \u949 \u961 \u943 \u960 \u964 \u969 \u963 \u951  \u951  \u963 \u965 \u957 \u959 \u955 \u953 \u954 \u942  \u949 \u965 \u952 \u973 \u957 \u951  \u964 \u951 \u962  Apple \u960 \u961 \u959 \u962  \u949 \u963 \u940 \u962  \u947 \u953 \u945  \u972 \u955 \u949 \u962  \u964 \u953 \u962  \u950 \u951 \u956 \u943 \u949 \u962  (\u949 \u954 \u964 \u972 \u962  \u945 \u960 \u972  \u964 \u953 \u962  \u960 \u949 \u961 \u953 \u960 \u964 \u974 \u963 \u949 \u953 \u962  \u960 \u959 \u965  \u945 \u960 \u945 \u953 \u964 \u959 \u973 \u957 \u964 \u945 \u953  \u945 \u960 \u972  \u964 \u959  \u953 \u963 \u967 \u973 \u959 \u957  \u948 \u943 \u954 \u945 \u953 \u959  \u959 \u953  \u959 \u960 \u959 \u943 \u949 \u962  \u945 \u966 \u959 \u961 \u959 \u973 \u957  \u963 \u969 \u956 \u945 \u964 \u953 \u954 \u942  \u946 \u955 \u940 \u946 \u951 ) \u948 \u949 \u957  \u952 \u945  \u965 \u960 \u949 \u961 \u946 \u945 \u943 \u957 \u949 \u953  \u964 \u959  \u960 \u959 \u963 \u972  \u964 \u969 \u957  \u960 \u949 \u957 \u942 \u957 \u964 \u945  \u948 \u959 \u955 \u945 \u961 \u943 \u969 \u957  \u919 \u928 \u913  (50,00\'a0$). \u927 \u953  \u945 \u957 \u969 \u964 \u941 \u961 \u969  \u960 \u949 \u961 \u953 \u959 \u961 \u953 \u963 \u956 \u959 \u943  \u964 \u951 \u962  \u949 \u965 \u952 \u973 \u957 \u951 \u962  \u953 \u963 \u967 \u973 \u959 \u965 \u957  \u945 \u954 \u972 \u956 \u951  \u954 \u945 \u953  \u945 \u957  \u964 \u959  \u960 \u961 \u959 \u945 \u957 \u945 \u966 \u949 \u961 \u952 \u941 \u957  \u956 \u941 \u963 \u959  \u945 \u960 \u959 \u954 \u945 \u964 \u940 \u963 \u964 \u945 \u963 \u951 \u962  \u948 \u949 \u957  \u954 \u945 \u955 \u973 \u960 \u964 \u949 \u953  \u964 \u959 \u957  \u963 \u954 \u959 \u960 \u972  \u947 \u953 \u945  \u964 \u959 \u957  \u959 \u960 \u959 \u943 \u959  \u960 \u961 \u959 \u959 \u961 \u943 \u950 \u949 \u964 \u945 \u953 .\
