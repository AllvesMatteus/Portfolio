B. \ul \uc0\u1050 \u1077 \u1088 \u1110  \u1078 \u1086 \u1073 \u1072 \u1083 \u1072 \u1091 \u1171 \u1072  \u1090 \u1099 \u1081 \u1099 \u1084 ; \u1073 \u1072 \u1089 \u1179 \u1072  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1091  \u1096 \u1077 \u1082 \u1090 \u1077 \u1091 \u1083 \u1077 \u1088 \u1110 .\ulnone  \uc0\u1050 \u1257 \u1096 \u1110 \u1088 \u1091  (\u1086 \u1089 \u1099  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103 \u1084 \u1077 \u1085  \u1090 \u1110 \u1082 \u1077 \u1083 \u1077 \u1081  \u1088 \u1201 \u1179 \u1089 \u1072 \u1090  \u1077 \u1090 \u1110 \u1083 \u1075 \u1077 \u1085  \u1078 \u1072 \u1171 \u1076 \u1072 \u1081 \u1083 \u1072 \u1088 \u1076 \u1099  \u1179 \u1086 \u1089 \u1087 \u1072 \u1171 \u1072 \u1085 \u1076 \u1072 ), \u1179 \u1072 \u1081 \u1090 \u1072  \u1179 \u1201 \u1088 \u1091 , \u1082 \u1077 \u1088 \u1110  \u1241 \u1079 \u1110 \u1088 \u1083 \u1077 \u1091 , \u1073 \u1257 \u1083 \u1096 \u1077 \u1082 \u1090 \u1077 \u1091 , \u1073 \u1072 \u1089 \u1090 \u1072 \u1087 \u1179 \u1099  \u1082 \u1086 \u1076 \u1090 \u1099  \u1096 \u1099 \u1171 \u1072 \u1088 \u1099 \u1087  \u1072 \u1083 \u1091 , \u1096 \u1080 \u1092 \u1088 \u1099 \u1085  \u1072 \u1096 \u1091 , \u1090 \u1199 \u1088 \u1083 \u1077 \u1085 \u1076 \u1110 \u1088 \u1091 , Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1086 \u1085 \u1099 \u1187  \u1082 \u1077 \u1079  \u1082 \u1077 \u1083 \u1075 \u1077 \u1085  \u1073 \u1257 \u1083 \u1110 \u1075 \u1110 \u1085 \u1110 \u1187  (\u1078 \u1086 \u1171 \u1072 \u1088 \u1099 \u1076 \u1072  \u1072 \u1090 \u1072 \u1083 \u1171 \u1072 \u1085  \u1082 \u1077 \u1079  \u1082 \u1077 \u1083 \u1075 \u1077 \u1085  \u1096 \u1077 \u1082 \u1090 \u1077 \u1091 \u1075 \u1077  \u1179 \u1086 \u1083 \u1076 \u1072 \u1085 \u1099 \u1089 \u1090 \u1072 \u1171 \u1099  \u1079 \u1072 \u1187 \u1084 \u1077 \u1085  \u1090 \u1099 \u1081 \u1099 \u1084  \u1089 \u1072 \u1083 \u1099 \u1085 \u1171 \u1072 \u1085  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1072 \u1096 \u1099 \u1179  \u1073 \u1072 \u1089 \u1090 \u1072 \u1087 \u1179 \u1099  \u1082 \u1086 \u1084 \u1087 \u1086 \u1085 \u1077 \u1085 \u1090 \u1090 \u1077 \u1088 \u1076 \u1110  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1091 \u1076 \u1099  \u1088 \u1077 \u1090 \u1090 \u1077 \u1081 \u1090 \u1110 \u1085  \u1083 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103 \u1083 \u1099 \u1179  \u1096 \u1072 \u1088 \u1090 \u1090 \u1072 \u1088 \u1084 \u1077 \u1085  \u1088 \u1201 \u1179 \u1089 \u1072 \u1090  \u1077 \u1090 \u1110 \u1083 \u1077 \u1090 \u1110 \u1085  \u1078 \u1072 \u1171 \u1076 \u1072 \u1081 \u1083 \u1072 \u1088 \u1076 \u1072 \u1085  \u1073 \u1072 \u1089 \u1179 \u1072 ) \u1090 \u1091 \u1099 \u1085 \u1076 \u1099  \u1078 \u1201 \u1084 \u1099 \u1089 \u1090 \u1072 \u1088 \u1099 \u1085  \u1179 \u1201 \u1088 \u1091 \u1171 \u1072  \u1241 \u1088 \u1077 \u1082 \u1077 \u1090 \u1090 \u1077 \u1085 \u1091  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1086 \u1085 \u1099  \u1257 \u1079  \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1072 \u1088 \u1099 \u1187 \u1099 \u1079 \u1171 \u1072  \u1077 \u1085 \u1075 \u1110 \u1079 \u1091  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1179 \u1201 \u1088 \u1072 \u1089 \u1090 \u1099 \u1088 \u1091  \u1241 \u1088 \u1077 \u1082 \u1077 \u1090 \u1090 \u1077 \u1088 \u1110 \u1085  \u1078 \u1072 \u1089 \u1072 \u1084 \u1072 \u1091  \u1078 \u1241 \u1085 \u1077  \u1086 \u1085 \u1099  \u1073 \u1072 \u1089 \u1179 \u1072 \u1083 \u1072 \u1088 \u1171 \u1072  \u1088 \u1201 \u1179 \u1089 \u1072 \u1090  \u1077 \u1090 \u1087 \u1077 \u1091 \u1075 \u1077  \u1082 \u1077 \u1083 \u1110 \u1089 \u1077 \u1089 \u1110 \u1079 . Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085  \u1073 \u1072 \u1088 \u1083 \u1099 \u1179  \u1179 \u1086 \u1083 \u1076 \u1072 \u1085 \u1099 \u1089 \u1090 \u1072 \u1171 \u1099  \u1079 \u1072 \u1187 \u1076 \u1072 \u1088 , \u1089 \u1086 \u1085 \u1099 \u1187  \u1110 \u1096 \u1110 \u1085 \u1076 \u1077  \u1090 \u1201 \u1088 \u1171 \u1099 \u1083 \u1099 \u1179 \u1090 \u1099  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085  \u1078 \u1199 \u1082 \u1090 \u1077 \u1087  \u1072 \u1083 \u1072 \u1090 \u1099 \u1085  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1072 \u1090 \u1099 \u1085  \u1077 \u1083  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1072 \u1081 \u1084 \u1072 \u1179 \u1090 \u1099 \u1187  \u1078 \u1077 \u1088 \u1075 \u1110 \u1083 \u1110 \u1082 \u1090 \u1110  \u1079 \u1072 \u1187 \u1076 \u1072 \u1088 \u1099 \u1085 \u1072  \u1089 \u1241 \u1081 \u1082 \u1077 \u1089  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1091 \u1171 \u1072  \u1082 \u1077 \u1083 \u1110 \u1089 \u1077 \u1089 \u1110 \u1079 .\
\

\f0\b 3. \uc0\u1058 \u1072 \u1087 \u1089 \u1099 \u1088 \u1091 .
\f1\b0  Apple \uc0\u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085  \u1078 \u1072 \u1083 \u1171 \u1072  \u1073 \u1077 \u1088 \u1091 , \u1179 \u1086 \u1083 \u1076 \u1072 \u1085 \u1091 \u1171 \u1072  \u1073 \u1077 \u1088 \u1091 , \u1179 \u1072 \u1088 \u1099 \u1079 \u1171 \u1072  \u1073 \u1077 \u1088 \u1091 , \u1179 \u1086 \u1089 \u1072 \u1083 \u1179 \u1099  \u1083 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103  \u1073 \u1077 \u1088 \u1091 , \u1089 \u1072 \u1090 \u1091 , \u1090 \u1072 \u1087 \u1089 \u1099 \u1088 \u1091  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1073 \u1072 \u1089 \u1179 \u1072  \u1078 \u1086 \u1083 \u1084 \u1077 \u1085  \u1179 \u1072 \u1081 \u1090 \u1072  \u1090 \u1072 \u1088 \u1072 \u1090 \u1091  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1179 \u1086 \u1089 \u1072 \u1083 \u1179 \u1099  \u1083 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103 \u1083 \u1072 \u1091 \u1171 \u1072  \u1073 \u1086 \u1083 \u1084 \u1072 \u1081 \u1076 \u1099 .\
\

\f0\b 4. \uc0\u1178 \u1086 \u1083 \u1076 \u1072 \u1091  \u1078 \u1241 \u1085 \u1077  \u1090 \u1077 \u1093 \u1085 \u1080 \u1082 \u1072 \u1083 \u1099 \u1179  \u1179 \u1099 \u1079 \u1084 \u1077 \u1090  \u1082 \u1257 \u1088 \u1089 \u1077 \u1090 \u1091  \u1078 \u1086 \u1179 .
\f1\b0  Apple \uc0\u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1089 \u1099  Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085 \u1072  \u1090 \u1077 \u1093 \u1085 \u1080 \u1082 \u1072 \u1083 \u1099 \u1179  \u1179 \u1099 \u1079 \u1084 \u1077 \u1090  \u1082 \u1257 \u1088 \u1089 \u1077 \u1090 \u1091 , \u1090 \u1077 \u1093 \u1085 \u1080 \u1082 \u1072 \u1083 \u1099 \u1179  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1073 \u1072 \u1089 \u1179 \u1072  \u1179 \u1086 \u1083 \u1076 \u1072 \u1091  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085 \u1072  \u1179 \u1072 \u1090 \u1099 \u1089 \u1090 \u1099  \u1179 \u1072 \u1085 \u1076 \u1072 \u1081  \u1076 \u1072  \u1078 \u1072 \u1187 \u1072 \u1088 \u1090 \u1091 \u1083 \u1072 \u1088  \u1179 \u1072 \u1084 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1079  \u1077 \u1090 \u1091 \u1075 \u1077  \u1084 \u1110 \u1085 \u1076 \u1077 \u1090 \u1090 \u1110  \u1077 \u1084 \u1077 \u1089 .\

\f0\b \
5. \uc0\u1044 \u1077 \u1088 \u1077 \u1082 \u1090 \u1077 \u1088 \u1076 \u1110  \u1078 \u1080 \u1085 \u1072 \u1091  \u1078 \u1241 \u1085 \u1077  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1091  \u1082 \u1077 \u1083 \u1110 \u1089 \u1110 \u1084 \u1110 .\

\f1\b0 A. \ul \uc0\u1050 \u1077 \u1088 \u1110  \u1073 \u1072 \u1081 \u1083 \u1072 \u1085 \u1099 \u1089  \u1082 \u1257 \u1084 \u1077 \u1082 \u1096 \u1110 \u1089 \u1110  \u1179 \u1086 \u1089 \u1099 \u1084 \u1096 \u1072 \u1089 \u1099  \u1073 \u1086 \u1081 \u1099 \u1085 \u1096 \u1072  \u1072 \u1085 \u1072 \u1083 \u1080 \u1090 \u1080 \u1082 \u1072  \u1076 \u1077 \u1088 \u1077 \u1082 \u1090 \u1077 \u1088 \u1110 .\ulnone  Apple \uc0\u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085 \u1099 \u1187  (\u1050 \u1077 \u1088 \u1110  \u1073 \u1072 \u1081 \u1083 \u1072 \u1085 \u1099 \u1089  \u1082 \u1257 \u1084 \u1077 \u1082 \u1096 \u1110 \u1089 \u1110  \u1179 \u1086 \u1089 \u1099 \u1084 \u1096 \u1072 \u1089 \u1099 ) \u1072 \u1085 \u1072 \u1083 \u1080 \u1090 \u1080 \u1082 \u1072  \u1078 \u1080 \u1085 \u1072 \u1091 \u1099 \u1084 \u1077 \u1085  \u1082 \u1077 \u1083 \u1110 \u1089 \u1089 \u1077 \u1187 \u1110 \u1079 , Apple \u1257 \u1085 \u1110 \u1084 \u1076 \u1077 \u1088 \u1110  \u1084 \u1077 \u1085  \u1179 \u1099 \u1079 \u1084 \u1077 \u1090 \u1090 \u1077 \u1088 \u1110 \u1085  \u1179 \u1072 \u1084 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1079  \u1077 \u1090 \u1091  \u1078 \u1241 \u1085 \u1077  \u1078 \u1072 \u1179 \u1089 \u1072 \u1088 \u1090 \u1091 , \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072  \u1078 \u1072 \u1187 \u1072 \u1088 \u1090 \u1091 \u1083 \u1072 \u1088 \u1099 , \u1257 \u1085 \u1110 \u1084 \u1076 \u1110  \u1179 \u1086 \u1083 \u1076 \u1072 \u1091  \u1078 \u1241 \u1085 \u1077  Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085 \u1072  \u1179 \u1072 \u1090 \u1099 \u1089 \u1090 \u1099  \u1073 \u1072 \u1089 \u1179 \u1072  \u1179 \u1099 \u1079 \u1084 \u1077 \u1090 \u1090 \u1077 \u1088 \u1076 \u1110  (\u1073 \u1072 \u1088  \u1073 \u1086 \u1083 \u1089 \u1072 ) \u1201 \u1089 \u1099 \u1085 \u1091  \u1078 \u1241 \u1085 \u1077  \u1086 \u1089 \u1099  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103  \u1096 \u1072 \u1088 \u1090 \u1090 \u1072 \u1088 \u1099 \u1085 \u1072  \u1089 \u1241 \u1081 \u1082 \u1077 \u1089 \u1090 \u1110 \u1075 \u1110 \u1085  \u1090 \u1077 \u1082 \u1089 \u1077 \u1088 \u1091  \u1199 \u1096 \u1110 \u1085  \u1084 \u1077 \u1088 \u1079 \u1110 \u1084 \u1076 \u1110  \u1090 \u1199 \u1088 \u1076 \u1077  \u1078 \u1080 \u1085 \u1072 \u1083 \u1072 \u1090 \u1099 \u1085 , Apple \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1089 \u1099  \u1078 \u1241 \u1085 \u1077  \u1086 \u1085 \u1099 \u1187  \u1077 \u1085 \u1096 \u1110 \u1083 \u1077 \u1089  \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1083 \u1072 \u1088 \u1099  \u1084 \u1077 \u1085  \u1072 \u1075 \u1077 \u1085 \u1090 \u1090 \u1077 \u1088 \u1110  \u1076 \u1080 \u1072 \u1075 \u1085 \u1086 \u1089 \u1090 \u1080 \u1082 \u1072 , \u1090 \u1077 \u1093 \u1085 \u1080 \u1082 \u1072 \u1083 \u1099 \u1179 , \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1091  \u1078 \u1241 \u1085 \u1077  \u1179 \u1072 \u1090 \u1099 \u1089 \u1090 \u1099  \u1072 \u1179 \u1087 \u1072 \u1088 \u1072 \u1090 \u1090 \u1099 , \u1089 \u1086 \u1085 \u1099 \u1187  \u1110 \u1096 \u1110 \u1085 \u1076 \u1077 , \u1073 \u1110 \u1088 \u1072 \u1179  \u1086 \u1083 \u1072 \u1088 \u1084 \u1077 \u1085  \u1096 \u1077 \u1082 \u1090 \u1077 \u1083 \u1084 \u1077 \u1081 , \u1073 \u1110 \u1088 \u1077 \u1075 \u1077 \u1081  \u1078 \u1199 \u1081 \u1077  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1072 \u1087 \u1087 \u1072 \u1088 \u1072 \u1090 \u1090 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072  \u1080 \u1076 \u1077 \u1085 \u1090 \u1080 \u1092 \u1080 \u1082 \u1072 \u1090 \u1086 \u1088 \u1083 \u1072 \u1088 \u1099 , \u1179 \u1201 \u1088 \u1099 \u1083 \u1171 \u1099 , \u1082 \u1086 \u1084 \u1087 \u1100 \u1102 \u1090 \u1077 \u1088 , \u1078 \u1199 \u1081 \u1077  \u1078 \u1241 \u1085 \u1077  \u1179 \u1086 \u1089 \u1099 \u1084 \u1096 \u1072  \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 , \u1096 \u1077 \u1090 \u1082 \u1077 \u1088 \u1083 \u1110  \u1078 \u1072 \u1073 \u1076 \u1099 \u1179  \u1090 \u1091 \u1088 \u1072 \u1083 \u1099  \u1072 \u1179 \u1087 \u1072 \u1088 \u1072 \u1090 \u1090 \u1099  \u1078 \u1080 \u1085 \u1072 \u1091 \u1099 , \u1089 \u1072 \u1179 \u1090 \u1072 \u1091 \u1099 , \u1257 \u1187 \u1076 \u1077 \u1091 \u1110  \u1078 \u1241 \u1085 \u1077  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1091 \u1099  \u1084 \u1199 \u1084 \u1082 \u1110 \u1085  \u1077 \u1082 \u1077 \u1085 \u1076 \u1110 \u1075 \u1110 \u1084 \u1077 \u1085  \u1082 \u1077 \u1083 \u1110 \u1089 \u1077 \u1089 \u1110 \u1079 . Apple \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1089 \u1099  \u1073 \u1201 \u1083  \u1072 \u1179 \u1087 \u1072 \u1088 \u1072 \u1090 \u1090 \u1099  \u1078 \u1077 \u1082 \u1077  \u1073 \u1072 \u1089 \u1099 \u1187 \u1099 \u1079 \u1076 \u1099  \u1082 \u1257 \u1088 \u1089 \u1077 \u1090 \u1087 \u1077 \u1081 \u1090 \u1110 \u1085  \u1087 \u1110 \u1096 \u1110 \u1085 \u1076 \u1077  \u1078 \u1080 \u1085 \u1072 \u1179 \u1090 \u1072 \u1083 \u1171 \u1072 \u1085  \u1073 \u1086 \u1083 \u1089 \u1072 , \u1078 \u1086 \u1171 \u1072 \u1088 \u1099 \u1076 \u1072  \u1089 \u1080 \u1087 \u1072 \u1090 \u1090 \u1072 \u1083 \u1171 \u1072 \u1085  \u1084 \u1072 \u1179 \u1089 \u1072 \u1090 \u1090 \u1072 \u1088 \u1076 \u1072  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1072  \u1072 \u1083 \u1072 \u1076 \u1099 . Apple \u1089 \u1077 \u1088 \u1110 \u1082 \u1090 \u1077 \u1089 \u1090 \u1077 \u1088 \u1110  \u1084 \u1077 \u1085  \u1199 \u1096 \u1110 \u1085 \u1096 \u1110  \u1090 \u1072 \u1088 \u1072 \u1087  \u1241 \u1079 \u1110 \u1088 \u1083 \u1077 \u1091 \u1096 \u1110 \u1083 \u1077 \u1088 \u1110 \u1085 \u1077  Apple \u1257 \u1085 \u1110 \u1084 \u1076 \u1077 \u1088 \u1110 \u1084 \u1077 \u1085  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1091 \u1171 \u1072  \u1072 \u1088 \u1085 \u1072 \u1083 \u1171 \u1072 \u1085  \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 , \u1072 \u1087 \u1087 \u1072 \u1088 \u1072 \u1090 \u1090 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099  \u1078 \u1241 \u1085 \u1077  \u1179 \u1099 \u1079 \u1084 \u1077 \u1090 \u1090 \u1077 \u1088 \u1110 \u1085  \u1078 \u1072 \u1179 \u1089 \u1072 \u1088 \u1090 \u1091 \u1171 \u1072  \u1084 \u1199 \u1084 \u1082 \u1110 \u1085 \u1076 \u1110 \u1082  \u1073 \u1077 \u1088 \u1091  \u1199 \u1096 \u1110 \u1085  Apple \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1089 \u1099  \u1082 \u1077 \u1079  \u1082 \u1077 \u1083 \u1075 \u1077 \u1085  \u1086 \u1089 \u1099 \u1085 \u1076 \u1072 \u1081  \u1089 \u1077 \u1088 \u1110 \u1082 \u1090 \u1077 \u1089  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1199 \u1096 \u1110 \u1085 \u1096 \u1110  \u1090 \u1072 \u1088 \u1072 \u1087  \u1241 \u1079 \u1110 \u1088 \u1083 \u1077 \u1091 \u1096 \u1110 \u1089 \u1110 \u1085 \u1077  \u1086 \u1089 \u1099  \u1089 \u1077 \u1088 \u1110 \u1082 \u1090 \u1077 \u1089  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1241 \u1079 \u1110 \u1088 \u1083 \u1077 \u1091 \u1096 \u1110 \u1085 \u1110 \u1187  \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 , \u1072 \u1087 \u1087 \u1072 \u1088 \u1072 \u1090 \u1090 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099  \u1078 \u1241 \u1085 \u1077 /\u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1179 \u1099 \u1079 \u1084 \u1077 \u1090 \u1090 \u1077 \u1088 \u1110 \u1085 \u1077  \u1179 \u1072 \u1090 \u1099 \u1089 \u1090 \u1099 , \u1078 \u1077 \u1082 \u1077  \u1073 \u1072 \u1089 \u1099 \u1187 \u1099 \u1079 \u1076 \u1099  \u1082 \u1257 \u1088 \u1089 \u1077 \u1090 \u1087 \u1077 \u1081 \u1090 \u1110 \u1085  \u1087 \u1110 \u1096 \u1110 \u1085 \u1076 \u1077  \u1073 \u1086 \u1083 \u1089 \u1072 , \u1076 \u1080 \u1072 \u1075 \u1085 \u1086 \u1089 \u1090 \u1080 \u1082 \u1072 \u1083 \u1099 \u1179  \u1072 \u1179 \u1087 \u1072 \u1088 \u1072 \u1090  \u1078 \u1080 \u1099 \u1085 \u1099 \u1085  \u1073 \u1077 \u1088 \u1077  \u1072 \u1083 \u1072 \u1076 \u1099 .\
