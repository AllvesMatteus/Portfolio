\f0\b 7. \uc0\u1058 \u1086 \u1179 \u1090 \u1072 \u1090 \u1091 .
\f1\b0  \uc0\u1041 \u1201 \u1083  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103  \u1090 \u1086 \u1179 \u1090 \u1072 \u1090 \u1099 \u1083 \u1171 \u1072 \u1085 \u1171 \u1072  \u1076 \u1077 \u1081 \u1110 \u1085  \u1078 \u1072 \u1088 \u1072 \u1084 \u1076 \u1099 . \u1054 \u1089 \u1099  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103 \u1085 \u1099 \u1187  \u1082 \u1077 \u1079  \u1082 \u1077 \u1083 \u1075 \u1077 \u1085  \u1096 \u1072 \u1088 \u1090 \u1099 \u1085  (-\u1090 \u1072 \u1088 \u1099 \u1085 ) \u1086 \u1088 \u1099 \u1085 \u1076 \u1072 \u1084 \u1072 \u1089 \u1072 \u1187 \u1099 \u1079 , \u1086 \u1089 \u1099  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103  \u1073 \u1086 \u1081 \u1099 \u1085 \u1096 \u1072  \u1179 \u1201 \u1179 \u1099 \u1179 \u1090 \u1072 \u1088 \u1099 \u1187 \u1099 \u1079  \u1072 \u1074 \u1090 \u1086 \u1084 \u1072 \u1090 \u1090 \u1099  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1073 \u1072 \u1089 \u1179 \u1072  \u1090 \u1199 \u1088 \u1076 \u1077  Apple \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1089 \u1099 \u1085 \u1099 \u1187  \u1077 \u1089 \u1082 \u1077 \u1088 \u1090 \u1091 \u1110 \u1085 \u1089 \u1110 \u1079  \u1082 \u1199 \u1096 \u1110 \u1085  \u1090 \u1086 \u1179 \u1090 \u1072 \u1090 \u1072 \u1076 \u1099 . \u1041 \u1201 \u1171 \u1072 \u1085  \u1179 \u1086 \u1089 \u1072 , Apple \u1086 \u1087 \u1077 \u1088 \u1072 \u1094 \u1080 \u1103 \u1083 \u1099 \u1179  \u1078 \u1199 \u1081 \u1077 \u1089 \u1110 \u1085 \u1110 \u1187  \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085 \u1099 \u1187  \u1086 \u1089 \u1099  \u1085 \u1201 \u1089 \u1179 \u1072 \u1089 \u1099 \u1084 \u1077 \u1085  \u1199 \u1081 \u1083 \u1077 \u1089 \u1087 \u1077 \u1081 \u1090 \u1110 \u1085  Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085 \u1099 \u1187  \u1078 \u1072 \u1187 \u1072  \u1085 \u1201 \u1089 \u1179 \u1072 \u1089 \u1099  \u1096 \u1099 \u1171 \u1072 \u1088 \u1099 \u1083 \u1171 \u1072 \u1085  \u1078 \u1072 \u1171 \u1076 \u1072 \u1081 \u1076 \u1072 , Apple \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1089 \u1099  \u1086 \u1089 \u1099  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103 \u1085 \u1099  \u1090 \u1086 \u1179 \u1090 \u1072 \u1090 \u1091  \u1179 \u1201 \u1179 \u1099 \u1171 \u1099 \u1085 \u1072  \u1080 \u1077 . \u1054 \u1089 \u1099  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103  \u1090 \u1086 \u1179 \u1090 \u1072 \u1090 \u1099 \u1083 \u1171 \u1072 \u1085 \u1085 \u1072 \u1085  \u1082 \u1077 \u1081 \u1110 \u1085  Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1091 \u1076 \u1099  \u1090 \u1086 \u1179 \u1090 \u1072 \u1090 \u1091 \u1099 \u1187 \u1099 \u1079  \u1078 \u1241 \u1085 \u1077  Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085 \u1099 \u1187  \u1090 \u1086 \u1083 \u1099 \u1179  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1110 \u1096 \u1110 \u1085 \u1072 \u1088 \u1072  \u1073 \u1072 \u1088 \u1083 \u1099 \u1179  \u1082 \u1257 \u1096 \u1110 \u1088 \u1084 \u1077 \u1083 \u1077 \u1088 \u1110 \u1085  \u1078 \u1086 \u1102 \u1099 \u1187 \u1099 \u1079  \u1179 \u1072 \u1078 \u1077 \u1090 . \u1054 \u1089 \u1099  \u1051 \u1080 \u1094 \u1077 \u1085 \u1079 \u1080 \u1103 \u1085 \u1099 \u1187  2B, 5 (\u1073 \u1110 \u1088 \u1072 \u1179  \u1090 \u1086 \u1179 \u1090 \u1072 \u1090 \u1099 \u1083 \u1171 \u1072 \u1085 \u1171 \u1072  \u1076 \u1077 \u1081 \u1110 \u1085  \u1078 \u1080 \u1085 \u1072 \u1083 \u1171 \u1072 \u1085  \u1082 \u1257 \u1083 \u1077 \u1084 \u1076 \u1077 ), 6, 7, 8 (\u1073 \u1110 \u1088 \u1072 \u1179  \u1090 \u1086 \u1179 \u1090 \u1072 \u1090 \u1099 \u1083 \u1171 \u1072 \u1085 \u1171 \u1072  \u1076 \u1077 \u1081 \u1110 \u1085  \u1073 \u1077 \u1088 \u1110 \u1083 \u1075 \u1077 \u1085  \u1082 \u1257 \u1083 \u1077 \u1084 \u1076 \u1077  \u1171 \u1072 \u1085 \u1072 ), 9, 10, 11, 12, 14, 15 \u1078 \u1241 \u1085 \u1077  16 \u1073 \u1257 \u1083 \u1110 \u1084 \u1076 \u1077 \u1088 \u1110  \u1086 \u1089 \u1099 \u1085 \u1076 \u1072 \u1081  \u1090 \u1086 \u1179 \u1090 \u1072 \u1090 \u1091 \u1076 \u1072 \u1085  \u1090 \u1099 \u1089  \u1179 \u1072 \u1083 \u1072 \u1076 \u1099 .\
