B. \ul Apple \uc0\u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1089 \u1099 \u1085 \u1072  \u1078 \u1110 \u1073 \u1077 \u1088 \u1110 \u1083 \u1077 \u1090 \u1110 \u1085  \u1090 \u1086 \u1083 \u1099 \u1179  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088 .\ulnone  \uc0\u1054 \u1089 \u1099  Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1091  \u1072 \u1088 \u1179 \u1099 \u1083 \u1099  Apple \u1078 \u1199 \u1081 \u1077  \u1087 \u1088 \u1086 \u1092 \u1080 \u1083 \u1110  \u1077 \u1089 \u1077 \u1087 \u1090 \u1077 \u1088 \u1110 , \u1073 \u1201 \u1079 \u1099 \u1083 \u1091  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088 \u1099 , \u1072 \u1081 \u1085 \u1072 \u1083 \u1099 \u1087  \u1082 \u1077 \u1090 \u1091  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088 \u1099 , \u1090 \u1086 \u1179 \u1090 \u1072 \u1087  \u1179 \u1072 \u1083 \u1091  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088 \u1099 , \u1086 \u1088 \u1085 \u1072 \u1090 \u1091  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088 \u1099 , \u1103 \u1076 \u1088 \u1086  \u1076 \u1199 \u1088 \u1073 \u1077 \u1083 \u1077 \u1187 \u1110  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088 \u1099  \u1078 \u1241 \u1085 \u1077  \u1090 \u1086 \u1083 \u1099 \u1179  \u1078 \u1199 \u1081 \u1077  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088 \u1099 \u1084 \u1077 \u1085  (\'ab\u1058 \u1086 \u1083 \u1099 \u1179  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088 \'bb) \u1179 \u1086 \u1089 \u1072 , \u1073 \u1110 \u1088 \u1072 \u1179  \u1086 \u1083 \u1072 \u1088 \u1084 \u1077 \u1085  \u1096 \u1077 \u1082 \u1090 \u1077 \u1083 \u1084 \u1077 \u1081 , \u1078 \u1199 \u1081 \u1077 \u1076 \u1077 \u1085  \u1072 \u1179 \u1087 \u1072 \u1088 \u1072 \u1090 \u1090 \u1099  \u1072 \u1074 \u1090 \u1086 \u1084 \u1072 \u1090 \u1090 \u1099  \u1090 \u1199 \u1088 \u1076 \u1077  \u1090 \u1110 \u1088 \u1082 \u1077 \u1091  \u1086 \u1087 \u1094 \u1080 \u1103 \u1089 \u1099  \u1073 \u1086 \u1083 \u1072 \u1076 \u1099 . \u1045 \u1075 \u1077 \u1088  Apple \u1073 \u1072 \u1171 \u1076 \u1072 \u1088 \u1083 \u1072 \u1084 \u1072 \u1083 \u1099 \u1179  \u1078 \u1072 \u1089 \u1072 \u1179 \u1090 \u1072 \u1084 \u1072 \u1089 \u1099 \u1085  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1099 \u1087  Apple \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1089 \u1099 \u1085 \u1072  \u1179 \u1072 \u1085 \u1076 \u1072 \u1081  \u1073 \u1086 \u1083 \u1089 \u1072  \u1076 \u1072  \u1090 \u1086 \u1083 \u1099 \u1179  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088  \u1078 \u1110 \u1073 \u1077 \u1088 \u1091 \u1076 \u1110  \u1090 \u1072 \u1187 \u1076 \u1072 \u1089 \u1072 \u1187 \u1099 \u1079 , \u1078 \u1110 \u1073 \u1077 \u1088 \u1110 \u1083 \u1110 \u1084 \u1075 \u1077  \u1072 \u1090 \u1099 -\u1078 \u1257 \u1085 \u1110 \u1187 \u1110 \u1079  \u1078 \u1241 \u1085 \u1077  \u1101 \u1083 \u1077 \u1082 \u1090 \u1088 \u1086 \u1085 \u1076 \u1099 \u1179  \u1087 \u1086 \u1096 \u1090 \u1072 \u1187 \u1099 \u1079 \u1076 \u1099 \u1187  \u1084 \u1077 \u1082 \u1077 \u1085 \u1078 \u1072 \u1081 \u1099  \u1179 \u1086 \u1089 \u1099 \u1083 \u1072 \u1076 \u1099  \u1078 \u1241 \u1085 \u1077  \u1090 \u1110 \u1088 \u1082 \u1077 \u1083 \u1075 \u1077 \u1085  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088  \u1089 \u1241 \u1081 \u1082 \u1077 \u1089 \u1090 \u1077 \u1085 \u1076 \u1110 \u1088 \u1077 \u1090 \u1110 \u1085  \u1078 \u1077 \u1082 \u1077  \u1072 \u1179 \u1087 \u1072 \u1088 \u1072 \u1090 \u1090 \u1099 , \u1089 \u1086 \u1085 \u1099 \u1187  \u1110 \u1096 \u1110 \u1085 \u1076 \u1077 , \u1096 \u1077 \u1082 \u1090 \u1077 \u1091 \u1089 \u1110 \u1079 , \u1072 \u1082 \u1082 \u1072 \u1091 \u1085 \u1090  \u1072 \u1090 \u1072 \u1091 \u1099 , \u1082 \u1086 \u1085 \u1090 \u1072 \u1082 \u1090 \u1110 \u1083 \u1077 \u1088 , \u1082 \u1199 \u1085 \u1090 \u1110 \u1079 \u1073 \u1077  \u1110 \u1089 -\u1096 \u1072 \u1088 \u1072 \u1083 \u1072 \u1088 \u1099  \u1078 \u1241 \u1085 \u1077  \u1101 \u1083 \u1077 \u1082 \u1090 \u1088 \u1086 \u1085 \u1076 \u1099 \u1179  \u1087 \u1086 \u1096 \u1090 \u1072  \u1093 \u1072 \u1090 \u1090 \u1072 \u1088 \u1099 \u1085 \u1072  \u1179 \u1072 \u1090 \u1099 \u1089 \u1090 \u1099  \u1072 \u1179 \u1087 \u1072 \u1088 \u1072 \u1090 \u1090 \u1099  \u1179 \u1072 \u1084 \u1090 \u1091 \u1099  \u1084 \u1199 \u1084 \u1082 \u1110 \u1085 . \u1041 \u1201 \u1085 \u1076 \u1072 \u1081  \u1090 \u1086 \u1083 \u1099 \u1179  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1076 \u1072 \u1088 \u1076 \u1099  \u1201 \u1089 \u1099 \u1085 \u1091  \u1077 \u1088 \u1110 \u1082 \u1090 \u1110 , \u1073 \u1110 \u1088 \u1072 \u1179  \u1201 \u1089 \u1099 \u1085 \u1091  \u1257 \u1079 \u1110 \u1187 \u1110 \u1079  \u1090 \u1072 \u1187 \u1076 \u1072 \u1171 \u1072 \u1085  \u1076 \u1241 \u1088 \u1077 \u1078 \u1077 \u1076 \u1077 , Apple \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1089 \u1099  \u1086 \u1083 \u1072 \u1088 \u1076 \u1099  \u1076 \u1080 \u1072 \u1075 \u1085 \u1086 \u1089 \u1090 \u1080 \u1082 \u1072 \u1083 \u1099 \u1179  \u1084 \u1072 \u1179 \u1089 \u1072 \u1090 \u1090 \u1072 \u1088  \u1078 \u1241 \u1085 \u1077  \u1257 \u1085 \u1110 \u1084  \u1085 \u1077 \u1084 \u1077 \u1089 \u1077  \u1179 \u1099 \u1079 \u1084 \u1077 \u1090 \u1090 \u1110  \u1078 \u1072 \u1179 \u1089 \u1072 \u1088 \u1090 \u1091  \u1199 \u1096 \u1110 \u1085  \u1087 \u1072 \u1081 \u1076 \u1072 \u1083 \u1072 \u1085 \u1072  \u1072 \u1083 \u1072 \u1090 \u1099 \u1085 \u1099 \u1085  \u1088 \u1072 \u1089 \u1090 \u1072 \u1081 \u1089 \u1099 \u1079  \u1078 \u1241 \u1085 \u1077  \u1082 \u1077 \u1083 \u1110 \u1089 \u1077 \u1089 \u1110 \u1079 . Apple \u1082 \u1086 \u1084 \u1087 \u1072 \u1085 \u1080 \u1103 \u1089 \u1099  \u1073 \u1201 \u1083