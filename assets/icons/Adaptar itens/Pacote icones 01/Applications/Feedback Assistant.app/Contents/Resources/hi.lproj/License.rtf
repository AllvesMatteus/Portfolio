\f0\b 12. \uc0\u2325 \u2379 \u2312  \u2349 \u2368  \u2331 \u2370 \u2335  \u2351 \u2366  \u2309 \u2360 \u2366 \u2311 \u2344 \u2350 \u2375 \u2306 \u2335  \u2344 \u2361 \u2368 \u2306 \u2404 
\f1\b0  \uc0\u2311 \u2360  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2325 \u2375  \u2309 \u2306 \u2340 \u2352 \u2381 \u2327 \u2340  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2342 \u2375 \u2352 \u2368  \u2351 \u2366  \u2357 \u2367 \u2347 \u2354 \u2340 \u2366  \u2360 \u2375  \u2311 \u2360 \u2325 \u2375  \u2346 \u2381 \u2352 \u2366 \u2357 \u2343 \u2366 \u2344 \u2379 \u2306  \u2350 \u2375 \u2306  \u2325 \u2379 \u2312  \u2331 \u2370 \u2335  \u2344 \u2361 \u2368 \u2306  \u2350 \u2367 \u2354 \u2375 \u2327 \u2368 , \u2332 \u2348  \u2340 \u2325  \u2325 \u2367  \u2320 \u2360 \u2366  Apple \u2325 \u2375  \u2313 \u2346 \u2351 \u2369 \u2325 \u2381 \u2340  \u2309 \u2343 \u2367 \u2325 \u2371 \u2340  \u2346 \u2381 \u2352 \u2340 \u2367 \u2344 \u2367 \u2343 \u2367  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2360 \u2381 \u2346 \u2359 \u2381 \u2335  \u2352 \u2370 \u2346  \u2360 \u2375  \u2354 \u2367 \u2326 \u2367 \u2340 , \u2361 \u2360 \u2381 \u2340 \u2366 \u2325 \u2381 \u2359 \u2352 \u2367 \u2340  \u2344  \u2361 \u2379 , \u2324 \u2352  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2319 \u2325 \u2354  \u2331 \u2370 \u2335  \u2360 \u2375  \u2344 \u2367 \u2352 \u2306 \u2340 \u2352  \u2351 \u2366  \u2348 \u2366 \u2342  \u2350 \u2375 \u2306  \u2350 \u2367 \u2354 \u2344 \u2375  \u2357 \u2366 \u2354 \u2368  \u2325 \u2379 \u2312  \u2331 \u2370 \u2335  \u2344 \u2367 \u2352 \u2381 \u2350 \u2367 \u2340  \u2344 \u2361 \u2368 \u2306  \u2361 \u2379 \u2327 \u2368 \u2404  \u2310 \u2346  Apple \u2325 \u2368  \u2346 \u2370 \u2352 \u2381 \u2357  \u2354 \u2367 \u2326 \u2367 \u2340  \u2360 \u2381 \u2357 \u2368 \u2325 \u2371 \u2340 \u2367  \u2325 \u2375  \u2348 \u2367 \u2344 \u2366  \u2311 \u2360  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2325 \u2379 , \u2346 \u2370 \u2352 \u2368  \u2340 \u2352 \u2361  \u2351 \u2366  \u2310 \u2306 \u2358 \u2367 \u2325  \u2352 \u2370 \u2346  \u2360 \u2375  \u2309 \u2360 \u2366 \u2311 \u2344  \u2344 \u2361 \u2368 \u2306  \u2325 \u2352  \u2360 \u2325