C. \ul Apple \uc0\u2325 \u2379  \u2360 \u2348 \u2350 \u2367 \u2335  \u2325 \u2368  \u2327 \u2312  \u2360 \u2367 \u2360 \u2381 \u2335 \u2350  \u2357 \u2367 \u2358 \u2375 \u2359 \u2340 \u2366 \u2319 \u2306 \ulnone \uc0\u2404  \u2311 \u2360 \u2325 \u2375  \u2309 \u2354 \u2366 \u2357 \u2366 , Apple \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2350 \u2375 \u2306  \u2351 \u2361  \u2357 \u2367 \u2358 \u2375 \u2359 \u2340 \u2366  \u2361 \u2379  \u2360 \u2325 \u2340 \u2368  \u2361 \u2376 , \u2325 \u2367  \u2357 \u2361  \u2310 \u2346 \u2325 \u2375  \u2360 \u2367 \u2360 \u2381 \u2335 \u2350  \u2360 \u2375  \u2325 \u2369 \u2331  \u2357 \u2367 \u2358 \u2375 \u2359  \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2319 \u2346 \u2381 \u2354 \u2367 \u2325 \u2375 \u2358 \u2344  \u2325 \u2368  \u2360 \u2370 \u2330 \u2368 , \u2357 \u2367 \u2358 \u2375 \u2359 \u2340 \u2366 \u2323 \u2306  \u2324 \u2352  \u2325 \u2366 \u2352 \u2381 \u2351 \u2366 \u2340 \u2381 \u2350 \u2325 \u2340 \u2366  \u2325 \u2379  \u2324 \u2352  \u2360 \u2366 \u2341  \u2361 \u2368  \u2320 \u2360 \u2375  \u2319 \u2346 \u2381 \u2354 \u2367 \u2325 \u2375 \u2358 \u2344 , \u2357 \u2367 \u2358 \u2375 \u2359 \u2340 \u2366 \u2323 \u2306  \u2324 \u2352  \u2325 \u2366 \u2352 \u2381 \u2351 \u2366 \u2340 \u2381 \u2350 \u2325 \u2340 \u2366  (\'d2\u2357 \u2367 \u2358 \u2375 \u2359 \u2340 \u2366 \u2319 \u2306 \'d3) \u2325 \u2375  \u2348 \u2366 \u2352 \u2375  \u2350 \u2375 \u2306  \u2313 \u2346 \u2351 \u2379 \u2327  \u2360 \u2306 \u2348 \u2306 \u2343 \u2368  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2325 \u2379  \u2325 \u2306 \u2346 \u2366 \u2311 \u2354  \u2325 \u2352  \u2360 \u2325 \u2340 \u2368  \u2361 \u2376 \u2404  \u2351 \u2361  \u2360 \u2370 \u2330 \u2368  Apple \u2325 \u2379  \u2340 \u2348  \u2340 \u2325  \u2344 \u2361 \u2368 \u2306  \u2349 \u2375 \u2332 \u2368  \u2332 \u2366 \u2340 \u2368  \u2361 \u2376 , \u2332 \u2348  \u2340 \u2325  \u2325 \u2367  \u2310 \u2346  \u2311 \u236