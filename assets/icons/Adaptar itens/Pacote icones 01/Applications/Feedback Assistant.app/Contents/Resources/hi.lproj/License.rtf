\

\f0\b 7. \uc0\u2360 \u2350 \u2366 \u2346 \u2381 \u2340 \u2367 \u2404 
\f1\b0  \uc0\u2351 \u2361  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2311 \u2360 \u2325 \u2375  \u2360 \u2350 \u2366 \u2346 \u2381 \u2340  \u2361 \u2379 \u2344 \u2375  \u2340 \u2325  \u2346 \u2381 \u2352 \u2349 \u2366 \u2357 \u2368  \u2352 \u2361 \u2375 \u2327 \u2366 \u2404  \u2309 \u2327 \u2352  \u2310 \u2346  \u2311 \u2360  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2325 \u2375  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2344 \u2367 \u2351 \u2350  \u2325 \u2366  \u2346 \u2366 \u2354 \u2344  \u2325 \u2352 \u2344 \u2375  \u2350 \u2375 \u2306  \u2309 \u2360 \u2347 \u2354  \u2352 \u2361 \u2340 \u2375  \u2361 \u2376 \u2306  \u2340 \u2379  \u2311 \u2360  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2325 \u2375  \u2340 \u2361 \u2340  \u2310 \u2346 \u2325 \u2375  \u2309 \u2343 \u2367 \u2325 \u2366 \u2352  \u2360 \u2381 \u2357 \u2340 \u2307  \u2360 \u2350 \u2366 \u2346 \u2381 \u2340  \u2361 \u2379  \u2332 \u2366 \u2319 \u2305 \u2327 \u2375  \u2351 \u2366  \u2309 \u2344 \u2381 \u2351 \u2341 \u2366  Apple \u2325 \u2368  \u2323 \u2352  \u2360 \u2375  \u2348 \u2367 \u2344 \u2366  \u2325 \u2367 \u2360 \u2368  \u2344 \u2379 \u2335 \u2367 \u2360  \u2325 \u2375  \u2346 \u2381 \u2352 \u2349 \u2366 \u2357 \u2368  \u2344 \u2361 \u2368 \u2306  \u2352 \u2361 \u2375 \u2306 \u2327 \u2375 \u2404  \u2311 \u2360 \u2325 \u2375  \u2309 \u2354 \u2366 \u2357 \u2366 , \u2309 \u2327 \u2352  Apple \u2325 \u2375  \u2321 \u2346 \u2352 \u2375 \u2335 \u2367 \u2306 \u2327  \u2360 \u2367 \u2360 \u2381 \u2335 \u2350  \u2325 \u2366  \u2344 \u2351 \u2366  \u2360 \u2306 \u2360 \u2381 \u2325 \u2352 \u2339  \u2351 \u2366  \u2320 \u2360 \u2366  Apple \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2352 \u2367 \u2354 \u2368 \u2395  \u2361 \u2379 \u2340 \u2366  \u2361 \u2376 , \u2332 \u2379  Apple \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2375  \u2311 \u2360  \u2360 \u2306 \u2360 \u2381 \u2325 \u2352 \u2339  \u2325 \u2375  \u2360 \u2366 \u2341  \u2360 \u2369 \u2360 \u2306 \u2327 \u2340  \u2344 \u2361 \u2368 \u2306  \u2361 \u2376 , \u2340 \u2379  Apple \u2325 \u2375  \u2346 \u2366 \u2360  \u2311 \u2360  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2325 \u2379  \u2360 \u2350 \u2366 \u2346 \u2381 \u2340  \u2325 \u2352 \u2344 \u2375  \u2325 \u2366  \u2309 \u2343 \u2367 \u2325 \u2366 \u2352  \u2360 \u2369 \u2352 \u2325 \u2381 \u2359 \u2367 \u2340  \u2361 \u2376 \u2404  \u2311 \u2360  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2325 \u2375  \u2360 \u2350 \u2366 \u2346 \u2381 \u2340  \u2361 \u2379  \u2332 \u2366 \u2344 \u2375  \u2325 \u2375  \u2348 \u2366 \u2342 , \u2310 \u2346  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2366  \u2313 \u2346 \u2351 \u2379 \u2327  \u2346 \u2370 \u2352 \u2368  \u2340 \u2352 \u2361  \u2360 \u2375  \u2348 \u2306 \u2342  \u2325 \u2352  \u2342 \u2375 \u2306 \u2327 \u2375  \u2324 \u2352  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2368  \u2346 \u2370 \u2352 \u2381 \u2339  \u2351 \u2366  \u2310 \u2306 \u2358 \u2367 \u2325 , \u2360 \u2349 \u2368  \u2325 \u2377 \u2346 \u2368  \u2325 \u2379  \u2344 \u2359 \u2381 \u2335  \u2325 \u2352  \u2342 \u2375 \u2306 \u2327 \u2375 \u2404  \u2311 \u2360  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2325 \u2375  \u2360 \u2375 \u2325 \u2381 \u2358 \u2344  2B, 5 (\u2354 \u2375 \u2325 \u2367 \u2344  \u2311 \u2360 \u2325 \u2368  \u2360 \u2350 \u2366 \u2346 \u2381 \u2340 \u2367  \u2325 \u2375  \u2346 \u2361 \u2354 \u2375  \u2325 \u2368  \u2360 \u2368 \u2350 \u2366  \u2340 \u2325  \u2361 \u2368 ), 6, 7, 8 (\u2354 \u2375 \u2325 \u2367 \u2344  \u2311 \u2360 \u2325 \u2368  \u2360 \u2350 \u2366 \u2346 \u2381 \u2340 \u2367  \u2325 \u2375  \u2346 \u2361 \u2354 \u2375  \u2348 \u2340 \u2366 \u2312  \u2327 \u2312  \u2360 \u2368 \u2350 \u2366  \u2340 \u2325  \u2361 \u2368 ), 9, 10, 11, 12, 14, 15, \u2324 \u2352  16 \u2320 \u2360 \u2368  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2360 \u2350 \u2366 \u2346 \u2381 \u2340 \u2367  \u2325 \u2375  \u2348 \u2366 \u2342  \u2349 \u2368  \u2348 \u2344 \u2375  \u2352 \u2361 \u2375 \u2306 \u2327 \u2375 \u2404 \
\

\f0\b 8. \uc0\u2398 \u2368 \u2337 \u2348 \u2376 \u2325 \u2404 
\f1\b0  Apple \uc0\u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2310 \u2346 \u2325 \u2379  \u2310 \u2346 \u2325 \u2375  \u2360 \u2367 \u2360 \u2381 \u2335 \u2350  \u2351 \u2366  Apple \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2375  \u2348 \u2366 \u2352 \u2375  \u2350 \u2375 \u2306  \u2348 \u2327  \u2352 \u2367 \u2346 \u2379 \u2352 \u2381 \u2335 , \u2346 \u2381 \u2352 \u2358 \u2381 \u2344 \u2366 \u2357 \u2354 \u2367 \u2351 \u2366 \u2306 , \u2313 \u2344 \u2381 \u2344 \u2340  \u2309 \u2344 \u2369 \u2352 \u2379 \u2343 , \u2360 \u2350 \u2360 \u2381 \u2351 \u2366  \u2325 \u2368  \u2352 \u2367 \u2346 \u2379 \u2352 \u2381 \u2335  \u2324 \u2352 /\u2351 \u2366  \u2360 \u2346 \u2379 \u2352 \u2381 \u2335  \u2360 \u2306 \u2348 \u2306 \u2343 \u2368  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  (\u2360 \u2366 \u2350 \u2370 \u2361 \u2367 \u2325  \u2352 \u2370 \u2346  \u2360 \u2375 , \'d2\u2398 \u2368 \u2337 \u2348 \u2376 \u2325 \'d3) Apple \u2325 \u2379  \u2342 \u2375 \u2344 \u2375  \u2325 \u2366  \u2350 \u2380 \u2325 \u2366  \u2342 \u2375 \u2327 \u2366 \u2404  \u2360 \u2375 \u2325 \u2381 \u2358 \u2344  5 \u2350 \u2375 \u2306  \u2309 \u2344 \u2381 \u2351 \u2341 \u2366  \u2325 \u2361 \u2375  \u2327 \u2319  \u2325 \u2379  \u2331 \u2379 \u2396  \u2325 \u2352 , \u2310 \u2346  \u2311 \u2360  \u2348 \u2366 \u2340  \u2360 \u2375  \u2360 \u2361 \u2350 \u2340  \u2361 \u2379 \u2340 \u2375  \u2361 \u2376 \u2306  \u2325 \u2367  \u2311 \u2360 \u2325 \u2375  \u2357 \u2367 \u2346 \u2352 \u2368 \u2340  \u2325 \u2379 \u2312  \u2309 \u2354 \u2327  \u2354 \u2367 \u2326 \u2367 \u2340  \u2360 \u2350 \u2333 \u2380 \u2340 \u2375  \u2325 \u2368  \u2309 \u2344 \u2369 \u2346 \u2360 \u2381 \u2341 \u2367 \u2340 \u2367  \u2350 \u2375 \u2306  Apple \u2310 \u2346 \u2325 \u2375  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2313 \u2342 \u2381 \u2342 \u2375 \u2358 \u2381 \u2351  \u2325 \u2375  \u2354 \u2367 \u2319  \u2342 \u2367 \u2319  \u2327 \u2319  \u2398 \u2368 \u2337 \u2348 \u2376 \u2325  \u2325 \u2366  \u2313 \u2346 \u2351 \u2379 \u2327  \u2325 \u2352 \u2344 \u2375  \u2325 \u2375  \u2354 \u2367 \u2319  \u2360 \u2381 \u2357 \u2340 \u2306 \u2340 \u2381 \u2352  \u2361 \u2379 \u2327 \u2366 \u2404  \u2310 \u2346  Apple \u2325 \u2379  \u2351 \u2361  \u2349 \u2368  \u2342 \u2352 \u2381 \u2358 \u2366 \u2340 \u2375  \u2361 \u2376 \u2306  \u2325 \u2367  \u2310 \u2346 \u2325 \u2375  \u2346 \u2366 \u2360  Apple \u2325 \u2379  \u2398 \u2368 \u2337 \u2348 \u2376 \u2325  \u2342 \u2375 \u2344 \u2375  \u2324 \u2352  \u2313 \u2346 \u2352 \u2379 \u2325 \u2381 \u2340  \u2309 \u2343 \u2367 \u2325 \u2366 \u2352  \u2342 \u2375 \u2344 \u2375  \u2325 \u2375  \u2360 \u2349 \u2368  \u2310 \u2357 \u2358 \u2381 \u2351 \u2325  \u2309 \u2343 \u2367 \u2325 \u2366 \u2352  \u2350 \u2380 \u2332 \u2370 \u2342  \u2361 \u2376 \u2306 \u2404 \
\

\f0\b 9. \uc0\u2357 \u2366 \u2352 \u2306 \u2335 \u2367 \u2351 \u2379 \u2306  \u2325 \u2366  \u2309 \u2360 \u2381 \u2357 \u2368 \u2325 \u2352 \u2339 \u2404  \

\f1\b0 A. \uc0\u2310 \u2346  \u2360 \u2381 \u2346 \u2359 \u2381 \u2335  \u2352 \u2370 \u2346  \u2360 \u2375  \u2360 \u2381 \u2357 \u2368 \u2325 \u2366 \u2352  \u2325 \u2352 \u2340 \u2375  \u2361 \u2376 \u2306  \u2324 \u2352  \u2360 \u2361 \u2350 \u2340  \u2361 \u2379 \u2340 \u2375  \u2361 \u2376 \u2306  \u2325 \u2367 , \u2354 \u2366 \u2327 \u2370  \u2325 \u2366 \u2344 \u2370 \u2344  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2309 \u2344 \u2369 \u2350 \u2340  \u2360 \u2368 \u2350 \u2366  \u2340 \u2325 , Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2366  \u2313 \u2346 \u2351 \u2379 \u2327  \u2310 \u2346 \u2325 \u2375  \u2319 \u2325 \u2350 \u2366 \u2340 \u2381 \u2352  \u2332 \u2379 \u2326 \u2367 \u2350  \u2346 \u2352  \u2361 \u2376  \u2324 \u2352  \u2360 \u2306 \u2340 \u2379 \u2359 \u2332 \u2344 \u2325  \u2327 \u2369 \u2339 \u2357 \u2340 \u2381 \u2340 \u2366 , \u2346 \u2381 \u2352 \u2342 \u2352 \u2381 \u2358 \u2344 , \u2360 \u2335 \u2368 \u2325 \u2340 \u2366  \u2324 \u2352  \u2346 \u2381 \u2352 \u2351 \u2366 \u2360  \u2360 \u2375  \u2360 \u2306 \u2348 \u2306 \u2343 \u2367 \u2340  \u2360 \u2306 \u2346 \u2370 \u2352 \u2381 \u2339  \u2332 \u2379 \u2326 \u2367 \u2350  \u2310 \u2346 \u2325 \u2366  \u2361 \u2376 \u2404  \
\
B. \uc0\u2354 \u2366 \u2327 \u2370  \u2325 \u2366 \u2344 \u2370 \u2344  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2309 \u2344 \u2369 \u2350 \u2340  \u2309 \u2343 \u2367 \u2325 \u2340 \u2350  \u2360 \u2368 \u2350 \u2366  \u2340 \u2325 , Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \'d2\u2332 \u2376 \u2360 \u2366  \u2361 \u2376 \'d3 \u2324 \u2352  \'d2\u2332 \u2376 \u2360 \u2375  \u2313 \u2346 \u2354 \u2348 \u2381 \u2343  \u2361 \u2376 \'d3 \u2325 \u2375  \u2352 \u2370 \u2346  \u2350 \u2375 \u2306 , \u2360 \u2349 \u2368  \u2342 \u2379 \u2359 \u2379 \u2306  \u2325 \u2375  \u2360 \u2366 \u2341  \u2324 \u2352  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2346 \u2381 \u2352 \u2325 \u2366 \u2352  \u2325 \u2368  \u2357 \u2366 \u2352 \u2306 \u2335 \u2368  \u2325 \u2375  \u2348 \u2367 \u2344 \u2366  \u2346 \u2381 \u2352 \u2342 \u2366 \u2344  \u2325 \u2367 \u2351 \u2366  \u2332 \u2366 \u2340 \u2366  \u2361 \u2376  \u2324 \u2352  Apple \u2340 \u2341 \u2366  Apple \u2325 \u2375  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360 \u2325 \u2352 \u2381 \u2340 \u2366  (\u2360 \u2366 \u2350 \u2370 \u2361 \u2367 \u2325  \u2352 \u2370 \u2346  \u2360 \u2375  \u2360 \u2375 \u2325 \u2381 \u2358 \u2344  9 \u2324 \u2352  10 \u2325 \u2375  \u2346 \u2381 \u2352 \u2351 \u2379 \u2332 \u2344 \u2379 \u2306  \u2325 \u2375  \u2354 \u2367 \u2319  \'d2Apple\'d3 \u2325 \u2375  \u2352 \u2370 \u2346  \u2350 \u2375 \u2306  \u2360 \u2306 \u2342 \u2352 \u2381 \u2349 \u2367 \u2340 ) Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2324 \u2352  \u2360 \u2375 \u2357 \u2366 \u2323 \u2306  \u2325 \u2375  \u2360 \u2306 \u2348 \u2306 \u2343  \u2350 \u2375 \u2306  \u2360 \u2349 \u2368  \u2357 \u2366 \u2352 \u2306 \u2335 \u2368  \u2324 \u2352  \u2358 \u2352 \u2381 \u2340 \u2379 \u2306  \u2325 \u2379  \u2309 \u2360 \u2381 \u2357 \u2368 \u2325 \u2366 \u2352  \u2325 \u2352 \u2340 \u2375  \u2361 \u2376 \u2306 , \u2330 \u2366 \u2361 \u2375  \u2357 \u2375  \u2360 \u2381 \u2346 \u2359 \u2381 \u2335 , \u2344 \u2367 \u2361 \u2367 \u2340  \u2351 \u2366  \u2357 \u2376 \u2343 \u2366 \u2344 \u2367 \u2325  \u2361 \u2379 \u2306 , \u2332 \u2367 \u2360 \u2350 \u2375 \u2306  \u2344 \u2367 \u2361 \u2367 \u2340  \u2357 \u2366 \u2352 \u2306 \u2335 \u2368  \u2324 \u2352 /\u2351 \u2366  \u2357 \u2381 \u2351 \u2366 \u2346 \u2366 \u2352 \u2367 \u2325 \u2340 \u2366 , \u2360 \u2306 \u2340 \u2379 \u2359 \u2332 \u2344 \u2325  \u2327 \u2369 \u2339 \u2357 \u2340 \u2381 \u2340 \u2366 , \u2325 \u2367 \u2360 \u2368  \u2357 \u2367 \u2358 \u2375 \u2359  \u2313 \u2342 \u2381 \u2342 \u2375 \u2358 \u2381 \u2351  \u2325 \u2375  \u2354 \u2367 \u2319  \u2313 \u2346 \u2351 \u2369 \u2325 \u2381 \u2340 \u2340 \u2366 , \u2360 \u2335 \u2368 \u2325 \u2340 \u2366 , \u2358 \u2366 \u2306 \u2340 \u2367 \u2346 \u2370 \u2352 \u2381 \u2339  \u2310 \u2344 \u2306 \u2342  \u2324 \u2352  \u2340 \u2368 \u2360 \u2352 \u2375  \u2346 \u2325 \u2381 \u2359  \u2325 \u2375  \u2309 \u2343 \u2367 \u2325 \u2366 \u2352 \u2379 \u2306  \u2325 \u2375  \u2327 \u2376 \u2352 -\u2313 \u2354 \u2381 \u2354 \u2306 \u2328 \u2344  \u2325 \u2368  \u2358 \u2352 \u2381 \u2340 \u2375 \u2306  \u2358 \u2366 \u2350 \u2367 \u2354  \u2361 \u2376 \u2306 , \u2354 \u2375 \u2325 \u2367 \u2344  \u2311 \u2344 \u2381 \u2361 \u2368 \u2306  \u2340 \u2325  \u2360 \u2368 \u2350 \u2367 \u2340  \u2344 \u2361 \u2368 \u2306  \u2361 \u2376 \u2306 \u2404  \
\
C. Apple \uc0\u2310 \u2346 \u2325 \u2375  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2375  \u2310 \u2344 \u2306 \u2342  \u2350 \u2375 \u2306  \u2361 \u2360 \u2381 \u2340 \u2325 \u2381 \u2359 \u2375 \u2346  \u2325 \u2375  \u2354 \u2367 \u2319  \u2357 \u2366 \u2352 \u2306 \u2335 \u2368  \u2344 \u2361 \u2368 \u2306  \u2342 \u2375 \u2340 \u2366  \u2361 \u2376 , \u2360 \u2366 \u2341  \u2361 \u2368  \u2320 \u2360 \u2368  \u2325 \u2379 \u2312  \u2357 \u2366 \u2352 \u2306 \u2335 \u2368  \u2344 \u2361 \u2368 \u2306  \u2342 \u2368  \u2332 \u2366 \u2340 \u2368  \u2361 \u2376  \u2325 \u2367  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2350 \u2375 \u2306  \u2344 \u2367 \u2361 \u2367 \u2340  \u2325 \u2366 \u2352 \u2381 \u2351  \u2310 \u2346 \u2325 \u2368  \u2310 \u2357 \u2358 \u2381 \u2351 \u2325 \u2340 \u2366 \u2323 \u2306  \u2325 \u2379  \u2346 \u2370 \u2352 \u2366  \u2325 \u2352 \u2375 \u2306 \u2327 \u2375 , \u2325 \u2367  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2366  \u2360 \u2306 \u2330 \u2366 \u2354 \u2344  \u2344 \u2367 \u2352 \u2381 \u2348 \u2366 \u2343  \u2351 \u2366  \u2340 \u2381 \u2352 \u2369 \u2335 \u2367 -\u2352 \u2361 \u2367 \u2340  \u2361 \u2379 \u2327 \u2366 , \u2325 \u2367  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2340 \u2368 \u2360 \u2352 \u2375  \u2346 \u2325 \u2381 \u2359  \u2325 \u2375  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352 , \u2319 \u2346 \u2381 \u2354 \u2367 \u2325 \u2375 \u2358 \u2344  \u2351 \u2366  \u2340 \u2368 \u2360 \u2352 \u2375  \u2346 \u2325 \u2381 \u2359  \u2325 \u2368  \u2360 \u2375 \u2357 \u2366 \u2323 \u2306  \u2325 \u2375  \u2360 \u2366 \u2341  \u2360 \u2306 \u2327 \u2340  \u2361 \u2379 \u2327 \u2366  \u2351 \u2366  \u2325 \u2366 \u2350  \u2325 \u2352 \u2375 \u2327 \u2366  \u2351 \u2366  \u2325 \u2367  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2350 \u2375 \u2306  \u2342 \u2379 \u2359 \u2379 \u2306  \u2325 \u2379  \u2336 \u2368 \u2325  \u2325 \u2367 \u2351 \u2366  \u2332 \u2366 \u2319 \u2327 \u2366 \u2404  \u2311 \u2360  APPLE \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2379  \u2311 \u2306 \u2360 \u2381 \u2335 \u2377 \u2354  \u2325 \u2352 \u2344 \u2375  \u2346 \u2352  \u2340 \u2368 \u2360 \u2352 \u2375  \u2346 \u2325 \u2381 \u2359  \u2325 \u2375  \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352 , \u2320 \u2346 \u2381 \u2354 \u2367 \u2325 \u2375 \u2358 \u2344  \u2351 \u2366  \u2340 \u2368 \u2360 \u2352 \u2375  \u2346 \u2325 \u2381 \u2359  \u2325 \u2368  \u2360 \u2375 \u2357 \u2366 \u2323 \u2306  \u2360 \u2366 \u2341  \u2361 \u2368  APPLE \u2346 \u2381 \u2352 \u2379 \u2337 \u2325 \u2381 \u2335  \u2324 \u2352  \u2360 \u2375 \u2357 \u2366 \u2323 \u2306  \u2325 \u2368  \u2313 \u2346 \u2354 \u2348 \u2381 \u2343 \u2340 \u2366  \u2324 \u2352  \u2313 \u2346 \u2351 \u2379 \u2327 \u2367 \u2340 \u2366  \u2346 \u2381 \u2352 \u2349 \u2366 \u2357 \u2367 \u2340  \u2361 \u2379  \u2360 \u2325 \u2340 \u2368  \u2361 \u2376 \u2404  \
\
D. \uc0\u2311 \u2360 \u2325 \u2375  \u2309 \u2354 \u2366 \u2357 \u2366  \u2310 \u2346  \u2351 \u2361  \u2349 \u2368  \u2360 \u2381 \u2357 \u2368 \u2325 \u2366 \u2352  \u2325 \u2352 \u2340 \u2375  \u2361 \u2376 \u2306  \u2325 \u2367  APPLE \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2379  \u2320 \u2360 \u2368  \u2346 \u2352 \u2367 \u2360 \u2381 \u2341 \u2367 \u2340 \u2367 \u2351 \u2379 \u2306  \u2351 \u2366  \u2346 \u2352 \u2367 \u2357 \u2375 \u2358  \u2325 \u2375  \u2313 \u2342 \u2381 \u2342 \u2375 \u2358 \u2381 \u2351  \u2360 \u2375  \u2344 \u2361 \u2368 \u2306  \u2348 \u2344 \u2366 \u2351 \u2366  \u2327 \u2351 \u2366  \u2361 \u2376  \u2332 \u2361 \u2366 \u2305  \u2357 \u2367 \u2347 \u2354 \u2340 \u2366  \u2351 \u2366  \u2360 \u2350 \u2351  \u2350 \u2375 \u2306  \u2357 \u2367 \u2354 \u2306 \u2348  \u2351 \u2366  \u2340 \u2381 \u2352 \u2369 \u2335 \u2367 \u2351 \u2366 \u2305  \u2351 \u2366  \u2346 \u2369 \u2344 \u2352 \u2366 \u2357 \u2371 \u2340 \u2381 \u2340 \u2367 \u2351 \u2379 \u2306  \u2350 \u2375 \u2306  APPLE \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2346 \u2381 \u2352 \u2342 \u2366 \u2344  \u2325 \u2367 \u2319  \u2332 \u2366 \u2344 \u2375  \u2357 \u2366 \u2354 \u2375  \u2325 \u2306 \u2335 \u2375 \u2306 \u2335 , \u2337 \u2375 \u2335 \u2366  \u2351 \u2366  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368 , \u2350 \u2371 \u2340 \u2381 \u2351 \u2369 , \u2357 \u2381 \u2351 \u2325 \u2381 \u2340 \u2367 \u2327 \u2340  \u2325 \u2381 \u2359 \u2340 \u2367  \u2351 \u2366  \u2327 \u2306 \u2349 \u2368 \u2352  \u2358 \u2366 \u2352 \u2368 \u2352 \u2367 \u2325  \u2351 \u2366  \u2346 \u2352 \u2381 \u2351 \u2366 \u2357 \u2352 \u2339 \u2368 \u2351  \u2325 \u2381 \u2359 \u2340 \u2367  \u2325 \u2366  \u2325 \u2366 \u2352 \u2339  \u2348 \u2344  \u2360 \u2325 \u2340 \u2375  \u2361 \u2376 \u2306 , \u2332 \u2367 \u2360 \u2350 \u2375 \u2306  \u2348 \u2367 \u2344 \u2366  \u2346 \u2381 \u2352 \u2340 \u2367 \u2348 \u2306 \u2343  \u2325 \u2375  \u2344 \u2366 \u2349 \u2367 \u2325 \u2368 \u2351  \u2360 \u2369 \u2357 \u2367 \u2343 \u2366 \u2319 \u2305 , \u2357 \u2367 \u2350 \u2366 \u2344  \u2344 \u2375 \u2357 \u2367 \u2327 \u2375 \u2358 \u2344  \u2351 \u2366  \u2360 \u2306 \u2330 \u2366 \u2352  \u2357 \u2381 \u2351 \u2357 \u2360 \u2381 \u2341 \u2366 , \u2361 \u2357 \u2366 \u2312  \u2351 \u2366 \u2340 \u2366 \u2351 \u2366 \u2340  \u2344 \u2367 \u2351 \u2306 \u2340 \u2381 \u2352 \u2339 , \u2332 \u2368 \u2357 \u2344  \u2309 \u2357 \u2354 \u2306 \u2348  \u2351 \u2366  \u2310 \u2351 \u2369 \u2343  \u2346 \u2381 \u2352 \u2339 \u2366 \u2354 \u2367 \u2351 \u2366 \u2305  \u2349 \u2368  \u2358 \u2366 \u2350 \u2367 \u2354  \u2361 \u2376 \u2306 \u2404  \
\
E. APPLE \uc0\u2351 \u2366  APPLE \u2309 \u2343 \u2367 \u2325 \u2371 \u2340  \u2346 \u2381 \u2352 \u2340 \u2367 \u2344 \u2367 \u2343 \u2367  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2342 \u2368  \u2327 \u2312  \u2325 \u2379 \u2312  \u2349 \u2368  \u2350 \u2380 \u2326 \u2367 \u2325  \u2351 \u2366  \u2354 \u2367 \u2326 \u2367 \u2340  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2351 \u2366  \u2360 \u2354 \u2366 \u2361  \u2325 \u2379 \u2312  \u2357 \u2366 \u2352 \u2306 \u2335 \u2368  \u2344 \u2367 \u2352 \u2381 \u2350 \u2367 \u2340  \u2344 \u2361 \u2368 \u2306  \u2325 \u2352 \u2375 \u2327 \u2368 \u2404  \u2309 \u2327 \u2352  APPLE \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2350 \u2375 \u2306  \u2325 \u2379 \u2312  \u2326 \u2352 \u2366 \u2348 \u2368  \u2310  \u2332 \u2366 \u2340 \u2368  \u2361 \u2376 , \u2340 \u2379  \u2310 \u2346 \u2325 \u2379  \u2310 \u2357 \u2358 \u2381 \u2351 \u2325  \u2360 \u2352 \u2381 \u2357 \u2367 \u2360 \u2367 \u2306 \u2327 , \u2350 \u2352 \u2350 \u2381 \u2350 \u2340  \u2351 \u2366  \u2360 \u2369 \u2343 \u2366 \u2352  \u2325 \u2368  \u2346 \u2370 \u2352 \u2381 \u2339  \u2354 \u2366 \u2327 \u2340  \u2325 \u2366  \u2357 \u2361 \u2344  \u2325 \u2352 \u2344 \u2366  \u2361 \u2379 \u2327 \u2366 \u2404  \u2325 \u2369 \u2331  \u2325 \u2381 \u2359 \u2375 \u2340 \u2381 \u2352 \u2366 \u2343 \u2367 \u2325 \u2366 \u2352  \u2313 \u2346 \u2349 \u2379 \u2325 \u2381 \u2340 \u2366  \u2325 \u2375  \u2354 \u2366 \u2327 \u2370  \u2357 \u2376 \u2343 \u2366 \u2344 \u2367 \u2325  \u2309 \u2343 \u2367 \u2325 \u2366 \u2352 \u2379 \u2306  \u2346 \u2352  \u2344 \u2367 \u2361 \u2367 \u2340  \u2357 \u2366 \u2352 \u2306 \u2335 \u2368  \u2351 \u2366  \u2360 \u2368 \u2350 \u2366 \u2323 \u2306  \u2325 \u2375  \u2348 \u2361 \u2367 \u2359 \u2381 \u2325 \u2366 \u2352  \u2325 \u2368  \u2309 \u2344 \u2369 \u2350 \u2340 \u2367  \u2344 \u2361 \u2368 \u2306  \u2342 \u2375 \u2340 \u2375  \u2361 \u2376 \u2306 , \u2311 \u2360 \u2354 \u2367 \u2319  \u2313 \u2346 \u2352 \u2379 \u2325 \u2381 \u2340  \u2348 \u2361 \u2367 \u2359 \u2381 \u2325 \u2366 \u2352  \u2324 \u2352  \u2360 \u2368 \u2350 \u2366 \u2319 \u2305  \u2310 \u2346  \u2346 \u2352  \u2354 \u2366 \u2327 \u2370  \u2344 \u2361 \u2368 \u2306  \u2361 \u2379  \u2360 \u2325 \u2340 \u2368  \u2361 \u2376 \u2306 \u2404  \
\

\f0\b 10. \uc0\u2313 \u2340 \u2381 \u2340 \u2352 \u2342 \u2366 \u2351 \u2367 \u2340 \u2381 \u2357  \u2325 \u2368  \u2360 \u2368 \u2350 \u2366 \u2319 \u2305 \u2404 
\f1\b0  \uc0\u2311 \u2360  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2350 \u2375 \u2306  \u2309 \u2344 \u2381 \u2351 \u2341 \u2366  \u2348 \u2340 \u2366 \u2319  \u2327 \u2319  \u2325 \u2379  \u2331 \u2379 \u2337 \u2364 \u2325 \u2352 , \u2354 \u2366 \u2327 \u2370  \u2325 \u2366 \u2344 \u2370 \u2344  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2346 \u2381 \u2352 \u2340 \u2367 \u2348 \u2306 \u2343 \u2367 \u2340  \u2344 \u2361 \u2368 \u2306  \u2361 \u2379 \u2344 \u2375  \u2325 \u2368  \u2360 \u2368 \u2350 \u2366  \u2340 \u2325 , \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2360 \u2381 \u2341 \u2367 \u2340 \u2367  \u2350 \u2375 \u2306  \u2357 \u2381 \u2351 \u2325 \u2381 \u2340 \u2367 \u2327 \u2340  \u2330 \u2379 \u2335  \u2351 \u2366  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2310 \u2325 \u2360 \u2381 \u2350 \u2367 \u2325 , \u2357 \u2367 \u2358 \u2375 \u2359 , \u2309 \u2346 \u2381 \u2352 \u2340 \u2381 \u2351 \u2325 \u2381 \u2359 , \u2351 \u2366  \u2346 \u2352 \u2367 \u2339 \u2366 \u2350 \u2368  \u2325 \u2381 \u2359 \u2340 \u2367  \u2325 \u2375  \u2354 \u2367 \u2319  APPLE \u2313 \u2340 \u2381 \u2340 \u2352 \u2342 \u2366 \u2351 \u2368  \u2344 \u2361 \u2368 \u2306  \u2361 \u2379 \u2327 \u2366 , \u2330 \u2366 \u2361 \u2375  \u2332 \u2379  \u2349 \u2368  \u2360 \u2381 \u2341 \u2367 \u2340 \u2367  \u2361 \u2379 , \u2332 \u2367 \u2360 \u2350 \u2375 \u2306  \u2358 \u2366 \u2350 \u2367 \u2354  \u2361 \u2376 \u2306  \u2354 \u2375 \u2325 \u2367 \u2344  \u2351 \u2361  \u2311 \u2344 \u2381 \u2361 \u2368 \u2306  \u2340 \u2325  \u2360 \u2368 \u2350 \u2367 \u2340  \u2344 \u2361 \u2368 \u2306  \u2361 \u2376 \u2306 , \u2354 \u2366 \u2349 \u2379 \u2306  \u2325 \u2368  \u2361 \u2366 \u2344 \u2367  \u2325 \u2368  \u2325 \u2381 \u2359 \u2340 \u2367 , \u2337 \u2375 \u2335 \u2366  \u2325 \u2366  \u2326 \u2352 \u2366 \u2348  \u2361 \u2379 \u2344 \u2366  \u2351 \u2366  \u2313 \u2360 \u2325 \u2368  \u2361 \u2366 \u2344 \u2367 , \u2325 \u2379 \u2312  \u2349 \u2368  \u2337 \u2375 \u2335 \u2366  \u2351 \u2366  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2346 \u2381 \u2352 \u2360 \u2366 \u2352 \u2367 \u2340  \u2325 \u2352 \u2344 \u2375  \u2351 \u2366  \u2346 \u2381 \u2352 \u2366 \u2346 \u2381 \u2340  \u2325 \u2352 \u2344 \u2375  \u2325 \u2368  \u2357 \u2367 \u2347 \u2354 \u2340 \u2366 , \u2357 \u2381 \u2351 \u2366 \u2346 \u2366 \u2352  \u2350 \u2375 \u2306  \u2352 \u2369 \u2325 \u2366 \u2357 \u2335 , \u2351 \u2366  \u2325 \u2379 \u2312  \u2349 \u2368  \u2309 \u2344 \u2381 \u2351  \u2357 \u2381 \u2351 \u2366 \u2357 \u2360 \u2366 \u2351 \u2367 \u2325  \u2325 \u2381 \u2359 \u2340 \u2367  \u2351 \u2366  \u2361 \u2366 \u2344 \u2367 , \u2332 \u2379  \u2310 \u2346 \u2325 \u2375  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  APPLE \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2351 \u2366  \u2340 \u2368 \u2360 \u2352 \u2375  \u2346 \u2325 \u2381 \u2359  \u2325 \u2375  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2351 \u2366  APPLE \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2360 \u2375  \u2360 \u2306 \u2351 \u2379 \u2332 \u2367 \u2340  \u2320 \u2346 \u2381 \u2354 \u2367 \u2325 \u2375 \u2358 \u2344  \u2325 \u2366  \u2313 \u2346 \u2351 \u2379 \u2327  \u2325 \u2352 \u2344 \u2375  \u2350 \u2375 \u2306  \u2309 \u2360 \u2350 \u2352 \u2381 \u2341 \u2340 \u2366  \u2325 \u2375  \u2325 \u2366 \u2352 \u2339  \u2361 \u2369 \u2312  \u2361 \u2376  \u2351 \u2366  \u2332 \u2379  \u2313 \u2360 \u2360 \u2375  \u2360 \u2306 \u2348 \u2306 \u2343 \u2367 \u2340  \u2361 \u2376 , \u2349 \u2354 \u2375  \u2361 \u2368  \u2320 \u2360 \u2368  \u2325 \u2381 \u2359 \u2340 \u2367  \u2351 \u2366  \u2361 \u2366 \u2344 \u2367 , \u2342 \u2375 \u2351 \u2340 \u2366  \u2325 \u2375  \u2360 \u2367 \u2342 \u2381 \u2343 \u2366 \u2344 \u2381 \u2340  (\u2309 \u2344 \u2369 \u2348 \u2306 \u2343 , \u2309 \u2346 \u2325 \u2371 \u2340 \u2381 \u2351  \u2351 \u2366  \u2309 \u2344 \u2381 \u2351 \u2341 \u2366 ) \u2325 \u2375  \u2309 \u2306 \u2340 \u2352 \u2381 \u2327 \u2340  \u2350 \u2366 \u2344 \u2381 \u2351  \u2361 \u2379  \u2324 \u2352  \u2349 \u2354 \u2375  \u2361 \u2368  \u2320 \u2360 \u2375  \u2344 \u2369 \u2325 \u2360 \u2366 \u2344 \u2379 \u2306  \u2325 \u2368  \u2360 \u2306 \u2349 \u2366 \u2357 \u2344 \u2366  \u2360 \u2375  APPLE \u2325 \u2379  \u2309 \u2357 \u2327 \u2340  \u2325 \u2352 \u2366  \u2342 \u2367 \u2351 \u2366  \u2327 \u2351 \u2366  \u2361 \u2379 \u2404  \u2325 \u2369 \u2331  \u2325 \u2381 \u2359 \u2375 \u2340 \u2381 \u2352 \u2366 \u2343 \u2367 \u2325 \u2366 \u2352  \u2357 \u2381 \u2351 \u2325 \u2381 \u2340 \u2367 \u2327 \u2340  \u2330 \u2379 \u2335 , \u2351 \u2366  \u2310 \u2325 \u2360 \u2381 \u2350 \u2367 \u2325  \u2351 \u2366  \u2346 \u2352 \u2367 \u2339 \u2366 \u2350 \u2368  \u2325 \u2381 \u2359 \u2340 \u2367 \u2351 \u2379 \u2306  \u2325 \u2375  \u2354 \u2367 \u2319  \u2342 \u2375 \u2351 \u2340 \u2366  \u2325 \u2375  \u2348 \u2361 \u2367 \u2359 \u2381 \u2325 \u2352 \u2339  \u2351 \u2366  \u2346 \u2352 \u2367 \u2360 \u2368 \u2350 \u2344  \u2325 \u2368  \u2309 \u2344 \u2369 \u2350 \u2340 \u2367  \u2344 \u2361 \u2368 \u2306  \u2342 \u2375 \u2340 \u2375  \u2361 \u2376 \u2306 , \u2311 \u2360 \u2354 \u2367 \u2319  \u2361 \u2379  \u2360 \u2325 \u2340 \u2366  \u2361 \u2376  \u2325 \u2367  \u2351 \u2361  \u2360 \u2368 \u2350 \u2366  \u2310 \u2346  \u2346 \u2352  \u2354 \u2366 \u2327 \u2370  \u2344  \u2361 \u2379 \u2404  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2360 \u2381 \u2341 \u2367 \u2340 \u2367  \u2350 \u2375 \u2306  \u2360 \u2349 \u2368  \u2325 \u2381 \u2359 \u2340 \u2367 \u2351 \u2379 \u2306  \u2325 \u2375  \u2354 \u2367 \u2319  Apple \u2325 \u2368  \u2325 \u2369 \u2354  \u2342 \u2375 \u2351 \u2340 \u2366  (\u2357 \u2381 \u2351 \u2325 \u2381 \u2340 \u2367 \u2327 \u2340  \u2330 \u2379 \u2335  \u2357 \u2366 \u2354 \u2375  \u2350 \u2366 \u2350 \u2354 \u2379 \u2306  \u2350 \u2375 \u2306  \u2354 \u2366 \u2327 \u2370  \u2325 \u2366 \u2344 \u2370 \u2344  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2310 \u2357 \u2358 \u2381 \u2351 \u2325  \u2325 \u2375  \u2309 \u2354 \u2366 \u2357 \u2366 ) \u2346 \u2330 \u2366 \u2360  \u2337 \u2377 \u2354 \u2352  ($50.00) \u2360 \u2375  \u2309 \u2343 \u2367 \u2325  \u2344 \u2361 \u2368 \u2306  \u2361 \u2379 \u2327 \u2368 \u2404  \u2313 \u2346 \u2352 \u2381 \u2351 \u2369 \u2325 \u2381 \u2340  \u2360 \u2368 \u2350 \u2366 \u2319 \u2305  \u2340 \u2348  \u2349 \u2368  \u2354 \u2366 \u2327 \u2370  \u2361 \u2379 \u2306 \u2327 \u2368 , \u2332 \u2348  \u2313 \u2346 \u2352 \u2381 \u2351 \u2369 \u2325 \u2381 \u2340  \u2313 \u2346 \u2366 \u2351  \u2309 \u2346 \u2344 \u2375  \u2310 \u2357 \u2358 \u2381 \u2351 \u2325  \u2313 \u2342 \u2381 \u2342 \u2375 \u2358 \u2381 \u2351  \u2350 \u2375 \u2306  \u2309 \u2360 \u2347 \u2354  \u2361 \u2379  \u2332 \u2366 \u2319 \u2404 \
