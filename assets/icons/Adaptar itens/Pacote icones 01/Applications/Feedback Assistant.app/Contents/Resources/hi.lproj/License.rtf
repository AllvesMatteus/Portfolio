\f0\b 11. \uc0\u2344 \u2367 \u2352 \u2381 \u2351 \u2366 \u2340  \u2344 \u2367 \u2351 \u2306 \u2340 \u2381 \u2352 \u2339 \u2404 
\f1\b0  \uc0\u2360 \u2306 \u2351 \u2369 \u2325 \u2381 \u2340  \u2352 \u2366 \u2332 \u2381 \u2351  \u2309 \u2350 \u2375 \u2352 \u2367 \u2325 \u2366  \u2325 \u2375  \u2325 \u2366 \u2344 \u2370 \u2344  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2309 \u2343 \u2367 \u2325 \u2371 \u2340  \u2324 \u2352  \u2325 \u2366 \u2344 \u2370 \u2344  \u2325 \u2366  \u2325 \u2381 \u2359 \u2375 \u2340 \u2381 \u2352 \u2366 \u2343 \u2367 \u2325 \u2366 \u2352  \u2332 \u2367 \u2360 \u2325 \u2375  \u2309 \u2306 \u2340 \u2352 \u2381 \u2327 \u2340  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2346 \u2381 \u2352 \u2366 \u2346 \u2381 \u2340  \u2325 \u2367 \u2351 \u2366  \u2327 \u2351 \u2366  \u2341 \u2366 , \u2311 \u2360 \u2325 \u2375  \u2360 \u2367 \u2357 \u2366 \u2351  \u2310 \u2346  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2366  \u2313 \u2346 \u2351 \u2379 \u2327  \u2351 \u2366  \u2311 \u2360 \u2325 \u2366  \u2344 \u2367 \u2352 \u2381 \u2351 \u2366 \u2340  \u2351 \u2366  \u2346 \u2369 \u2344 \u2307  \u2344 \u2367 \u2352 \u2381 \u2351 \u2366 \u2340  \u2344 \u2361 \u2368 \u2306  \u2325 \u2352  \u2360 \u2325 \u2340 \u2375  \u2361 \u2376 \u2306 \u2404  \u2357 \u2367 \u2358 \u2375 \u2359  \u2352 \u2370 \u2346  \u2360 \u2375 , \u2354 \u2375 \u2325 \u2367 \u2344  \u2348 \u2367 \u2344 \u2366  \u2325 \u2367 \u2360 \u2368  \u2360 \u2368 \u2350 \u2366  \u2325 \u2375 , Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2379  (\u2325 ) \u2360 \u2306 \u2351 \u2369 \u2325 \u2381 \u2340  \u2352 \u2366 \u2332 \u2381 \u2351  \u2309 \u2350 \u2375 \u2352 \u2367 \u2325 \u2366  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2346 \u2381 \u2352 \u2340 \u2367 \u2348 \u2306 \u2343 \u2367 \u2340  \u2342 \u2375 \u2358  \u2350 \u2375 \u2306  \u2351 \u2366  (\u2326 ) \u2357 \u2367 \u2358 \u2375 \u2359  \u2352 \u2370 \u2346  \u2360 \u2375  \u2344 \u2366 \u2350 \u2367 \u2340  \u2352 \u2366 \u2359 \u2381 \u2335 \u2381 \u2352 \u2379 \u2306  \u2325 \u2368  \u2309 \u2350 \u2375 \u2352 \u2367 \u2325 \u2368  \u2335 \u2381 \u2352 \u2375 \u2395 \u2352 \u2368  \u2357 \u2367 \u2349 \u2366 \u2327  \u2325 \u2368  \u2360 \u2370 \u2330 \u2368  \u2351 \u2366  \u2309 \u2350 \u2375 \u2352 \u2367 \u2325 \u2368  \u2357 \u2366 \u2339 \u2367 \u2332 \u2381 \u2351  \u2357 \u2367 \u2349 \u2366 \u2327  \u2325 \u2375  \u2357 \u2367 \u2358 \u2375 \u2359  \u2309 \u2349 \u2367 \u2361 \u2368 \u2340  \u2357 \u2381 \u2351 \u2325 \u2381 \u2340 \u2367 \u2351 \u2379 \u2306  \u2351 \u2366  \u2344 \u2367 \u2325 \u2366 \u2351  \u2325 \u2368  \u2360 \u2370 \u2330 \u2368  \u2351 \u2366  \u2309 \u2344 \u2381 \u2351  \u2325 \u2367 \u2360 \u2368  \u2346 \u2381 \u2352 \u2340 \u2367 \u2348 \u2306 \u2343 \u2367 \u2340  \u2346 \u2325 \u2381 \u2359 \u2379 \u2306  \u2325 \u2368  \u2360 \u2370 \u2330 \u2368  \u2350 \u2375 \u2306  \u2344 \u2367 \u2361 \u2367 \u2340  \u2325 \u2367 \u2360 \u2368  \u2357 \u2381 \u2351 \u2325 \u2381 \u2340 \u2367  \u2325 \u2379  \u2344 \u2367 \u2352 \u2381 \u2351 \u2366 \u2340  \u2351 \u2366  \u2346 \u2369 \u2344 \u2307  \u2344 \u2367 \u2352 \u2381 \u2351 \u2366 \u2340  \u2344 \u2361 \u2368 \u2306  \u2325 \u2367 \u2351 \u2366  \u2332 \u2366  \u2360 \u2325 \u2340 \u2366  \u2361 \u2376 \u2404  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2379  \u2337 \u2366 \u2313 \u2344 \u2354 \u2379 \u2337  \u2325 \u2352 \u2325 \u2375  \u2324 \u2352  \u2311 \u2360 \u2325 \u2366  \u2313 \u2346 \u2351 \u2379 \u2327  \u2325 \u2352 \u2325 \u2375 , \u2310 \u2346  \u2346 \u2381 \u2352 \u2340 \u2367 \u2344 \u2367 \u2343 \u2367 \u2340 \u2381 \u2357  \u2325 \u2352 \u2340 \u2375  \u2361 \u2376 \u2306  \u2324 \u2352  \u2357 \u2366 \u2352 \u2306 \u2335 \u2368  \u2342 \u2375 \u2340 \u2375  \u2361 \u2376 \u2306  \u2325 \u2367  \u2310 \u2346  \u2320 \u2360 \u2375  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2342 \u2375 \u2358  \u2350 \u2375 \u2306  \u2344 \u2361 \u2368 \u2306  \u2352 \u2361  \u2352 \u2361 \u2375  \u2361 \u2376 \u2306 , \u2351 \u2366  \u2360 \u2370 \u2330 \u2368  \u2350 \u2375 \u2306  \u2350 \u2380 \u2332 \u2370 \u2342  \u2344 \u2361 \u2368 \u2306  \u2361 \u2376 \u2306 \u2404  \u2310 \u2346  \u2351 \u2361  \u2349 \u2368  \u2360 \u2361 \u2350 \u2340 \u2367  \u2342 \u2375 \u2340 \u2375  \u2361 \u2376 \u2306  \u2325 \u2367  \u2310 \u2346  \u2360 \u2306 \u2351 \u2369 \u2325 \u2381 \u2340  \u2352 \u2366 \u2332 \u2381 \u2351  \u2325 \u2375  \u2325 \u2366 \u2344 \u2370 \u2344  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2344 \u2367 \u2359 \u2367 \u2342 \u2381 \u2343  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2313 \u2342 \u2381 \u2342 \u2375 \u2358 \u2381 \u2351  \u2325 \u2375  \u2354 \u2367 \u2319  Apple \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2366  \u2313 \u2346 \u2351 \u2379 \u2327  \u2344 \u2361 \u2368 \u2306  \u2325 \u2352 \u2375 \u2306 \u2327 \u2375 , \u2332 \u2367 \u2360 \u2350 \u2375 \u2306  \u2348 \u2367 \u2344 \u2366  \u2325 \u2367 \u2360 \u2368  \u2360 \u2368 \u2350 \u2366  \u2325 \u2375 , \u2350 \u2367 \u2360 \u2366 \u2311 \u2354 \u2379 \u2306 , \u2346 \u2352 \u2350 \u2366 \u2339 \u2369 , \u2352 \u2366 \u2360 \u2366 \u2351 \u2344 \u2367 \u2325  \u2351 \u2366  \u2332 \u2376 \u2357 \u2367 \u2325  \u2361 \u2341 \u2367 \u2351 \u2366 \u2352 \u2379 \u2306  \u2325 \u2366  \u2357 \u2367 \u2325 \u2366 \u2360 , \u2337 \u2367 \u2332 \u2364 \u2366 \u2311 \u2344 , \u2344 \u2367 \u2352 \u2381 \u2350 \u2366 \u2339  \u2351 \u2366  \u2313 \u2340 \u2381 \u2346 \u2366 \u2342 \u2344  \u2358 \u2366 \u2350 \u2367 \u2354  \u2361 \u2376 \u2404 \
