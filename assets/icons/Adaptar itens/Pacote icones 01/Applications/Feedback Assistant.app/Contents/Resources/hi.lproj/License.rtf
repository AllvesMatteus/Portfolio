\f0\b 13. \uc0\u2360 \u2352 \u2325 \u2366 \u2352 \u2368  \u2309 \u2306 \u2340 \u2367 \u2350  \u2313 \u2346 \u2351 \u2379 \u2327 \u2325 \u2352 \u2381 \u2340 \u2366 \u2404 
\f1\b0  Apple \uc0\u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2324 \u2352  \u2360 \u2306 \u2348 \u2306 \u2343 \u2367 \u2340  \u2342 \u2360 \u2381 \u2340 \u2366 \u2357 \u2375 \u2332 \u2364 \u2368 \u2325 \u2352 \u2339  "\u2357 \u2366 \u2339 \u2367 \u2332 \u2381 \u2351 \u2367 \u2325  \u2313 \u2340 \u2381 \u2346 \u2366 \u2342 " \u2361 \u2376 \u2306 , \u2332 \u2376 \u2360 \u2366  \u2325 \u2367  \u2311 \u2360  \u2358 \u2348 \u2381 \u2342  \u2325 \u2379  48 C.F.R. \'a42.101 \u2350 \u2375 \u2306  \u2346 \u2352 \u2367 \u2349 \u2366 \u2359 \u2367 \u2340  \u2325 \u2367 \u2351 \u2366  \u2327 \u2351 \u2366  \u2361 \u2376 , \u2332 \u2367 \u2360 \u2350 \u2375 \u2306  "\u2357 \u2366 \u2339 \u2367 \u2332 \u2381 \u2351 \u2367 \u2325  \u2325 \u2306 \u2346 \u2381 \u2351 \u2370 \u2335 \u2352  \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352 " \u2324 \u2352  "\u2357 \u2366 \u2339 \u2367 \u2332 \u2381 \u2351 \u2367 \u2325  \u2325 \u2306 \u2346 \u2381 \u2351 \u2370 \u2335 \u2352  \u2360 \u2377 \u2347 \u2364 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2342 \u2360 \u2381 \u2340 \u2366 \u2357 \u2375 \u2332 \u2364 \u2368 \u2325 \u2352 \u2339 " \u2358 \u2366 \u2350 \u2367 \u2354  \u2361 \u2376 \u2306 , \u2325 \u2381 \u2351 \u2379 \u2306 \u2325 \u2367  \u2320 \u2360 \u2375  \u2358 \u2348 \u2381 \u2342 \u2379 \u2306  \u2325 \u2366  \u2313 \u2346 \u2351 \u2379 \u2327  48 C.F.R. \'a412.212 \u2351 \u2366  48 C.F.R. \'a4227.7202 \u2350 \u2375 \u2306  \u2325 \u2367 \u2351 \u2366  \u2332 \u2366 \u2340 \u2366  \u2361 \u2376 , \u2332 \u2376 \u2360 \u2366  \u2354 \u2366 \u2327 \u2370  \u2361 \u2379 \u2404  48 C.F.R.\'a412.212 \u2351 \u2366  48 C.F.R.\'a4227.7202-1 \u2360 \u2375  227.7202-4 \u2325 \u2375  \u2309 \u2344 \u2369 \u2352 \u2370 \u2346 , \u2332 \u2376 \u2360 \u2366  \u2354 \u2366 \u2327 \u2370  \u2361 \u2379 , \u2357 \u2366 \u2339 \u2367 \u2332 \u2381 \u2351 \u2367 \u2325  \u2325 \u2306 \u2346 \u2381 \u2351 \u2370 \u2335 \u2352  \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2324 \u2352  \u2357 \u2366 \u2339 \u2367 \u2332 \u2381 \u2351 \u2367 \u2325  \u2325 \u2306 \u2346 \u2381 \u2351 \u2370 \u2335 \u2352  \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2342 \u2360 \u2381 \u2340 \u2366 \u2357 \u2375 \u2332 \u2364 \u2368 \u2325 \u2352 \u2339  \u2325 \u2379  \u2309 \u2350 \u2375 \u2352 \u2367 \u2325 \u2368  \u2360 \u2352 \u2325 \u2366 \u2352  \u2325 \u2375  \u2309 \u2306 \u2340 \u2367 \u2350  \u2313 \u2346 \u2351 \u2379 \u2327 \u2325 \u2352 \u2381 \u2340 \u2366 \u2323 \u2306  \u2325 \u2379  (\u2325 ) \u2325 \u2375 \u2357 \u2354  \u2357 \u2366 \u2339 \u2367 \u2332 \u2381 \u2351 \u2367 \u2325  \u2313 \u2340 \u2381 \u2346 \u2366 \u2342 \u2379 \u2306  \u2325 \u2375  \u2352 \u2370 \u2346  \u2350 \u2375 \u2306 , \u2324 \u2352  (\u2326 ) \u2325 \u2375 \u2357 \u2354  \u2313 \u2344  \u2309 \u2343 \u2367 \u2325 \u2366 \u2352 \u2379 \u2306  \u2325 \u2375  \u2360 \u2366 \u2341  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2342 \u2367 \u2351 \u2366  \u2332 \u2366  \u2352 \u2361 \u2366  \u2361 \u2376  \u2332 \u2379  \u2351 \u2361 \u2366 \u2305  \u2325 \u2375  \u2344 \u2367 \u2351 \u2350 \u2379 \u2306  \u2324 \u2352  \u2358 \u2352 \u2381 \u2340 \u2379 \u2306  \u2325 \u2375  \u2309 \u2344 \u2369 \u2360 \u2366 \u2352  \u2309 \u2344 \u2381 \u2351  \u2360 \u2349 \u2368  \u2309 \u2306 \u2340 \u2367 \u2350  \u2313 \u2346 \u2351 \u2379 \u2327 \u2325 \u2352 \u2381 \u2340 \u2366 \u2323 \u2306  \u2325 \u2379  \u2342 \u2367 \u2319  \u2327 \u2319  \u2361 \u2376 \u2306 \u2404  \u2309 \u2346 \u2381 \u2352 \u2325 \u2366 \u2358 \u2367 \u2340 -\u2309 \u2343 \u2367 \u2325 \u2366 \u2352 , \u2360 \u2306 \u2351 \u2369 \u2325 \u2381 \u2340  \u2352 \u2366 \u2332 \u2381 \u2351  \u2325 \u2375  \u2325 \u2377 \u2346 \u2368 \u2352 \u2366 \u2311 \u2335  \u2325 \u2366 \u2344 \u2370 \u2344  \u2325 \u2375  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2310 \u2352 \u2325 \u2381 \u2359 \u2367 \u2340  \u2361 \u2376