\f1\b0 A. \uc0\u2310 \u2346  \u2311 \u2360  \u2348 \u2366 \u2340  \u2360 \u2375  \u2360 \u2361 \u2350 \u2340  \u2361 \u2376 \u2306  \u2325 \u2367  \u2311 \u2360 \u2325 \u2375  \u2340 \u2361 \u2340  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360 \u2368 \u2325 \u2371 \u2340  Apple \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2324 \u2352  Apple \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2310 \u2346 \u2325 \u2379  \u2346 \u2381 \u2352 \u2325 \u2335  \u2325 \u2368  \u2327 \u2312  \u2320 \u2360 \u2368  \u2360 \u2349 \u2368  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2325 \u2379 , \u2332 \u2379  \u2320 \u2360 \u2375  Apple \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2360 \u2375  \u2360 \u2306 \u2348 \u2306 \u2343 \u2367 \u2340  \u2361 \u2376 , \'d2\u2327 \u2379 \u2346 \u2344 \u2368 \u2351  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368 \'d3 \u2350 \u2366 \u2344 \u2366  \u2332 \u2366 \u2319 \u2327 \u2366  \u2324 \u2352  \u2311 \u2360  \u2352 \u2370 \u2346  \u2350 \u2375 \u2306  \u2360 \u2306 \u2342 \u2352 \u2381 \u2349 \u2367 \u2340  \u2325 \u2367 \u2351 \u2366  \u2332 \u2366 \u2319 \u2327 \u2366 \u2404  \u2361 \u2366 \u2354 \u2366 \u2306 \u2325 \u2367  \u2327 \u2379 \u2346 \u2344 \u2368 \u2351  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2350 \u2375 \u2306  \u2351 \u2361  \u2358 \u2366 \u2350 \u2367 \u2354  \u2344 \u2361 \u2368 \u2306  \u2361 \u2379 \u2340 \u2366  \u2361 \u2376 : (a) \u2357 \u2361  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2332 \u2379  \u2357 \u2352 \u2381 \u2340 \u2350 \u2366 \u2344  \u2350 \u2375 \u2306  \u2351 \u2366  \u2348 \u2366 \u2342  \u2350 \u2375 \u2306  \u2310 \u2346 \u2325 \u2368  \u2325 \u2367 \u2360 \u2368  \u2327 \u2354 \u2340 \u2368  \u2351 \u2366  \u2313 \u2354 \u2381 \u2354 \u2306 \u2328 \u2344  \u2325 \u2375  \u2348 \u2367 \u2344 \u2366  \u2320 \u2360 \u2375  \u2340 \u2352 \u2368 \u2325 \u2375  \u2360 \u2375  \u2310 \u2350  \u2340 \u2380 \u2352  \u2346 \u2352  \u2332 \u2344 \u2340 \u2366  \u2325 \u2375  \u2354 \u2367 \u2319  \u2313 \u2346 \u2354 \u2348 \u2381 \u2343  \u2361 \u2376  \u2351 \u2366  \u2361 \u2379  \u2332 \u2366 \u2340 \u2368  \u2361 \u2376 , \u2332 \u2379  \u2325 \u2366 \u2344 \u2370 \u2344  \u2360 \u2350 \u2381 \u2350 \u2340  \u2361 \u2379  \u2351 \u2366  \u2332 \u2367 \u2360 \u2375  Apple \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2309 \u2343 \u2367 \u2325 \u2371 \u2340  \u2325 \u2367 \u2351 \u2366  \u2327 \u2351 \u2366  \u2361 \u2379  (b) \u2320 \u2360 \u2368  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2332 \u2367 \u2360 \u2325 \u2375  \u2348 \u2366 \u2352 \u2375  \u2350 \u2375 \u2306  \u2310 \u2346  \u2351 \u2361  \u2348 \u2340 \u2366  \u2360 \u2325 \u2340 \u2375  \u2361 \u2376 \u2306  \u2325 \u2367  Apple \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2310 \u2346 \u2325 \u2379  \u2346 \u2381 \u2352 \u2325 \u2335  \u2325 \u2352 \u2344 \u2375  \u2325 \u2375  \u2346 \u2361 \u2354 \u2375  \u2357 \u2361  \u2313 \u2330 \u2367 \u2340  \u2352 \u2370 \u2346  \u2360 \u2375  \u2310 \u2346 \u2325 \u2375  \u2309 \u2343 \u2367 \u2325 \u2366 \u2352  \u2350 \u2375 \u2306  \u2341 \u2368 ; (c) \u2320 \u2360 \u2368  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2332 \u2367 \u2360 \u2375  \u2310 \u2346 \u2325 \u2375  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2360 \u2381 \u2357 \u2340 \u2306 \u2340 \u2381 \u2352  \u2352 \u2370 \u2346  \u2360 \u2375  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2327 \u2379 \u2346 \u2344 \u2368 \u2351  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2325 \u2375  \u2313 \u2346 \u2351 \u2379 \u2327  \u2325 \u2375  \u2348 \u2367 \u2344 \u2366  \u2357 \u2367 \u2325 \u2360 \u2367 \u2340  \u2325 \u2367 \u2351 \u2366  \u2327 \u2351 \u2366  \u2341 \u2366 ; \u2351 \u2366  (d) \u2320 \u2360 \u2368  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368 , \u2332 \u2367 \u2360 \u2375  \u2310 \u2346 \u2325 \u2375  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2325 \u2367 \u2360 \u2368  \u2320 \u2360 \u2375  \u2340 \u2368 \u2360 \u2352 \u2375  \u2346 \u2325 \u2381 \u2359  \u2360 \u2375  \u2313 \u2330 \u2367 \u2340  \u2340 \u2352 \u2368 \u2325 \u2375  \u2360 \u2375  \u2346 \u2381 \u2352 \u2366 \u2346 \u2381 \u2340  \u2325 \u2367 \u2351 \u2366  \u2327 \u2351 \u2366  \u2341 \u2366 , \u2332 \u2367 \u2360 \u2375  \u2311 \u2360  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2325 \u2379  \u2335 \u2381 \u2352 \u2366 \u2306 \u2360 \u2398 \u2352  \u2351 \u2366  \u2346 \u2381 \u2352 \u2325 \u2335  \u2325 \u2352 \u2344 \u2375  \u2325 \u2366  \u2309 \u2343 \u2367 \u2325 \u2366 \u2352  Apple \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2342 \u2367 \u2351 \u2366  \u2327 \u2351 \u2366  \u2341 \u2366 \u2404  \
\
B. \uc0\u2310 \u2346  \u2311 \u2360  \u2348 \u2366 \u2340  \u2360 \u2375  \u2360 \u2361 \u2350 \u2340  \u2361 \u2379 \u2340 \u2375  \u2361 \u2376 \u2306  \u2325 \u2367  \u2310 \u2346  \u2311 \u2344 \u2381 \u2361 \u2375 \u2306  \u2331 \u2379 \u2396 \u2325 \u2352  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2309 \u2344 \u2381 \u2351  \u2357 \u2381 \u2351 \u2325 \u2381 \u2340 \u2367  \u2325 \u2379  \u2351 \u2361  \u2327 \u2379 \u2346 \u2344 \u2368 \u2351  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2344 \u2361 \u2368 \u2306  \u2348 \u2340 \u2366 \u2319 \u2306 \u2327 \u2375 , \u2346 \u2381 \u2352 \u2325 \u2366 \u2358 \u2367 \u2340  \u2344 \u2361 \u2368 \u2306  \u2325 \u2352 \u2375 \u2306 \u2327 \u2375  \u2351 \u2366  \u2346 \u2381 \u2352 \u2360 \u2366 \u2352 \u2367 \u2340  \u2344 \u2361 \u2368 \u2306  \u2325 \u2352 \u2375 \u2306 \u2327 \u2375 : (1) \u2310 \u2346 \u2325 \u2375  \u2320 \u2360 \u2375  \u2325 \u2352 \u2381 \u2350 \u2330 \u2366 \u2352 \u2368  \u2351 \u2366  \u2309 \u2344 \u2369 \u2348 \u2306 \u2343 \u2325 \u2352 \u2381 \u2340 \u2366 , \u2332 \u2367 \u2344 \u2381 \u2361 \u2375 \u2306  \u2311 \u2360 \u2375  \u2332 \u2366 \u2344 \u2344 \u2375  \u2325 \u2368  \u2360 \u2366 \u2348 \u2367 \u2340  \u2325 \u2352 \u2344 \u2375  \u2351 \u2379 \u2327 \u2381 \u2351  \u2310 \u2357 \u2358 \u2381 \u2351 \u2325 \u2340 \u2366  \u2361 \u2379 , \u2332 \u2367 \u2344 \u2325 \u2375  \u2310 \u2346 \u2325 \u2375  \u2346 \u2381 \u2352 \u2340 \u2367  \u2320 \u2360 \u2375  \u2348 \u2366 \u2343 \u2381 \u2351 \u2325 \u2352 \u2368 , \u2354 \u2367 \u2326 \u2367 \u2340 , \u2327 \u2379 \u2346 \u2344 \u2368 \u2351 \u2340 \u2366  \u2342 \u2366 \u2351 \u2367 \u2340 \u2381 \u2357  \u2350 \u2380 \u2332 \u2370 \u2342  \u2361 \u2379 \u2306 , \u2332 \u2379  \u2320 \u2360 \u2368  \u2327 \u2379 \u2346 \u2344 \u2368 \u2351  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2325 \u2379  \u2309 \u2344 \u2343 \u2367 \u2325 \u2371 \u2340  \u2346 \u2381 \u2352 \u2325 \u2335 \u2368 \u2325 \u2352 \u2339  \u2360 \u2375  \u2360 \u2369 \u2352 \u2325 \u2381 \u2359 \u2367 \u2340  \u2348 \u2344 \u2366 \u2340 \u2375  \u2361 \u2379 \u2306 , \u2351 \u2366  (2) Apple \u2325 \u2375  \u2360 \u2368 \u2337  \u2346 \u2381 \u2352 \u2379 \u2327 \u2381 \u2352 \u2366 \u2350  \u2325 \u2375  \u2320 \u2360 \u2375  \u2309 \u2344 \u2381 \u2351  \u2346 \u2381 \u2352 \u2340 \u2367 \u2349 \u2366 \u2327 \u2368 , \u2354 \u2375 \u2325 \u2367 \u2344  \u2320 \u2360 \u2366  \u2360 \u2367 \u2352 \u2381 \u2398  Apple \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2354 \u2366 \u2327 \u2370  \u2360 \u2368 \u2337  \u2357 \u2375 \u2348  \u2346 \u2379 \u2352 \u2381 \u2335 \u2354  (\u2309 \u2327 \u2352  \u2325 \u2379 \u2312  \u2361 \u2379 ) \u2325 \u2375  \u2395 \u2352 \u2367 \u2319  Apple \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2346 \u2381 \u2352 \u2342 \u2366 \u2344  \u2325 \u2367 \u2319  \u2327 \u2319  Apple \u2360 \u2377 \u2398 \u2381 \u2335 \u2357 \u2375 \u2351 \u2352  \u2325 \u2375  \u2327 \u2379 \u2346 \u2344 \u2368 \u2351  \u2330 \u2352 \u2381 \u2330 \u2366  \u2398 \u2379 \u2352 \u2350  \u2325 \u2375  \u2313 \u2346 \u2351 \u2379 \u2327  \u2325 \u2375  \u2395 \u2352 \u2367 \u2319  \u2361 \u2368  \u2325 \u2367 \u2351 \u2366  \u2332 \u2366  \u2360 \u2325 \u2340 \u2366  \u2361 \u2376 \u2404  \u2311 \u2360 \u2325 \u2375  \u2309 \u2354 \u2366 \u2357 \u2366  \u2310 \u2346  \u2327 \u2379 \u2346 \u2344 \u2368 \u2351  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2325 \u2375  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2309 \u2344 \u2343 \u2367 \u2325 \u2371 \u2340  \u2313 \u2346 \u2351 \u2379 \u2327 , \u2346 \u2381 \u2352 \u2325 \u2335 \u2368 \u2325 \u2352 \u2339 , \u2346 \u2381 \u2352 \u2325 \u2366 \u2358 \u2344  \u2351 \u2366  \u2346 \u2381 \u2352 \u2360 \u2366 \u2352  \u2325 \u2379  \u2352 \u2379 \u2325 \u2344 \u2375  \u2325 \u2375  \u2354 \u2367 \u2319  \u2313 \u2330 \u2367 \u2340  \u2360 \u2366 \u2357 \u2343 \u2366 \u2344 \u2368  \u2348 \u2352 \u2340 \u2344 \u2375  \u2325 \u2375  \u2354 \u2367 \u2319  \u2349 \u2368  \u2360 \u2361 \u2350 \u2340  \u2361 \u2379 \u2340 \u2375  \u2361 \u2376 \u2306 \u2404  \u2310 \u2346  \u2360 \u2361 \u2350 \u2340  \u2361 \u2379 \u2340 \u2375  \u2361 \u2376 \u2306  \u2325 \u2367  \u2310 \u2346  \u2327 \u2379 \u2346 \u2344 \u2368 \u2351  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2325 \u2366  \u2313 \u2346 \u2351 \u2379 \u2327  \u2309 \u2344 \u2381 \u2351 \u2341 \u2366  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2360 \u2381 \u2341 \u2367 \u2340 \u2367  \u2350 \u2375 \u2306  \u2320 \u2360 \u2375  \u2361 \u2352  \u2350 \u2380 \u2325 \u2375  \u2346 \u2352  Apple \u2325 \u2375  \u2309 \u2343 \u2367 \u2325 \u2371 \u2340  \u2346 \u2381 \u2352 \u2340 \u2367 \u2344 \u2367 \u2343 \u2367  \u2325 \u2368  \u2346 \u2370 \u2352 \u2381 \u2357  \u2354 \u2367 \u2326 \u2367 \u2340  \u2360 \u2381 \u2357 \u2368 \u2325 \u2371 \u2340 \u2367  \u2325 \u2375  \u2348 \u2367 \u2344 \u2366  \u2309 \u2346 \u2344 \u2375  \u2351 \u2366  \u2325 \u2367 \u2360 \u2368  \u2340 \u2368 \u2360 \u2352 \u2375  \u2346 \u2325 \u2381 \u2359  \u2325 \u2375  \u2354 \u2366 \u2349  \u2325 \u2375  \u2354 \u2367 \u2319  \u2344 \u2361 \u2368 \u2306  \u2325 \u2352 \u2375 \u2306 \u2327 \u2375 \u2404  \u2360 \u2349 \u2368  \u2327 \u2379 \u2346 \u2344 \u2368 \u2351  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  Apple \u2325 \u2368  \u2319 \u2325 \u2350 \u2366 \u2340 \u2381 \u2352  \u2360 \u2306 \u2346 \u2340 \u2381 \u2340 \u2367  \u2348 \u2344 \u2368  \u2352 \u2361 \u2340 \u2368  \u2361 \u2376 \u2404  \u2310 \u2346 \u2325 \u2375  \u2346 \u2366 \u2360  \u2320 \u2360 \u2368  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2327 \u2379 \u2346 \u2344 \u2368 \u2351  \u2332 \u2366 \u2344 \u2325 \u2366 \u2352 \u2368  \u2325 \u2366  \u2325 \u2379 \u2312  \u2349 \u2368  \u2344 \u2367 \u2361 \u2367 \u2340  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2351 \u2366  \u2309 \u2344 \u2381 \u2351  \u2309 \u2343 \u2367 \u2325 \u2366 \u2352  \u2344 \u2361 \u2368 \u2306  \u2361 \u2376 , \u2332 \u2367 \u2360 \u2375  2A \u2350 \u2375 \u2306  \u2357 \u2367 \u2358 \u2375 \u2359  \u2352 \u2370 \u2346  \u2360 \u2375  \u2344 \u2361 \u2368 \u2306  \u2342 \u2367 \u2351 \u2366  \u2327 \u2351 \u2366  \u2361 \u2376 \u2404 \
