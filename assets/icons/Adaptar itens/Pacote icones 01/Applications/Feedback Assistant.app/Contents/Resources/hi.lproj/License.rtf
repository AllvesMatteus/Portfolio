\f0\b 14. \uc0\u2344 \u2367 \u2351 \u2306 \u2340 \u2381 \u2352 \u2339  \u2325 \u2366 \u2344 \u2370 \u2344  \u2324 \u2352  \u2309 \u2354 \u2327  \u2325 \u2352 \u2344 \u2375  \u2325 \u2368  \u2351 \u2379 \u2327 \u2381 \u2351 \u2340 \u2366 \u2404 
\f1\b0  \uc0\u2351 \u2361  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360 , \u2309 \u2346 \u2344 \u2375  \u2325 \u2366 \u2344 \u2370 \u2344 \u2368  \u2360 \u2367 \u2342 \u2381 \u2343 \u2366 \u2306 \u2340 \u2379 \u2306  \u2325 \u2375  \u2335 \u2325 \u2352 \u2366 \u2357  \u2325 \u2379  \u2331 \u2379 \u2337 \u2364 \u2325 \u2352 , \u2325 \u2376 \u2354 \u2367 \u2347 \u2364 \u2379 \u2352 \u2381 \u2344 \u2367 \u2351 \u2366  \u2352 \u2366 \u2332 \u2381 \u2351  \u2325 \u2375  \u2325 \u2366 \u2344 \u2370 \u2344 \u2379 \u2306  \u2325 \u2375  \u2309 \u2344 \u2369 \u2360 \u2366 \u2352  \u2344 \u2367 \u2351 \u2306 \u2340 \u2381 \u2352 \u2367 \u2340  \u2361 \u2379 \u2327 \u2366  \u2324 \u2352  \u2360 \u2350 \u2333 \u2366  \u2332 \u2366 \u2319 \u2327 \u2366 \u2404  \u2357 \u2360 \u2381 \u2340 \u2369 \u2323 \u2306  \u2325 \u2368  \u2309 \u2306 \u2340 \u2352 \u2381 \u2352 \u2366 \u2359 \u2381 \u2335 \u2381 \u2352 \u2368 \u2351  \u2348 \u2367 \u2325 \u2381 \u2352 \u2368  \u2325 \u2375  \u2309 \u2344 \u2369 \u2348 \u2306 \u2343  \u2350 \u2375 \u2306  \u2351 \u2361  \u2354 \u2366 \u2311 \u2360 \u2375 \u2306 \u2360  \u2360 \u2306 \u2351 \u2369 \u2325 \u2381 \u2340  \u2352 \u2366 \u2359 \u2381 \u2335 \u2381 \u2352  \u2360 \u2306 \u2343 \u2367 \u2346 \u2340 \u2381 \u2352  \u2342 \u2381 \u2357 \u2366 \u2352 \u2366  \u2358 \u2366 \u2360 \u2367 \u2340  \u2344 \u2361 \u2368 \u2306  \u2361 \u2379 \u2327 \u2366 , \u2332 \u2367 \u2360 \u2325 \u2366  \u2346 \u2381 \u2352 \u2351 \u2379 \u2327  \u2360 \u2381 \u2346 \u2359 \u2381 \u2335  \u2352 \u2370 \u2346  \u2360 \u2375  \u2309 \u2346 \u2357 \u2352 \u2381 \u2332 \u2367 \u2340  \u2361 \u2376 \u2404  \u2309 \u2327 \u2352  \u2325 \u2367 \u2360 \u2368  \u2349 \u2368  \u2325 \u2366 \u2352 \u2339  \u2360 \u2375  \u2360 \u2325 \u2381 \u2359 \u2350  \u2325 \u2381 \u2359 \u2375 \u2340 \u2381 \u2352 \u2366 \u2343 \u2367 \u2325 \u2366 \u2352  \u2325 \u2375  \u2344 \u2381 \u2351 \u2366 \u2351 \u2366 \u2354 \u2351  \u2325 \u2379  \u2325 \u2379 \u2312  \u2346