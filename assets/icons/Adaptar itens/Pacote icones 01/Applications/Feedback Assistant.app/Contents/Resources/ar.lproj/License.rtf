\f0\b 12. \uc0\u1593 \u1583 \u1605  \u1575 \u1604 \u1578 \u1606 \u1575 \u1586 \u1604  \u1593 \u1606  \u1581 \u1602 \u1608 \u1602 .
\f1\b0  \uc0\u1604 \u1575  \u1610 \u1588 \u1603 \u1617 \u1604  \u1571 \u1610  \u1578 \u1571 \u1582 \u1610 \u1585  \u1571 \u1608  \u1573 \u1582 \u1601 \u1575 \u1602  \u1576 \u1605 \u1608 \u1580 \u1576  \u1607 \u1584 \u1575  \u1575 \u1604 \u1578 \u1589 \u1585 \u1610 \u1581  \u1578 \u1606 \u1575 \u1586 \u1604 \u1575 \u1611  \u1573 \u1604 \u1575  \u1573 \u1584 \u1575  \u1578 \u1605  \u1575 \u1604 \u1578 \u1606 \u1575 \u1586 \u1604  \u1589 \u1585 \u1575 \u1581 \u1577  \u1608 \u1576 \u1588 \u1603 \u1604  \u1605 \u1603 \u1578 \u1608 \u1576  \u1608 \u1605 \u1608 \u1602 \u1617 \u1593  \u1605 \u1606  \u1605 \u1605 \u1579 \u1604  \u1605 \u1593 \u1578 \u1605 \u1583  \u1605 \u1606 \u1575 \u1587 \u1576  \u1604 \u1588 \u1585 \u1603 \u1577  Apple\u1548  \u1608 \u1604 \u1575  \u1610 \u1605 \u1579 \u1604  \u1571 \u1610  \u1578 \u1606 \u1575 \u1586 \u1604  \u1601 \u1585 \u1583 \u1610  \u1578 \u1606 \u1575 \u1586 \u1604 \u1575 \u1611  \u1605 \u1587 \u1578 \u1605 \u1585 \u1611 \u1575  \u1571 \u1608  \u1578 \u1575 \u1604 \u1610 \u1611 \u1575 . \u1604 \u1575  \u1610 \u1580 \u1608 \u1586  \u1604 \u1603  \u1575 \u1604 \u1578 \u1606 \u1575 \u1586 \u1604  \u1593 \u1606  \u1607 \u1584 \u1575  \u1575 \u1604 \u1578 \u1589 \u1585 \u1610 \u1581  \u1571 \u1608  \u1606 \u1602 \u1604 \u1607 \u1575  \u1603 \u1604 \u1610 \u1611 \u1575  \u1571 \u1608  \u1580 \u1586 \u1574 \u1610 \u1611 \u1575  \u1605 \u1606  \u1583 \u1608 \u1606  \u1605 \u1608 \u1575 \u1601 \u1602 \u1577  \u1603 \u1578 \u1575 \u1576 \u1610 \u1577  \u1605 \u1587 \u1576 \u1602 \u1577  \u1605 \u1606  Apple. \u1608 \u1571 \u1610  \u1578 \u1606 \u1575 \u1586 \u1604  \u1594 \u1610 \u1585  \u1605 \u1591 \u1575 \u1576 \u1602  \u1610 \u1593 \u1578 \u1576 \u1585  \u1605 \u1604 \u1594 \u1609  \u1608 \u1576 \u1575 \u1591 \u1604 \u1575 \u1611 .\
