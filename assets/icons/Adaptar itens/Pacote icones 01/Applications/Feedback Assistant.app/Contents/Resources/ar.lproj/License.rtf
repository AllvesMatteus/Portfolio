\uc0\u1576 . \ul \uc0\u1587 \u1580 \u1604 \u1575 \u1578  \u1605 \u1601 \u1589 \u1604 \u1577  \u1578 \u1605  \u1573 \u1585 \u1587 \u1575 \u1604 \u1607 \u1575  \u1573 \u1604 \u1609  Apple.\ulnone  \uc0\u1605 \u1606  \u1582 \u1604 \u1575 \u1604  \u1575 \u1587 \u1578 \u1582 \u1583 \u1575 \u1605 \u1603  \u1604 \u1576 \u1585 \u1575 \u1605 \u1580  Apple \u1607 \u1584 \u1607 \u1548  \u1587 \u1610 \u1603 \u1608 \u1606  \u1604 \u1583 \u1610 \u1603  \u1582 \u1610 \u1575 \u1585  \u1573 \u1585 \u1601 \u1575 \u1602  \u1605 \u1593 \u1604 \u1608 \u1605 \u1575 \u1578  \u1605 \u1606  \u1606 \u1592 \u1575 \u1605 \u1603  \u1578 \u1604 \u1602 \u1575 \u1574 \u1610 \u1611 \u1575 \u1548  \u1576 \u1605 \u1575  \u1601 \u1610  \u1584 \u1604 \u1603  \u1593 \u1604 \u1609  \u1587 \u1576 \u1610 \u1604  \u1575 \u1604 \u1605 \u1579 \u1575 \u1604  \u1604 \u1575  \u1575 \u1604 \u1581 \u1589 \u1585 \u1548  \u1578 \u1602 \u1575 \u1585 \u1610 \u1585  \u1605 \u1604 \u1601  \u1578 \u1593 \u1585 \u1610 \u1601  \u1606 \u1592 \u1575 \u1605  Apple\u1548  \u1587 \u1580 \u1604 \u1575 \u1578  \u1575 \u1604 \u1571 \u1593 \u1591 \u1575 \u1604 \u1548  \u1587 \u1580 \u1604 \u1575 \u1578  \u1575 \u1604 \u1578 \u1583 \u1608 \u1610 \u1585 \u1548  \u1587 \u1580 \u1604 \u1575 \u1578  \u1575 \u1604 \u1578 \u1580 \u1605 \u1610 \u1583 \u1548  \u1587 \u1580 \u1604 \u1575 \u1578  \u1575 \u1604 \u1578 \u1579 \u1576 \u1610 \u1578 \u1548  \u1587 \u1580 \u1604 \u1575 \u1578  \u1575 \u1582 \u1578 \u1585 \u1575 \u1602  \u1575 \u1604 \u1606 \u1608 \u1575 \u1577 \u1548  \u1608 \u1587 \u1580 \u1604 \u1575 \u1578  \u1575 \u1604 \u1606 \u1592 \u1575 \u1605  \u1575 \u1604 \u1603 \u1575 \u1605 \u1604 \u1577  (\'ab\u1575 \u1604 \u1587 \u1580 \u1604 \u1575 \u1578  \u1575 \u1604 \u1605 \u1601 \u1589 \u1604 \u1577 \'bb). \u1573 \u1584 \u1575  \u1575 \u1582 \u1578 \u1585 \u1578  \u1573 \u1585 \u1587 \u1575 \u1604  \u1571 \u1610  \u1587 \u1580 \u1604 \u1575 \u1578  \u1605 \u1601 \u1589 \u1604 \u1577  \u1573 \u1604 \u1609  Apple \u1576 \u1575 \u1587 \u1578 \u1582 \u1583 \u1575 \u1605  \u1576 \u1585 \u1606 \u1575 \u1605 \u1580  Apple\u1548  \u1601 \u1587 \u1610 \u1578 \u1605  \u1578 \u1590 \u1605 \u1610 \u1606  \u1575 \u1587 \u1605 \u1603  \u1608 \u1593 \u1606 \u1608 \u1575 \u1606  \u1576 \u1585 \u1610 \u1583 \u1603  \u1575 \u1604 \u1573 \u1604 \u1603 \u1578 \u1585 \u1608 \u1606 \u1610  \u1601 \u1610  \u1578 \u1602 \u1583 \u1610 \u1605 \u1603  \u1608 \u1602 \u1583  \u1578 \u1578 \u1590 \u1605 \u1606  \u1575 \u1604 \u1587 \u1580 \u1604 \u1575 \u1578  \u1575 \u1604 \u1578 \u1610  \u1578 \u1602 \u1608 \u1605  \u1576 \u1573 \u1585 \u1601 \u1575 \u1602 \u1607 \u1575  \u1605 \u1593 \u1604 \u1608 \u1605 \u1575 \u1578  \u1578 \u1593 \u1585 \u1610 \u1601  \u1588 \u1582 \u1589 \u1610 \u1577 \u1548  \u1576 \u1605 \u1575  \u1601 \u1610  \u1584 \u1604 \u1603 \u1548  \u1593 \u1604 \u1609  \u1587 \u1576 \u1610 \u1604  \u1575 \u1604 \u1605 \u1579 \u1575 \u1604  \u1604 \u1575  \u1575 \u1604 \u1581 \u1589 \u1585 \u1548  \u1575 \u1587 \u1605  \u1581 \u1587 \u1575 \u1576 \u1603 \u1548  \u1608 \u1575 \u1604 \u1605 \u1593 \u1604 \u1608 \u1605 \u1575 \u1578  \u1575 \u1604 \u1605 \u1578 \u1593 \u1604 \u1602 \u1577  \u1576 \u1580 \u1607 \u1575 \u1578  \u1575 \u1604 \u1575 \u1578 \u1589 \u1575 \u1604  \u1575 \u1604 \u1582 \u1575 \u1589 \u1577  \u1576 \u1603 \u1548  \u1608 \u1571 \u1581 \u1583 \u1575 \u1579  \u1575 \u1604 \u1578 \u1602 \u1608 \u1610 \u1605 \u1548  \u1608 \u1605 \u1585 \u1575 \u1587 \u1604 \u1575 \u1578  \u1575 \u1604 \u1576 \u1585 \u1610 \u1583  \u1575 \u1604 \u1573 \u1604 \u1603 \u1578 \u1585 \u1608 \u1606 \u1610 . \u1610 \u1593 \u1583  \u1578 \u1608 \u1601 \u1610 \u1585  \u1607 \u1584 \u1607  \u1575 \u1604 \u1587 \u1580 \u1604 \u1575 \u1578  \u1575 \u1604 \u1605 \u1601 \u1589 \u1604 \u1577  \u1571 \u1605 \u1585 \u1611 \u1575  \u1591 \u1608 \u1593 \u1610 \u1611 \u1575 \u1548  \u1608 \u1604 \u1603 \u1606  \u1573 \u1604 \u1609  \u1575 \u1604 \u1581 \u1583  \u1575 \u1604 \u1584 \u1610  \u1578 \u1582 \u1578 \u1575 \u158