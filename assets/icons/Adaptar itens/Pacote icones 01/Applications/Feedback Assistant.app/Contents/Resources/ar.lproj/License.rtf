\f0\b 11. \uc0\u1590 \u1608 \u1575 \u1576 \u1591  \u1575 \u1604 \u1578 \u1589 \u1583 \u1610 \u1585 .
\f1\b0  \uc0\u1604 \u1575  \u1610 \u1580 \u1608 \u1586  \u1604 \u1603  \u1575 \u1587 \u1578 \u1582 \u1583 \u1575 \u1605 \u1548  \u1608 \u1576 \u1591 \u1585 \u1610 \u1602 \u1577  \u1571 \u1582 \u1585 \u1609 \u1548  \u1578 \u1589 \u1583 \u1610 \u1585  \u1571 \u1608  \u1573 \u1593 \u1575 \u1583 \u1577  \u1578 \u1589 \u1583 \u1610 \u1585  \u1576 \u1585 \u1606 \u1575 \u1605 \u1580  Apple \u1573 \u1604 \u1575  \u1608 \u1601 \u1602 \u1611 \u1575  \u1604 \u1605 \u1575  \u1610 \u1587 \u1605 \u1581  \u1576 \u1607  \u1602 \u1575 \u1606 \u1608 \u1606  \u1575 \u1604 \u1608 \u1604 \u1575 \u1610 \u1575 \u1578  \u1575 \u1604 \u1605 \u1578 \u1581 \u1583 \u1577  \u1575 \u1604 \u1571 \u1605 \u1585 \u1610 \u1603 \u1610 \u1577  \u1608 \u1602 \u1608 \u1575 \u1606 \u1610 \u1606  \u1575 \u1604 \u1575 \u1582 \u1578 \u1589 \u1575 \u1589  \u1575 \u1604 \u1602 \u1590 \u1575 \u1574 \u1610  (\u1575 \u1604 \u1575 \u1582 \u1578 \u1589 \u1575 \u1589 \u1575 \u1578  \u1575 \u1604 \u1602 \u1590 \u1575 \u1574 \u1610 \u1577 ) \u1575 \u1604 \u1578 \u1610  \u1578 \u1605  \u1575 \u1604 \u1581 \u1589 \u1608 \u1604  \u1593 \u1604 \u1609  \u1576 \u1585 \u1606 \u1575 \u1605 \u1580  Apple \u1605 \u1606  \u1582 \u1604 \u1575 \u1604 \u1607 \u1575 . \u1608 \u1593 \u1604 \u1609  \u1608 \u1580 \u1607  \u1575 \u1604 \u1582 \u1589 \u1608 \u1589 \u1548  \u1604 \u1575  \u1575 \u1604 \u1581 \u1589 \u1585 \u1548  \u1604 \u1575  \u1610 \u1580 \u1608 \u1586  \u1578 \u1589 \u1583 \u1610 \u1585  \u1576 \u1585 \u1606 \u1575 \u1605 \u1580  Apple \u1571 \u1608  \u1573 \u1593 \u1575 \u1583 \u1577  \u1578 \u1589 \u1583 \u1610 \u1585 \u1607  (\u1571 ) \u1573 \u1604 \u1609  \u1571 \u1610  \u1583 \u1608 \u1604  \u1578 \u1601 \u1585 \u1590  \u1575 \u1604 \u1608 \u1604 \u1575 \u1610 \u1575 \u1578  \u1575 \u1604 \u1605 \u1578 \u1581 \u1583 \u1577  \u1581 \u1592 \u1585 \u1611 \u1575  \u1593 \u1604 \u1610 \u1607 \u1575 \u1548  \u1571 \u1608  (\u1576 ) \u1573 \u1604 \u1609  \u1571 \u1610  \u1588 \u1582 \u1589  \u1605 \u1608 \u1590 \u1608 \u1593  \u1575 \u1587 \u1605 \u1607  \u1593 \u1604 \u1609  \u1602 \u1575 \u1574 \u1605 \u1577  \u1608 \u1586 \u1575 \u1585 \u1577  \u1575 \u1604 \u1582 \u1586 \u1575 \u1606 \u1577  \u1575 \u1604 \u1571 \u1605 \u1585 \u1610 \u1603 \u1610 \u1577  \u1603 \u1605 \u1608 \u1575 \u1591 \u1606  \u1584 \u1610  \u1578 \u1589 \u1606 \u1610 \u1601  \u1582 \u1575 \u1589  \u1571 \u1608  \u1593 \u1604 \u1609  \u1602 \u1575 \u1574 \u1605 \u1577  \u1608 \u1586 \u1575 \u1585 \u1577  \u1575 \u1604 \u1578 \u1580 \u1575 \u1585 \u1577  \u1575 \u1604 \u1571 \u1605 \u1585 \u1610 \u1603 \u1610 \u1577  \u1603 \u1571 \u1581 \u1583  \u1575 \u1604 \u1571 \u1588 \u1582 \u1575 \u1589  \u1575 \u1604 \u1605 \u1605 \u1606 \u1608 \u1593 \u1610 \u1606  \u1605 \u1606  \u1575 \u1604 \u1578 \u1589 \u1583 \u1610 \u1585  \u1571 \u1608  \u1602 \u1575 \u1574 \u1605 \u1577  \u1575 \u1604 \u1607 \u1610 \u1574 \u1575 \u1578  \u1575 \u1604 \u1578 \u1610  \u1610 \u1578 \u1591 \u1604 \u1576  \u1608 \u1580 \u1608 \u1583 \u1607 \u1575  \u1601 \u1585 \u1590  \u1588 \u1585 \u1608 \u1591  \u1582 \u1575 \u1589 \u1577  \u1601 \u1610  \u1593 \u1605 \u1604 \u1610 \u1575 \u1578  \u1575 \u1604 \u1578 \u1589 \u1583 \u1610 \u1585  \u1571 \u1608  \u1571 \u1610 \u1577  \u1602 \u1608 \u1575 \u1574 \u1605  \u1604 \u1571 \u1591 \u1585 \u1575 \u1601  \u1605 \u1602 \u1610 \u1583 \u1577  \u1571 \u1582 \u1585 \u1609 . \u1608 \u1576 \u1578 \u1606 \u1586 \u1610 \u1604  \u1608 \u1575 \u1587 \u1578 \u1582 \u1583 \u1575 \u1605  \u1576 \u1585 \u1606 \u1575 \u1605 \u1580  Apple\u1548  \u1578 \u1602 \u1585  \u1608 \u1578 \u1590 \u1605 \u1606  \u1571 \u1606 \u1603  \u1594 \u1610 \u1585  \u1605 \u1608 \u1580 \u1608 \u1583  \u1601 \u1610  \u1571 \u1610  \u1583 \u1608 \u1604 \u1577  \u1605 \u1606  \u1578 \u1604 \u1603  \u1575 \u1604 \u1583 \u1608 \u1604  \u1571 \u1608  \u1601 \u1610  \u1571 \u1610  \u1602 \u1575 \u1574 \u1605 \u1577  \u1605 \u1606  \u1578 \u1604 \u1603  \u1575 \u1604 \u1602 \u1608 \u1575 \u1574 \u1605 . \u1603 \u1605 \u1575  \u1571 \u1606 \u1603  \u1578 \u1608 \u1575 \u1601 \u1602  \u1593 \u1604 \u1609  \u1571 \u1606 \u1603  \u1604 \u1606  \u1578 \u1587 \u1578 \u1582 \u1583 \u1605  \u1576 \u1585 \u1606 \u1575 \u1605 \u1580  Apple \u1604 \u1571 \u1610 \u1617  \u1571 \u1594 \u1585 \u1575 \u1590  \u1610 \u1581 \u1592 \u1585 \u1607 \u1575  \u1602 \u1575 \u1606 \u1608 \u1606  \u1575 \u1604 \u1608 \u1604 \u1575 \u1610 \u1575 \u1578  \u1575 \u1604 \u1605 \u1578 \u1581 \u1583 \u1577 \u1548  \u1593 \u1604 \u1609  \u1587 \u1576 \u1610 \u1604  \u1575 \u1604 \u1605 \u1579 \u1575 \u1604  \u1604 \u1575  \u1575 \u1604 \u1581 \u1589 \u1585 \u1548  \u1578 \u1591 \u1608 \u1610 \u1585  \u1571 \u1608  \u1578 \u1589 \u1605 \u1610 \u1605  \u1571 \u1608  \u1578 \u1589 \u1606 \u1610 \u1593  \u1571 \u1608  \u1573 \u1606 \u1578 \u1575 \u1580  \u1575 \u1604 \u1589 \u1608 \u1575 \u1585 \u1610 \u1582  \u1571 \u1608  \u1575 \u1604 \u1571 \u1587 \u1604 \u1581 \u1577  \u1575 \u1604 \u1606 \u1608 \u1608 \u1610 \u1577  \u1571 \u1608  \u1575 \u1604 \u1603 \u1610 \u1605 \u1575 \u1608 \u1610 \u1577  \u1571 \u1608  \u1575 \u1604 \u1576 \u1610 \u1608 \u1604 \u1608 \u1580 \u1610 \u1577 .\
