B. \ul \uc0\u1047 \u1072 \u1073 \u1086 \u1088 \u1086 \u1085 \u1072  \u1079 \u1074 \u1086 \u1088 \u1086 \u1090 \u1085 \u1086 \u1075 \u1086  \u1087 \u1088 \u1086 \u1108 \u1082 \u1090 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103 ; \u1110 \u1085 \u1096 \u1110  \u1086 \u1073 \u1084 \u1077 \u1078 \u1077 \u1085 \u1085 \u1103  \u1091  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1072 \u1085 \u1085 \u1110 .\ulnone  \uc0\u1042 \u1080  \u1085 \u1077  \u1084 \u1072 \u1108 \u1090 \u1077  \u1087 \u1088 \u1072 \u1074 \u1072  \u1081  \u1085 \u1077  \u1087 \u1086 \u1074 \u1080 \u1085 \u1085 \u1110  \u1076 \u1086 \u1079 \u1074 \u1086 \u1083 \u1103 \u1090 \u1080  \u1110 \u1085 \u1096 \u1080 \u1084  \u1086 \u1089 \u1086 \u1073 \u1072 \u1084  \u1082 \u1086 \u1087 \u1110 \u1102 \u1074 \u1072 \u1090 \u1080  (\u1086 \u1082 \u1088 \u1110 \u1084  \u1074 \u1080 \u1087 \u1072 \u1076 \u1082 \u1110 \u1074 , \u1087 \u1077 \u1088 \u1077 \u1076 \u1073 \u1072 \u1095 \u1077 \u1085 \u1080 \u1093  \u1094 \u1110 \u1108 \u1102  \u1051 \u1110 \u1094 \u1077 \u1085 \u1079 \u1110 \u1108 \u1102 ), \u1076 \u1077 \u1082 \u1086 \u1084 \u1087 \u1110 \u1083 \u1102 \u1074 \u1072 \u1090 \u1080 , \u1079 \u1076 \u1110 \u1081 \u1089 \u1085 \u1102 \u1074 \u1072 \u1090 \u1080  \u1079 \u1074 \u1086 \u1088 \u1086 \u1090 \u1085 \u1077  \u1087 \u1088 \u1086 \u1108 \u1082 \u1090 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103 , \u1076 \u1080 \u1079 \u1072 \u1089 \u1077 \u1084 \u1073 \u1083 \u1102 \u1074 \u1072 \u1090 \u1080 , \u1085 \u1072 \u1084 \u1072 \u1075 \u1072 \u1090 \u1080 \u1089 \u1103  \u1086 \u1090 \u1088 \u1080 \u1084 \u1072 \u1090 \u1080  \u1074 \u1080 \u1093 \u1110 \u1076 \u1085 \u1080 \u1081  \u1082 \u1086 \u1076 , \u1088 \u1086 \u1079 \u1096 \u1080 \u1092 \u1088 \u1086 \u1074 \u1091 \u1074 \u1072 \u1090 \u1080 , \u1079 \u1084 \u1110 \u1085 \u1102 \u1074 \u1072 \u1090 \u1080 , \u1089 \u1090 \u1074 \u1086 \u1088 \u1102 \u1074 \u1072 \u1090 \u1080  \u1087 \u1086 \u1093 \u1110 \u1076 \u1085 \u1110  \u1088 \u1086 \u1073 \u1086 \u1090 \u1080  \u1085 \u1072  \u1086 \u1089 \u1085 \u1086 \u1074 \u1110  \u1055 \u1088 \u1086 \u1075 \u1088 \u1072 \u1084 \u1085 \u1086 \u1075 \u1086  \u1079 \u1072 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  Apple \u1072 \u1073 \u1086  \u1073 \u1091 \u1076 \u1100 -\u1103 \u1082 \u1086 \u1111  \u1081 \u1086 \u1075 \u1086  \u1095 \u1072 \u1089 \u1090 \u1080 \u1085 \u1080  (\u1079 \u1072  \u1074 \u1080 \u1085 \u1103 \u1090 \u1082 \u1086 \u1084  \u1074 \u1080 \u1087 \u1072 \u1076 \u1082 \u1110 \u1074 , \u1082 \u1086 \u1083 \u1080  \u1090 \u1072 \u1082 \u1110  \u1086 \u1073 \u1084 \u1077 \u1078 \u1077 \u1085 \u1085 \u1103  \u1079 \u1072 \u1073 \u1086 \u1088 \u1086 \u1085 \u1077 \u1085 \u1110  \u1095 \u1080 \u1085 \u1085 \u1080 \u1084  \u1079 \u1072 \u1082 \u1086 \u1085 \u1086 \u1076 \u1072 \u1074 \u1089 \u1090 \u1074 \u1086 \u1084  \u1072 \u1073 \u1086  \u1076 \u1086 \u1079 \u1074 \u1086 \u1083 \u1077 \u1085 \u1110  \u1091 \u1084 \u1086 \u1074 \u1072 \u1084 \u1080  \u1083 \u1110 \u1094 \u1077 \u1085 \u1079 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1082 \u1086 \u1084 \u1087 \u1086 \u1085 \u1077 \u1085 \u1090 \u1110 \u1074  \u1079  \u1074 \u1110 \u1076 \u1082 \u1088 \u1080 \u1090 \u1080 \u1084  \u1082 \u1086 \u1076 \u1086 \u1084 ), \u1072  \u1090 \u1072 \u1082 \u1086 \u1078  \u1085 \u1077  \u1074 \u1082 \u1083 \u1102 \u1095 \u1072 \u1090 \u1080  \u1081 \u1086 \u1075 \u1086  \u1076 \u1086  \u1074 \u1083 \u1072 \u1089 \u1085 \u1080 \u1093  \u1087 \u1088 \u1086 \u1075 \u1088 \u1072 \u1084  \u1095 \u1080  \u1082 \u1086 \u1084 \u1087 \u1110 \u1083 \u1102 \u1074 \u1072 \u1090 \u1080  \u1088 \u1072 \u1079 \u1086 \u1084  \u1110 \u1079  \u1085 \u1080 \u1084 \u1080 . \u1042 \u1080  \u1087 \u1086 \u1075 \u1086 \u1076 \u1078 \u1091 \u1108 \u1090 \u1077 \u1089 \u1103  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1086 \u1074 \u1091 \u1074 \u1072 \u1090 \u1080  \u1055 \u1088 \u1086 \u1075 \u1088 \u1072 \u1084 \u1085 \u1077  \u1079 \u1072 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  Apple, \u1076 \u1086 \u1090 \u1088 \u1080 \u1084 \u1091 \u1102 \u1095 \u1080 \u1089 \u1100  \u1073 \u1091 \u1076 \u1100 -\u1103 \u1082 \u1080 \u1093  \u1095 \u1080 \u1085 \u1085 \u1080 \u1093  \u1079 \u1072 \u1082 \u1086 \u1085 \u1110 \u1074 , \u1091  \u1090 \u1086 \u1084 \u1091  \u1095 \u1080 \u1089 \u1083 \u1110  \u1084 \u1110 \u1089 \u1094 \u1077 \u1074 \u1080 \u1093  \u1079 \u1072 \u1082 \u1086 \u1085 \u1110 \u1074  \u1082 \u1088 \u1072 \u1111 \u1085 \u1080  \u1072 \u1073 \u1086  \u1088 \u1077 \u1075 \u1110 \u1086 \u1085 \u1091 , \u1076 \u1077  \u1074 \u1080  \u1084 \u1077 \u1096 \u1082 \u1072 \u1108 \u1090 \u1077  \u1072 \u1073 \u1086  \u1076 \u1077  \u1079 \u1072 \u1074 \u1072 \u1085 \u1090 \u1072 \u1078 \u1091 \u1108 \u1090 \u1077  \u1095 \u1080  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1086 \u1074 \u1091 \u1108 \u1090 \u1077  \u1055 \u1088 \u1086 \u1075 \u1088 \u1072 \u1084 \u1085 \u1077  \u1079 \u1072 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  Apple.\
