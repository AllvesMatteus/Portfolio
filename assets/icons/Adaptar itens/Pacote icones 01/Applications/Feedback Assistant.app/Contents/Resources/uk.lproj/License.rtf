\ul B. \uc0\u1044 \u1077 \u1090 \u1072 \u1083 \u1110 \u1079 \u1086 \u1074 \u1072 \u1085 \u1110  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1080 , \u1085 \u1072 \u1076 \u1110 \u1089 \u1083 \u1072 \u1085 \u1110  \u1076 \u1086  Apple.\ulnone  \uc0\u1055 \u1110 \u1076  \u1095 \u1072 \u1089  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1072 \u1085 \u1085 \u1103  \u1094 \u1100 \u1086 \u1075 \u1086  \u1055 \u1088 \u1086 \u1075 \u1088 \u1072 \u1084 \u1085 \u1086 \u1075 \u1086  \u1079 \u1072 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  Apple \u1091  \u1074 \u1072 \u1089  \u1073 \u1091 \u1076 \u1077  \u1084 \u1086 \u1078 \u1083 \u1080 \u1074 \u1110 \u1089 \u1090 \u1100  \u1072 \u1074 \u1090 \u1086 \u1084 \u1072 \u1090 \u1080 \u1095 \u1085 \u1086  \u1076 \u1086 \u1076 \u1072 \u1074 \u1072 \u1090 \u1080  \u1110 \u1085 \u1092 \u1086 \u1088 \u1084 \u1072 \u1094 \u1110 \u1102  \u1079  \u1074 \u1072 \u1096 \u1086 \u1111  \u1089 \u1080 \u1089 \u1090 \u1077 \u1084 \u1080 , \u1079 \u1086 \u1082 \u1088 \u1077 \u1084 \u1072 , \u1072 \u1083 \u1077  \u1085 \u1077  \u1086 \u1073 \u1084 \u1077 \u1078 \u1091 \u1102 \u1095 \u1080 \u1089 \u1100 , \u1079 \u1074 \u1110 \u1090 \u1080  Apple System Profile, \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1080  \u1072 \u1074 \u1072 \u1088 \u1110 \u1081 \u1085 \u1080 \u1093  \u1079 \u1072 \u1074 \u1077 \u1088 \u1096 \u1077 \u1085 \u1100 , \u1079 \u1072 \u1094 \u1080 \u1082 \u1083 \u1102 \u1074 \u1072 \u1085 \u1085 \u1103 , \u1079 \u1072 \u1074 \u1080 \u1089 \u1072 \u1085 \u1100  \u1090 \u1072  \u1074 \u1089 \u1090 \u1072 \u1085 \u1086 \u1074 \u1083 \u1077 \u1085 \u1085 \u1103  \u1087 \u1088 \u1086 \u1075 \u1088 \u1072 \u1084 , \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1080  \u1082 \u1088 \u1080 \u1090 \u1080 \u1095 \u1085 \u1080 \u1093  \u1087 \u1086 \u1084 \u1080 \u1083 \u1086 \u1082  \u1103 \u1076 \u1088 \u1072  \u1090 \u1072  \u1087 \u1086 \u1074 \u1085 \u1110  \u1089 \u1080 \u1089 \u1090 \u1077 \u1084 \u1085 \u1110  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1080  (\'ab\u1044 \u1077 \u1090 \u1072 \u1083 \u1110 \u1079 \u1086 \u1074 \u1072 \u1085 \u1110  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1080 \'bb). \u1071 \u1082 \u1097 \u1086  \u1074 \u1080  \u1074 \u1080 \u1088 \u1110 \u1096 \u1080 \u1090 \u1077  \u1085 \u1072 \u1076 \u1110 \u1089 \u1083 \u1072 \u1090 \u1080  \u1073 \u1091 \u1076 \u1100 -\u1103 \u1082 \u1110  \u1044 \u1077 \u1090 \u1072 \u1083 \u1110 \u1079 \u1086 \u1074 \u1072 \u1085 \u1110  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1080  \u1076 \u1086  Apple \u1079 \u1072  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1086 \u1102  \u1055 \u1088 \u1086 \u1075 \u1088 \u1072 \u1084 \u1085 \u1086 \u1075 \u1086  \u1079 \u1072 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  Apple, \u1074 \u1072 \u1096 \u1077  \u1110 \u1084 \'92\u1103  \u1090 \u1072  \u1072 \u1076 \u1088 \u1077 \u1089 \u1072  \u1077 \u1083 \u1077 \u1082 \u1090 \u1088 \u1086 \u1085 \u1085 \u1086 \u1111  \u1087 \u1086 \u1096 \u1090 \u1080  \u1073 \u1091 \u1076 \u1091 \u1090 \u1100  \u1074 \u1082 \u1083 \u1102 \u1095 \u1077 \u1085 \u1110  \u1076 \u1086  \u1076 \u1072 \u1085 \u1080 \u1093 , \u1097 \u1086  \u1074 \u1080  \u1085 \u1072 \u1076 \u1089 \u1080 \u1083 \u1072 \u1108 \u1090 \u1077 , \u1072  \u1076 \u1086 \u1076 \u1072 \u1085 \u1110  \u1078 \u1091 \u1088 \u1085 \u1072 \u1083 \u1080  \u1084 \u1086 \u1078 \u1091 \u1090 \u1100  \u1084 \u1110 \u1089 \u1090 \u1080 \u1090 \u1080  \u1086 \u1089 \u1086 \u1073 \u1080 \u1089 \u1090 \u1091  \u1110 \u1085 \u1092 \u1086 \u1088 \u1084 \u1072 \u1094 \u1110 \u1102 , \u1079 \u1086 \u1082 \u1088 \u1077 \u1084 \u1072 , \u1072 \u1083 \u1077  \u1085 \u1077  \u1086 \u1073 \u1084 \u1077 \u1078 \u1091 \u1102 \u1095 \u1080 \u1089 \u1100 , \u1110 \u1084 \'92\u1103  \u1074 \u1072 \u1096 \u1086 \u1075 \u1086  \u1086 \u1073 \u1083 \u1110 \u1082 \u1086 \u1074 \u1086 \u1075 \u1086  \u1079 \u1072 \u1087 \u1080 \u1089 \u1091 , \u1110 \u1085 \u109