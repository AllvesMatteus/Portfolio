72 \u1084 \u1085 \u1086 \u1075 \u1086  \u1079 \u1072 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  \u1083 \u1110 \u1094 \u1077 \u1085 \u1079 \u1091 \u1108 \u1090 \u1100 \u1089 \u1103  \u1082 \u1110 \u1085 \u1094 \u1077 \u1074 \u1086 \u1084 \u1091  \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1091 \u1074 \u1072 \u1095 \u1091 \'a0\'97 \u1059 \u1088 \u1103 \u1076 \u1091  \u1057 \u1064 \u1040  (a) \u1083 \u1080 \u1096 \u1077  \u1103 \u1082  \u1050 \u1086 \u1084 \u1077 \u1088 \u1094 \u1110 \u1081 \u1085 \u1110  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 \u1080  \u1081  (b) \u1083 \u1080 \u1096 \u1077  \u1074  \u1086 \u1073 \u1089 \u1103 \u1079 \u1110  \u1090 \u1080 \u1093  \u1087 \u1088 \u1072 \u1074 , \u1103 \u1082 \u1110  \u1085 \u1072 \u1076 \u1072 \u1102 \u1090 \u1100 \u1089 \u1103  \u1074 \u1089 \u1110 \u1084  \u1110 \u1085 \u1096 \u1080 \u1084  \u1082 \u1110 \u1085 \u1094 \u1077 \u1074 \u1080 \u1084  \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1091 \u1074 \u1072 \u1095 \u1072 \u1084  \u1074 \u1110 \u1076 \u1087 \u1086 \u1074 \u1110 \u1076 \u1085 \u1086  \u1076 \u1086  \u1091 \u1084 \u1086 \u1074  \u1110  \u1087 \u1086 \u1083 \u1086 \u1078 \u1077 \u1085 \u1100  \u1094 \u1110 \u1108 \u1111  \u1059 \u1075 \u1086 \u1076 \u1080 . \u1055 \u1088 \u1072 \u1074 \u1072  \u1085 \u1072  \u1085 \u1077 \u1086 \u1087 \u1091 \u1073 \u1083 \u1110 \u1082 \u1086 \u1074 \u1072 \u1085 \u1110  \u1084 \u1072 \u1090 \u1077 \u1088 \u1110 \u1072 \u1083 \u1080  \u1079 \u1073 \u1077 \u1088 \u1110 \u1075 \u1072 \u1102 \u1090 \u1100 \u1089 \u1103  \u1079 \u1075 \u1110 \u1076 \u1085 \u1086  \u1110 \u1079 \'a0\u1079 \u1072 \u1082 \u1086 \u1085 \u1072 \u1084 \u1080  \u1057 \u1064 \u1040  \u1097 \u1086 \u1076 \u1086  \u1072 \u1074 \u1090 \u1086 \u1088 \u1089 \u1100 \u1082 \u1080 \u1093  \u1087 \u1088 \u1072 \u1074 .\
