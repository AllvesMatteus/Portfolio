\f0\b 3. \uc0\u1055 \u1077 \u1088 \u1077 \u1076 \u1072 \u1074 \u1072 \u1085 \u1085 \u1103  \u1087 \u1088 \u1072 \u1074 .
\f1\b0  \uc0\u1042 \u1080  \u1085 \u1077  \u1084 \u1072 \u1108 \u1090 \u1077  \u1087 \u1088 \u1072 \u1074 \u1072  \u1079 \u1076 \u1072 \u1074 \u1072 \u1090 \u1080  \u1074  \u1086 \u1088 \u1077 \u1085 \u1076 \u1091 , \u1091  \u1083 \u1110 \u1079 \u1080 \u1085 \u1075 , \u1087 \u1086 \u1079 \u1080 \u1095 \u1072 \u1090 \u1080 , \u1087 \u1077 \u1088 \u1077 \u1076 \u1072 \u1074 \u1072 \u1090 \u1080  \u1091  \u1089 \u1091 \u1073 \u1083 \u1110 \u1094 \u1077 \u1085 \u1079 \u1110 \u1102 , \u1087 \u1088 \u1086 \u1076 \u1072 \u1074 \u1072 \u1090 \u1080 , \u1087 \u1077 \u1088 \u1077 \u1076 \u1072 \u1074 \u1072 \u1090 \u1080  \u1072 \u1073 \u1086  \u1073 \u1091 \u1076 \u1100 -\u1103 \u1082 \u1080 \u1084  \u1110 \u1085 \u1096 \u1080 \u1084  \u1095 \u1080 \u1085 \u1086 \u1084  \u1088 \u1086 \u1079 \u1087 \u1086 \u1074 \u1089 \u1102 \u1076 \u1078 \u1091 \u1074 \u1072 \u1090 \u1080  \u1095 \u1080  \u1085 \u1072 \u1076 \u1072 \u1074 \u1072 \u1090 \u1080  \u1089 \u1091 \u1073 \u1083 \u1110 \u1094 \u1077 \u1085 \u1079 \u1110 \u1102  \u1085 \u1072  \u1055 \u1088 \u1086 \u1075 \u1088 \u1072 \u1084 \u1085 \u1077  \u1079 \u1072 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1077 \u1085 \u1085 \u1103  Apple.\
